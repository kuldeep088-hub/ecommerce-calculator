---
import Layout from '../layouts/Layout.astro';
import CodProfitCalculator from '../components/CodProfitCalculator.astro';
import FaqSection from '../components/FaqSection.astro';

const codFaqs = [
  {
    q: "Why is net profit significantly lower on COD orders compared to prepaid orders?",
    a: "Cash on Delivery (COD) orders suffer from three distinct profit drains: 1) Courier COD collection handling fees (typically ₹30–₹50 or 1.5%–2% per order), 2) Elevated RTO delivery rejections (15%–30% failure rate vs 3%–5% for prepaid), and 3) Longer cash payout cycles from logistics partners (7 to 15 days remittance delay)."
  },
  {
    q: "What is the COD collection fee charged by courier aggregators like Shiprocket, Delhivery, and Blue Dart?",
    a: "Logistics aggregators and couriers charge a cash handling fee to collect cash from customers at doorstep, reconcile it, and remit it to the seller's account. This fee typically ranges between ₹35 to ₹50 per delivered order or 1.5% to 2.5% of the invoice value, whichever is higher, plus 18% GST."
  },
  {
    q: "How to calculate true net take-home profit on COD orders?",
    a: "True Net COD Profit = (Delivered Orders × Profit Per Order) - (RTO Orders × Cost of Failed Delivery) - Total COD Collection Charges. Our calculator computes your blended net margin by factoring in both successful sales and the courier drag of doorstep rejections."
  },
  {
    q: "When should an Indian seller disable COD for specific products?",
    a: "Sellers should consider disabling COD if: 1) The product selling price is under ₹299 (where a ₹40 COD fee and ₹70 shipping wipe out all gross margin), 2) The product is customized or perishable, or 3) Delivering to high-risk pincodes with historical RTO rates exceeding 35%."
  }
];
---

<Layout
  title="COD Profit Calculator (2026) | Cash on Delivery Profit & Fee Calculator"
  description="Calculate true in-hand profits on Cash on Delivery (COD) e-commerce orders after courier collection fees, 18% GST, and doorstep RTO delivery rejections."
  canonicalPath="/cod-profit-calculator"
  activePlatform="tools"
>
  <CodProfitCalculator />
  <FaqSection
    title="COD Profit Calculator Frequently Asked Questions"
    subtitle="Understand cash collection charges, delivery rejection penalties, and true net margin calculations."
    faqs={codFaqs}
  />
</Layout>
