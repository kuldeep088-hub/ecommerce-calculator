---
import Layout from '../layouts/Layout.astro';
import Calculator from '../components/Calculator.astro';
import ComparisonMatrix from '../components/ComparisonMatrix.astro';
import ReversePriceSolver from '../components/ReversePriceSolver.astro';
import FeeGuide from '../components/FeeGuide.astro';
import FaqSection from '../components/FaqSection.astro';

const zeptoFaqs = [
  {
    q: "How does selling on Zepto Quick Commerce work in 2026?",
    a: "Zepto operates a hyper-dense network of micro-warehouses (dark stores) across major Indian metros delivering in under 10 minutes. Brands supply pallets or master cartons to Zepto mother hubs, which distribute inventory to localized micro-dark stores."
  },
  {
    q: "What are the typical fee and margin structures for Zepto sellers?",
    a: "Zepto charges a trade margin of 18% to 28% off retail price, plus supply chain handling fees, in-app sponsored promotion costs, and slotting charges for premium visibility in quick-commerce categories."
  },
  {
    q: "Why do quick-commerce platforms like Zepto have lower RTO rates than standard marketplaces?",
    a: "Because Zepto orders are delivered within 10 minutes directly to customer doors, buyer cancellations and non-availability rejections are minimal (under 1%–2%). This eliminates the massive ₹100–₹160 courier RTO losses typical of traditional 3-day COD e-commerce."
  },
  {
    q: "How does inventory restocking and expiry management operate on Zepto?",
    a: "Brands must maintain high stock availability in Zepto fulfillment hubs to avoid out-of-stock penalties. Slow-moving products approaching expiry must be cleared through flash deals or retrieved via RTV (Return to Vendor) agreements."
  }
];
---

<Layout
  title="Zepto Seller & Brand Profit Calculator (2026) | Instant Delivery Margin Calculator"
  description="Calculate brand net earnings on Zepto. Model 10-minute quick commerce dark store margins (14%-22%), inwarding handling fees, and GST Input Tax Credit for 2026."
  canonicalPath="/zepto"
  activePlatform="zepto"
>
  <!-- Dedicated Platform Header Banner -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-6">
    <div class="bg-purple-50/60 border border-purple-200/80 rounded-2xl p-5 sm:p-6 mb-2">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 mb-1.5">
            <span class="text-xs font-mono font-bold px-2 py-0.5 rounded-full bg-purple-100 text-purple-800 border border-purple-200">
              10-Minute Instant Delivery
            </span>
            <span class="text-xs text-neutral-500 font-mono">2026 Slabs</span>
          </div>
          <h1 class="text-xl sm:text-2xl font-bold text-neutral-900 tracking-tight">
            Zepto Seller &amp; Brand Profit Calculator
          </h1>
          <p class="text-xs sm:text-sm text-neutral-600 mt-1 max-w-2xl leading-relaxed">
            Zepto distributes inventory across hyperlocal dark stores, taking a <strong>14%&ndash;22% brand margin</strong> plus micro-storage and inwarding handling fees. With immediate 10-minute doorstep handoff, courier RTO loss is near-zero.
          </p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 shrink-0 text-xs font-mono">
          <div class="bg-white border border-purple-200 rounded-xl p-2.5 text-center">
            <div class="text-[10px] text-neutral-500 uppercase font-sans">Platform Margin</div>
            <div class="font-bold text-purple-700 text-sm mt-0.5">14% &ndash; 22%</div>
          </div>
          <div class="bg-white border border-purple-200 rounded-xl p-2.5 text-center">
            <div class="text-[10px] text-neutral-500 uppercase font-sans">Dark Store Inward</div>
            <div class="font-bold text-neutral-900 text-sm mt-0.5">₹15 &ndash; ₹20</div>
          </div>
          <div class="bg-white border border-purple-200 rounded-xl p-2.5 text-center col-span-2 sm:col-span-1">
            <div class="text-[10px] text-neutral-500 uppercase font-sans">Courier RTO</div>
            <div class="font-bold text-emerald-700 text-sm mt-0.5">&sim;0%</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Calculator Preloaded with Zepto -->
  <Calculator
    initialMarketplace="zepto"
    title="Calculate Zepto Brand Payout & Realization"
    subtitle="Model quick-commerce dark store margin cuts, inwarding handling fees, and GST ITC."
  />

  <!-- Side-by-Side Comparison -->
  <ComparisonMatrix />

  <!-- Reverse Target Price Solver -->
  <ReversePriceSolver />

  <!-- Fee Guide -->
  <FeeGuide />

  <!-- FAQ -->
  <FaqSection
    title="Zepto Seller & Brand Profit Calculator Frequently Asked Questions"
    subtitle="Common questions on 10-minute delivery dark stores, trade margin cuts, and stock turnover."
    faqs={zeptoFaqs}
  />
</Layout>
