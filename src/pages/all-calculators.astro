---
// src/pages/all-calculators.astro
import Layout from '../layouts/Layout.astro';

interface ToolItem {
  title: string;
  url: string;
  badge: string;
  desc: string;
}

interface CategoryGroup {
  id: string;
  title: string;
  count: number;
  subtitle: string;
  tools: ToolItem[];
}

const CATEGORIES: CategoryGroup[] = [
  {
    id: 'marketplaces',
    title: '1. Marketplace Profit Calculators',
    count: 13,
    subtitle: 'Dedicated fee, commission, and net settlement calculators for leading Indian e-commerce & quick-commerce channels.',
    tools: [
      { title: 'Amazon Profit Calculator', url: '/amazon', badge: 'Amazon Easy Ship', desc: 'Referral fees, closing charges, courier freight, and net payout.' },
      { title: 'Flipkart Profit Calculator', url: '/flipkart', badge: 'Flipkart 2026', desc: 'Tier-based fixed fee, collection fees, and commission slabs.' },
      { title: 'Meesho Profit Calculator', url: '/meesho', badge: '0% Commission', desc: 'Calculate zero commission payouts and actual courier weight charges.' },
      { title: 'Amazon FBA Profit Calculator', url: '/amazon-fba-calculator', badge: 'Fulfillment by Amazon', desc: 'FBA storage, pick & pack fees, closing fee slabs, and GST.' },
      { title: 'Amazon FBM Profit Calculator', url: '/amazon-fbm-calculator', badge: 'Merchant Fulfilled', desc: 'Self-ship courier freight, warehouse packaging, and margins.' },
      { title: 'Myntra Seller Profit Calculator', url: '/myntra', badge: 'Fashion & Lifestyle', desc: 'Fashion category commissions (12%-24%) and return reserve buffer.' },
      { title: 'AJIO Seller Profit Calculator', url: '/ajio', badge: 'AJIO Marketplace', desc: 'Reliance AJIO commission tiers, shipping, and reverse courier fees.' },
      { title: 'Shopsy Seller Profit Calculator', url: '/shopsy', badge: 'Flipkart Value', desc: 'Low-cost fashion, electronics, and household budget seller fees.' },
      { title: 'Snapdeal Seller Profit Calculator', url: '/snapdeal', badge: 'Snapdeal Seller', desc: 'Snapdeal marketing fees, courier handling, and settlement.' },
      { title: 'JioMart Seller Profit Calculator', url: '/jiomart', badge: 'Reliance Retail', desc: 'Grocery, FMCG, and electronics seller commissions on JioMart.' },
      { title: 'Shopify Profit Calculator', url: '/shopify-profit-calculator', badge: 'D2C Independent', desc: 'Payment gateway fees (2%), Meta ad spend, and courier charges.' },
      { title: 'Blinkit Seller Profit Calculator', url: '/blinkit', badge: '10-Min Delivery', desc: 'Dark store consignment, quick commerce take rates, and margins.' },
      { title: 'Zepto Seller Profit Calculator', url: '/zepto', badge: 'Instant Commerce', desc: 'Zepto brand partnership margins, wastage buffer, and payouts.' }
    ]
  },
  {
    id: 'profit',
    title: '2. Seller Cost & Profit Calculators',
    count: 10,
    subtitle: 'Core unit economics, gross vs net margins, target price solvers, and break-even analysis.',
    tools: [
      { title: 'E-commerce Profit Margin Calculator', url: '/profit-margin-calculator', badge: 'Margin %', desc: 'Calculate net profit margin percentage and markup on cost.' },
      { title: 'Product Selling Price Calculator', url: '/selling-price-calculator', badge: 'Target Price', desc: 'Determine selling price required to hit your desired net margin.' },
      { title: 'Product Cost Calculator', url: '/product-cost-calculator', badge: 'COGS & Batch', desc: 'Aggregate materials, manufacturing labor, and inbound freight per unit.' },
      { title: 'Product Markup Calculator', url: '/product-markup-calculator', badge: 'Markup Solver', desc: 'Calculate retail price and gross margin percentage from cost markup.' },
      { title: 'Net Profit Calculator', url: '/net-profit-calculator', badge: 'Bottom Line', desc: 'Deduct marketplace fees, ad spend, and overhead from gross revenue.' },
      { title: 'Gross Profit Calculator', url: '/gross-profit-calculator', badge: 'Gross Margin', desc: 'Basic gross margin = Revenue minus Cost of Goods Sold (COGS).' },
      { title: 'Break-Even Calculator', url: '/break-even-calculator', badge: 'Break-Even Units', desc: 'Find minimum sales volume needed to cover monthly fixed overheads.' },
      { title: 'Product ROI Calculator', url: '/product-roi-calculator', badge: 'Return on Investment', desc: 'Evaluate return percentage on inventory capital invested.' },
      { title: 'Wholesale Profit Calculator', url: '/wholesale-profit-calculator', badge: 'B2B Wholesale', desc: 'Model bulk manufacturing batches, wholesale margins, and retailer discounts.' },
      { title: 'Dropshipping Profit Calculator', url: '/dropshipping-profit-calculator', badge: 'Dropshipping', desc: 'Account for supplier item cost, ad CPA, and 20%+ RTO delivery failures.' }
    ]
  },
  {
    id: 'shipping',
    title: '3. Shipping & Return Calculators',
    count: 8,
    subtitle: 'Logistics expenses, COD verification risks, RTO loss prevention, and volumetric weight formulas.',
    tools: [
      { title: 'RTO Loss Calculator', url: '/rto-loss-calculator', badge: 'Doorstep RTO', desc: 'Calculate exact cash burn from undelivered Return-to-Origin shipments.' },
      { title: 'Return Loss Calculator', url: '/return-loss-calculator', badge: 'Customer Returns', desc: 'Total damage from returned goods, reverse freight, and unsellables.' },
      { title: 'Shipping Cost Calculator', url: '/shipping-cost-calculator', badge: 'Volumetric Freight', desc: 'Calculate chargeable weight (L x W x H / 5000) vs dead weight.' },
      { title: 'Courier Charges Calculator', url: '/courier-charges-calculator', badge: '3PL & Aggregator', desc: 'Shiprocket & Delhivery rate card with fuel surcharge and 18% GST.' },
      { title: 'COD Profit Calculator', url: '/cod-profit-calculator', badge: 'Cash on Delivery', desc: 'Model ₹40 COD collection fee and undelivered courier burn.' },
      { title: 'Prepaid vs COD Calculator', url: '/prepaid-vs-cod', badge: 'Risk Simulator', desc: 'Compare profits and calculate max prepaid discount you can offer.' },
      { title: 'Reverse Shipping Cost Calculator', url: '/reverse-shipping-cost-calculator', badge: 'Reverse Logistics', desc: 'Reverse courier fee, QC inspection, and re-packaging costs.' },
      { title: 'Order Cancellation Loss Calculator', url: '/order-cancellation-loss-calculator', badge: 'Pre-dispatch Burn', desc: 'Sunk packing materials and warehouse handling on canceled orders.' }
    ]
  },
  {
    id: 'gst',
    title: '4. GST & Tax Calculators',
    count: 7,
    subtitle: 'Input Tax Credit (ITC), reverse GST on marketplace commissions, TCS u/s 52, and TDS u/s 194-O.',
    tools: [
      { title: 'GST Calculator for Sellers', url: '/gst-calculator', badge: 'All Slabs', desc: '5%, 12%, 18%, and 28% GST inclusive and exclusive calculation.' },
      { title: 'GST Inclusive / Exclusive Calculator', url: '/gst-inclusive-exclusive-calculator', badge: 'Tax Reversal', desc: 'Extract base product price and tax component from final MRP.' },
      { title: 'GST on Marketplace Fees Calculator', url: '/gst-on-marketplace-fees-calculator', badge: '18% Service Tax', desc: 'Calculate 18% GST charged on referral, closing, and shipping fees.' },
      { title: 'GST Profit Calculator', url: '/gst-profit-calculator', badge: 'Tax Liability', desc: 'Net payable GST after offsetting purchase & courier Input Tax Credit.' },
      { title: 'Input Tax Credit (ITC) Calculator', url: '/input-tax-credit-calculator', badge: 'ITC Ledger', desc: 'Aggregate GST on goods and platform services to claim in GSTR-3B.' },
      { title: 'TCS Calculator for E-commerce Sellers', url: '/tcs-calculator', badge: '0.5% TCS', desc: 'Tax Collected at Source (TCS) u/s 52 on net taxable supplies.' },
      { title: 'TDS Calculator for E-commerce Sellers', url: '/tds-calculator', badge: '0.1% Sec 194-O', desc: 'TDS deducted by marketplace platforms on gross seller sales.' }
    ]
  },
  {
    id: 'fees',
    title: '5. Marketplace Fee Calculators',
    count: 8,
    subtitle: 'Deep-dive fee breakdowns for Amazon, Flipkart, Meesho, and multi-channel commission comparison.',
    tools: [
      { title: 'Amazon Seller Fee Calculator', url: '/amazon-seller-fee-calculator', badge: 'Total Amz Fees', desc: 'Referral + closing fee slab + Easy Ship + 18% GST combined.' },
      { title: 'Flipkart Seller Fee Calculator', url: '/flipkart-seller-fee-calculator', badge: 'Total FK Fees', desc: 'Commission + fixed fee + payment collection + shipping + GST.' },
      { title: 'Meesho Commission Calculator', url: '/meesho-commission-calculator', badge: '0% True Breakdown', desc: 'Verify zero platform fee and analyze logistics weight billing.' },
      { title: 'Amazon Referral Fee Calculator', url: '/amazon-referral-fee-calculator', badge: 'Category Commission', desc: 'Category-specific referral fee and 18% claimable GST tax.' },
      { title: 'Amazon Closing Fee Calculator', url: '/amazon-closing-fee-calculator', badge: 'Closing Slabs', desc: 'Price slab closing charges: ₹5 (under ₹250) up to ₹42 (above ₹1000).' },
      { title: 'Amazon Shipping Fee Calculator', url: '/amazon-shipping-fee-calculator', badge: 'Easy Ship Rates', desc: 'Local, regional, and national shipping tiers by 500g increments.' },
      { title: 'Flipkart Commission Calculator', url: '/flipkart-commission-calculator', badge: 'FK Commission %', desc: 'Calculate Flipkart category commission and 18% GST deduction.' },
      { title: 'Marketplace Commission Calculator', url: '/marketplace-commission-calculator', badge: 'Multi-Channel Side-by-Side', desc: 'Side-by-side comparison of fees across Meesho, Flipkart, Amazon, and Myntra.' }
    ]
  },
  {
    id: 'advertising',
    title: '6. Advertising Calculators',
    count: 7,
    subtitle: 'E-commerce PPC metrics: Return on Ad Spend (ROAS), ACOS, TACOS, and customer acquisition efficiency.',
    tools: [
      { title: 'ROAS Calculator', url: '/roas-calculator', badge: 'Ad Multiplier', desc: 'Return on Ad Spend multiplier (Revenue / Spend) and ad profit.' },
      { title: 'ACOS Calculator', url: '/acos-calculator', badge: 'Ad Cost of Sales', desc: 'Amazon Sponsored Ads efficiency: (Ad Spend / Ad Sales) x 100%.' },
      { title: 'TACOS Calculator', url: '/tacos-calculator', badge: 'Total ACOS', desc: 'Total ad spend against overall catalog revenue for brand health.' },
      { title: 'Break-Even ROAS Calculator', url: '/break-even-roas-calculator', badge: 'Minimum ROAS Target', desc: 'Find minimum ROAS required before ad campaigns start losing money.' },
      { title: 'Cost Per Order (CPO) Calculator', url: '/cost-per-order-calculator', badge: 'Ad CPA', desc: 'Average ad budget required to generate a single converted order.' },
      { title: 'Customer Acquisition Cost (CAC) Calculator', url: '/customer-acquisition-cost-calculator', badge: 'CAC & LTV', desc: 'Blended marketing spend per customer and LTV:CAC ratio.' },
      { title: 'Ad Profit Calculator', url: '/ad-profit-calculator', badge: 'Net Ad Contribution', desc: 'Net bottom line profit from paid advertising after COGS and delivery.' }
    ]
  },
  {
    id: 'operations',
    title: '7. Marketplace Operations Calculators',
    count: 8,
    subtitle: 'Settlement reconciliation, inventory reorder points, payout predictions, and bulk order margins.',
    tools: [
      { title: 'Marketplace Settlement Calculator', url: '/marketplace-settlement-calculator', badge: 'Bank Payout', desc: 'Net bank credit after commission, courier, GST, TCS, and TDS.' },
      { title: 'Seller Payout Calculator', url: '/seller-payout-calculator', badge: 'Net Payout Slabs', desc: 'Gross order value minus marketplace deductions and returns reserve.' },
      { title: 'Marketplace Reconciliation Calculator', url: '/marketplace-reconciliation-calculator', badge: 'Audit & Claims', desc: 'Detect missing payouts and overcharged courier weight disputes.' },
      { title: 'Monthly Seller Profit Calculator', url: '/monthly-seller-profit-calculator', badge: 'P&L Statement', desc: 'High-level monthly business profit after all overheads and COGS.' },
      { title: 'Bulk Order Profit Calculator', url: '/bulk-order-profit-calculator', badge: 'B2B Slabs', desc: 'Discounted wholesale orders with bulk freight and unit profits.' },
      { title: 'Inventory Profit Calculator', url: '/inventory-profit-calculator', badge: 'Stock Value', desc: 'Total warehouse inventory value and potential unrealized profit.' },
      { title: 'Inventory Reorder Calculator', url: '/inventory-reorder-calculator', badge: 'Reorder Point (ROP)', desc: 'Optimal reorder trigger based on daily run-rate, lead time, and safety stock.' },
      { title: 'Minimum Selling Price Calculator', url: '/minimum-selling-price-calculator', badge: 'Floor Price', desc: 'Absolute minimum selling price to avoid operating at a loss.' }
    ]
  }
];

const totalCalculators = CATEGORIES.reduce((acc, cat) => acc + cat.tools.length, 0);
---

<Layout
  title="All 61 E-commerce Seller Calculators | Free Indian Marketplace & D2C Profit Suite"
  description="Exhaustive collection of 61 free calculators for Indian online sellers: Amazon, Flipkart, Meesho, Myntra, Quick Commerce, GST, Shipping, ROAS, and Operations."
  canonicalPath="/all-calculators"
>
  <main class="min-h-screen bg-white">
    <!-- Hero Banner -->
    <section class="border-b border-neutral-200 bg-neutral-50/50 py-12 sm:py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center gap-2 mb-3">
          <span class="text-xs font-mono font-bold px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200">
            Complete Suite: {totalCalculators} Free Tools
          </span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-neutral-900">
          All E-commerce Seller Calculators
        </h1>
        <p class="mt-3 text-sm sm:text-base text-neutral-600 max-w-2xl mx-auto">
          Every mathematical formula you need to price products, audit marketplace deductions, slash RTO losses, and maximize net profits in 2026.
        </p>

        <!-- Quick Jump Bar -->
        <div class="mt-6 flex flex-wrap items-center justify-center gap-1.5 sm:gap-2 text-[11px] sm:text-xs">
          {CATEGORIES.map((cat, idx) => (
            <a
              href={`#cat-${cat.id}`}
              class="px-2.5 sm:px-3 py-1.5 rounded-lg bg-white border border-neutral-200 text-neutral-700 hover:border-neutral-900 hover:text-neutral-900 font-medium transition shadow-2xs"
            >
              {cat.title.split('. ')[1]} ({cat.count})
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Categories & Tools Grid -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-12 sm:space-y-16">
      {CATEGORIES.map((cat) => (
        <section id={`cat-${cat.id}`} class="scroll-mt-20">
          <div class="border-b border-neutral-200 pb-4 mb-6">
            <div class="flex items-center justify-between">
              <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-neutral-900">
                {cat.title}
              </h2>
              <span class="text-xs font-mono font-medium px-2 py-0.5 rounded-md bg-neutral-100 text-neutral-600">
                {cat.count} Calculators
              </span>
            </div>
            <p class="text-xs sm:text-sm text-neutral-500 mt-1">
              {cat.subtitle}
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {cat.tools.map((tool) => (
              <a
                href={tool.url}
                class="group flex flex-col justify-between p-5 rounded-2xl bg-white border border-neutral-200 hover:border-neutral-900 transition-all hover:shadow-xs"
              >
                <div>
                  <div class="flex items-center justify-between gap-2 mb-2">
                    <span class="text-[11px] font-mono font-semibold px-2 py-0.5 rounded-full bg-neutral-50 text-neutral-700 border border-neutral-200 group-hover:bg-emerald-50 group-hover:text-emerald-800 group-hover:border-emerald-200 transition">
                      {tool.badge}
                    </span>
                    <span class="text-neutral-300 group-hover:text-neutral-900 group-hover:translate-x-0.5 transition-all text-sm font-semibold">
                      &rarr;
                    </span>
                  </div>
                  <h3 class="text-sm font-semibold text-neutral-900 group-hover:text-emerald-700 transition">
                    {tool.title}
                  </h3>
                  <p class="text-xs text-neutral-500 mt-1.5 leading-relaxed">
                    {tool.desc}
                  </p>
                </div>
                <div class="mt-4 pt-3 border-t border-neutral-100 flex items-center justify-between text-[11px] text-neutral-400 font-mono">
                  <span>Open Tool</span>
                  <span class="text-neutral-600 group-hover:text-neutral-900 font-medium">Free &bull; 2026</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </main>
</Layout>
