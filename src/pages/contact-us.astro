---
// src/pages/contact-us.astro
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact Us | Free Seller Profit Calculator Support & Feedback"
  description="Contact the Seller Profit Calculator team. Report marketplace fee slab updates, suggest new e-commerce tools, or request calculation assistance."
  canonicalPath="/contact-us"
>
  <main class="min-h-screen bg-white">
    <!-- Hero Banner -->
    <section class="border-b border-neutral-200 bg-neutral-50/50 py-10 sm:py-14">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <div class="inline-flex items-center gap-2 mb-2">
          <span class="text-xs font-mono font-bold px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200">
            Get in Touch
          </span>
        </div>
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-neutral-900">
          Contact Our Team
        </h1>
        <p class="mt-2 text-xs sm:text-sm text-neutral-500 max-w-xl mx-auto">
          Notice a new rate card circular on Amazon or Flipkart? Have an idea for a new calculator? We would love to hear from you.
        </p>
      </div>
    </section>

    <!-- Main Grid -->
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Left: Contact Details & Office (5 Cols) -->
        <div class="lg:col-span-5 space-y-6">
          <div class="bg-white border border-neutral-200 rounded-2xl p-6 shadow-xs space-y-4">
            <h2 class="text-base font-bold text-neutral-900">
              Direct Channels
            </h2>
            <p class="text-xs text-neutral-500 leading-relaxed">
              We respond to all seller inquiries, bug reports, and marketplace rate card updates within 24 business hours.
            </p>

            <div class="space-y-3 pt-2 text-xs">
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-lg bg-neutral-100 flex items-center justify-center shrink-0 text-neutral-700 font-mono text-sm">
                  ✉
                </div>
                <div>
                  <span class="text-neutral-400 block text-[11px]">General Inquiries</span>
                  <a href="mailto:support@freesellerprofitcalculator.com" class="font-semibold text-neutral-900 hover:text-emerald-700 transition">
                    support@freesellerprofitcalculator.com
                  </a>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-lg bg-neutral-100 flex items-center justify-center shrink-0 text-neutral-700 font-mono text-sm">
                  §
                </div>
                <div>
                  <span class="text-neutral-400 block text-[11px]">Legal &amp; Rate Cards</span>
                  <a href="mailto:legal@freesellerprofitcalculator.com" class="font-semibold text-neutral-900 hover:text-emerald-700 transition">
                    legal@freesellerprofitcalculator.com
                  </a>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-lg bg-neutral-100 flex items-center justify-center shrink-0 text-neutral-700 font-mono text-sm">
                  ◷
                </div>
                <div>
                  <span class="text-neutral-400 block text-[11px]">Working Hours</span>
                  <span class="font-medium text-neutral-800">Monday &ndash; Saturday, 9:00 AM &ndash; 6:00 PM IST</span>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-lg bg-neutral-100 flex items-center justify-center shrink-0 text-neutral-700 font-mono text-sm">
                  📍
                </div>
                <div>
                  <span class="text-neutral-400 block text-[11px]">Locations</span>
                  <span class="font-medium text-neutral-800">Bengaluru &amp; New Delhi, India</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Fast Links Card -->
          <div class="bg-neutral-50 border border-neutral-200 rounded-2xl p-5 text-xs space-y-2">
            <span class="font-semibold text-neutral-900 block">Frequently Used Calculators:</span>
            <ul class="space-y-1 text-neutral-600">
              <li><a href="/amazon" class="hover:text-black transition">&bull; Amazon Profit Calculator (2026)</a></li>
              <li><a href="/flipkart" class="hover:text-black transition">&bull; Flipkart Seller Fee Calculator</a></li>
              <li><a href="/meesho" class="hover:text-black transition">&bull; Meesho 0% Commission Calculator</a></li>
              <li><a href="/rto-loss-calculator" class="hover:text-black transition">&bull; RTO Loss Calculator</a></li>
              <li><a href="/gst-calculator" class="hover:text-black transition">&bull; GST &amp; ITC Slab Solver</a></li>
            </ul>
          </div>
        </div>

        <!-- Right: Interactive Message Form (7 Cols) -->
        <div class="lg:col-span-7 bg-white border border-neutral-200 rounded-2xl p-6 sm:p-7 shadow-xs">
          <div class="mb-5 pb-3 border-b border-neutral-100">
            <h2 class="text-base font-bold text-neutral-900">
              Send Us a Message
            </h2>
            <p class="text-xs text-neutral-500 mt-0.5">
              Fill out the form below and our team will get back to you promptly.
            </p>
          </div>

          <!-- Success Alert Message (Hidden by default) -->
          <div id="contactSuccessMsg" class="hidden mb-5 p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-xs text-emerald-950">
            <div class="font-bold flex items-center gap-1.5 mb-1">
              <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
              Message Received!
            </div>
            <p class="text-neutral-600">
              Thank you for reaching out. We have logged your submission and will respond via email within 24 hours.
            </p>
          </div>

          <form id="contactForm" class="space-y-4" onsubmit="return false;">
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label for="contactName" class="block text-xs font-medium text-neutral-700 mb-1">
                  Your Name <span class="text-rose-500">*</span>
                </label>
                <input
                  type="text"
                  id="contactName"
                  required
                  placeholder="e.g. Rahul Sharma"
                  class="w-full px-3 py-2.5 bg-white border border-neutral-200 focus:border-neutral-900 rounded-xl text-xs sm:text-sm text-neutral-900 outline-none min-h-[42px]"
                />
              </div>

              <div>
                <label for="contactEmail" class="block text-xs font-medium text-neutral-700 mb-1">
                  Email Address <span class="text-rose-500">*</span>
                </label>
                <input
                  type="email"
                  id="contactEmail"
                  required
                  placeholder="rahul@example.com"
                  class="w-full px-3 py-2.5 bg-white border border-neutral-200 focus:border-neutral-900 rounded-xl text-xs sm:text-sm text-neutral-900 outline-none min-h-[42px]"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label for="contactPlatform" class="block text-xs font-medium text-neutral-700 mb-1">
                  Primary Selling Channel
                </label>
                <select
                  id="contactPlatform"
                  class="w-full px-3 py-2.5 bg-white border border-neutral-200 focus:border-neutral-900 rounded-xl text-xs sm:text-sm text-neutral-800 outline-none cursor-pointer min-h-[42px]"
                >
                  <option value="amazon">Amazon India</option>
                  <option value="flipkart">Flipkart</option>
                  <option value="meesho">Meesho</option>
                  <option value="myntra">Myntra / AJIO</option>
                  <option value="qcomm">Blinkit / Zepto (Quick Commerce)</option>
                  <option value="d2c">D2C / Shopify</option>
                  <option value="other">Multiple / Other</option>
                </select>
              </div>

              <div>
                <label for="contactTopic" class="block text-xs font-medium text-neutral-700 mb-1">
                  Inquiry Topic
                </label>
                <select
                  id="contactTopic"
                  class="w-full px-3 py-2.5 bg-white border border-neutral-200 focus:border-neutral-900 rounded-xl text-xs sm:text-sm text-neutral-800 outline-none cursor-pointer min-h-[42px]"
                >
                  <option value="rate_card">Report Rate Card Update</option>
                  <option value="bug">Report Bug / Calculation Discrepancy</option>
                  <option value="feature">Suggest a New Calculator</option>
                  <option value="partnership">Brand Partnership / Press</option>
                  <option value="general">General Question</option>
                </select>
              </div>
            </div>

            <div>
              <label for="contactSubject" class="block text-xs font-medium text-neutral-700 mb-1">
                Subject
              </label>
              <input
                type="text"
                id="contactSubject"
                placeholder="Brief summary of your question or suggestion"
                class="w-full px-3 py-2.5 bg-white border border-neutral-200 focus:border-neutral-900 rounded-xl text-xs sm:text-sm text-neutral-900 outline-none min-h-[42px]"
              />
            </div>

            <div>
              <label for="contactMessage" class="block text-xs font-medium text-neutral-700 mb-1">
                Message <span class="text-rose-500">*</span>
              </label>
              <textarea
                id="contactMessage"
                rows="4"
                required
                placeholder="Describe the issue, new fee slab circular, or suggestion in detail..."
                class="w-full px-3 py-2.5 bg-white border border-neutral-200 focus:border-neutral-900 rounded-xl text-xs sm:text-sm text-neutral-900 outline-none resize-y"
              ></textarea>
            </div>

            <button
              type="submit"
              id="submitContactBtn"
              class="w-full py-3 bg-neutral-900 hover:bg-neutral-800 text-white font-medium text-xs sm:text-sm rounded-xl transition cursor-pointer shadow-xs min-h-[44px]"
            >
              Send Message &rarr;
            </button>
          </form>

        </div>

      </div>
    </div>
  </main>
</Layout>

<script is:inline>
(function() {
  const form = document.getElementById('contactForm');
  const successMsg = document.getElementById('contactSuccessMsg');
  if (!form || !successMsg) return;

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    const name = document.getElementById('contactName').value.trim();
    const email = document.getElementById('contactEmail').value.trim();
    const message = document.getElementById('contactMessage').value.trim();

    if (!name || !email || !message) {
      alert('Please fill out all required fields (Name, Email, and Message).');
      return;
    }

    // Success feedback
    successMsg.classList.remove('hidden');
    successMsg.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    form.reset();
  });
})();
</script>
