---
import Layout from '../layouts/Layout.astro';
import Calculator from '../components/Calculator.astro';
import ComparisonMatrix from '../components/ComparisonMatrix.astro';
import ReversePriceSolver from '../components/ReversePriceSolver.astro';
import FeeGuide from '../components/FeeGuide.astro';
import FaqSection from '../components/FaqSection.astro';
---

<Layout
  title="Myntra Seller Profit Calculator (2026) | Fashion Marketplace Fee & Payout Calculator"
  description="Calculate exact Myntra seller bank settlement, fashion category referral fees (12%-24%), fixed closing fees, high return rate buffers, and true net in-hand profit for 2026."
  canonicalPath="/myntra"
  activePlatform="myntra"
>
  <!-- Dedicated Platform Header Banner -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-6">
    <div class="bg-rose-50/60 border border-rose-200/80 rounded-2xl p-5 sm:p-6 mb-2">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 mb-1.5">
            <span class="text-xs font-mono font-bold px-2 py-0.5 rounded-full bg-rose-100 text-rose-800 border border-rose-200">
              Fashion &amp; Lifestyle
            </span>
            <span class="text-xs text-neutral-500 font-mono">2026 Slabs</span>
          </div>
          <h1 class="text-xl sm:text-2xl font-bold text-neutral-900 tracking-tight">
            Myntra Seller Profit Calculator
          </h1>
          <p class="text-xs sm:text-sm text-neutral-600 mt-1 max-w-2xl leading-relaxed">
            Myntra charges <strong>12%&ndash;24% category commission</strong> on fashion apparel, shoes, and beauty products, plus <strong>fixed closing fee slabs (₹15&ndash;₹40)</strong>. Because fashion experiences 20%&ndash;30% customer returns, return buffer modeling is vital.
          </p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 shrink-0 text-xs font-mono">
          <div class="bg-white border border-rose-200 rounded-xl p-2.5 text-center">
            <div class="text-[10px] text-neutral-500 uppercase font-sans">Commission</div>
            <div class="font-bold text-rose-700 text-sm mt-0.5">12% &ndash; 24%</div>
          </div>
          <div class="bg-white border border-rose-200 rounded-xl p-2.5 text-center">
            <div class="text-[10px] text-neutral-500 uppercase font-sans">Closing Fee</div>
            <div class="font-bold text-neutral-900 text-sm mt-0.5">₹15 &ndash; ₹40</div>
          </div>
          <div class="bg-white border border-rose-200 rounded-xl p-2.5 text-center col-span-2 sm:col-span-1">
            <div class="text-[10px] text-neutral-500 uppercase font-sans">Fashion Return Avg</div>
            <div class="font-bold text-neutral-900 text-sm mt-0.5">25% Rate</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Calculator Preloaded with Myntra -->
  <Calculator
    initialMarketplace="myntra"
    title="Calculate Myntra Seller Payout & In-Hand Profit"
    subtitle="Model category commissions, closing fee slabs, 2% collection fee, and reverse courier penalties."
  />

  <!-- Side-by-Side Comparison -->
  <ComparisonMatrix />

  <!-- Reverse Target Price Solver -->
  <ReversePriceSolver />

  <!-- Fee Guide -->
  <FeeGuide />

  <!-- FAQ -->
  <FaqSection />
</Layout>
