---
import Layout from '../layouts/Layout.astro';
import Calculator from '../components/Calculator.astro';
import ComparisonMatrix from '../components/ComparisonMatrix.astro';
import ReversePriceSolver from '../components/ReversePriceSolver.astro';
import FeeGuide from '../components/FeeGuide.astro';
import FaqSection from '../components/FaqSection.astro';

const amazonFaqs = [
  {
    q: "What fees does Amazon India deduct from seller payouts in 2026?",
    a: "Amazon India deducts: 1) Category Referral Fee (5% to 15% based on product category), 2) Closing Fee (₹5 to ₹50 based on selling price slabs), 3) Weight Handling / Shipping Fee (Easy Ship starting at ₹44 for 500g local or FBA fulfillment fees), 4) 18% GST on all Amazon fees, and 5) 1% TCS and 0.1% Section 194-O TDS."
  },
  {
    q: "What is the difference between Amazon Easy Ship, FBA, and Self-Ship (FBM)?",
    a: "In Easy Ship, you pack the parcel at your warehouse and Amazon Logistics picks it up. In FBA (Fulfillment by Amazon), you store inventory in Amazon fulfillment centers, and Amazon handles picking, packing, fast Prime delivery, and customer service for an additional pick-and-pack fee. In Self-Ship (FBM), you use your own third-party couriers like Delhivery or Blue Dart."
  },
  {
    q: "How does Amazon calculate dynamic Closing Fee slabs?",
    a: "Under Amazon India's 2026 fee structure for Easy Ship Standard: orders up to ₹250 incur ₹5; ₹251 to ₹500 incur ₹10; ₹501 to ₹1,000 incur ₹25; ₹1,001 to ₹2,000 incur ₹35; and orders above ₹2,000 incur ₹50 closing fee (+18% GST)."
  },
  {
    q: "How can sellers recover 18% GST deducted by Amazon on selling fees?",
    a: "Amazon issues a monthly B2B GST tax invoice detailing all fees and GST charged. As a regular GST registered seller, this amount appears in your GSTR-2B and can be claimed 100% as Input Tax Credit (ITC) in your monthly GSTR-3B filing to reduce the GST payable on customer sales."
  }
];
---

<Layout
  title="Amazon India Seller Profit Calculator (2026) | Easy Ship & FBA Fee Calculator"
  description="Calculate exact Amazon India seller payout, category referral fees (5%-15%), dynamic closing fees (₹5-₹50), Easy Ship weight handling courier charges, and 18% GST ITC for 2026."
  canonicalPath="/amazon-profit-calculator"
  activePlatform="amazon"
>
  <!-- Dedicated Platform Header Banner -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-6">
    <div class="bg-amber-50/60 border border-amber-200/80 rounded-2xl p-5 sm:p-6 mb-2">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 mb-1.5">
            <span class="text-xs font-mono font-bold px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 border border-amber-200">
              Amazon Easy Ship &amp; FBA
            </span>
            <span class="text-xs text-neutral-500 font-mono">2026 Slabs</span>
          </div>
          <h1 class="text-xl sm:text-2xl font-bold text-neutral-900 tracking-tight">
            Amazon India Seller Profit Calculator
          </h1>
          <p class="text-xs sm:text-sm text-neutral-600 mt-1 max-w-2xl leading-relaxed">
            Amazon deducts <strong>category referral commissions (5%&ndash;15%)</strong>, <strong>automatic closing fee slabs (₹5&ndash;₹50 based on selling price)</strong>, and Easy Ship weight handling courier fees.
          </p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 shrink-0 text-xs font-mono">
          <div class="bg-white border border-amber-200 rounded-xl p-2.5 text-center">
            <div class="text-[10px] text-neutral-500 uppercase font-sans">Commission</div>
            <div class="font-bold text-amber-700 text-sm mt-0.5">5% &ndash; 15%</div>
          </div>
          <div class="bg-white border border-amber-200 rounded-xl p-2.5 text-center">
            <div class="text-[10px] text-neutral-500 uppercase font-sans">Closing Fee</div>
            <div class="font-bold text-neutral-900 text-sm mt-0.5">₹5 &ndash; ₹50</div>
          </div>
          <div class="bg-white border border-amber-200 rounded-xl p-2.5 text-center col-span-2 sm:col-span-1">
            <div class="text-[10px] text-neutral-500 uppercase font-sans">Easy Ship Base</div>
            <div class="font-bold text-neutral-900 text-sm mt-0.5">₹44 &ndash; ₹74</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Calculator Preloaded with Amazon -->
  <Calculator
    initialMarketplace="amazon"
    title="Calculate Amazon India Payout & Take-Home Profit"
    subtitle="Model exact Easy Ship courier handling rates, closing fee tiers, category referral rates, and GST ITC offset."
  />

  <!-- Side-by-Side Comparison -->
  <ComparisonMatrix />

  <!-- Reverse Target Price Solver -->
  <ReversePriceSolver />

  <!-- Fee Guide -->
  <FeeGuide />

  <!-- FAQ -->
  <FaqSection
    title="Amazon Seller Profit Calculator Frequently Asked Questions"
    subtitle="Learn how Amazon Easy Ship, FBA pick & pack, closing fee tiers, and GST ITC work in 2026."
    faqs={amazonFaqs}
  />
</Layout>