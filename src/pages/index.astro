---
import Layout from '../layouts/Layout.astro';
import Calculator from '../components/Calculator.astro';
import ComparisonMatrix from '../components/ComparisonMatrix.astro';
import ReversePriceSolver from '../components/ReversePriceSolver.astro';
import FeeGuide from '../components/FeeGuide.astro';
import FaqSection from '../components/FaqSection.astro';
---

<Layout
  title="Seller Profit Calculator | Free Meesho, Flipkart & Amazon Profit & Fee Calculator"
  description="Calculate exact net in-hand profit, marketplace commissions, courier shipping charges, GST deductions, and expected RTO / customer return losses for Meesho, Flipkart & Amazon sellers. 100% free, updated for 2026."
  canonicalPath="/"
  activePlatform="home"
>
  <!-- Quick Marketplace Navigation Cards -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-6">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      <a href="/meesho" class="card-ver p-4 hover:border-pink-300 hover:shadow-xs transition group bg-white">
        <div class="flex items-center justify-between mb-1">
          <span class="font-bold text-sm text-neutral-900 group-hover:text-pink-600">Meesho</span>
          <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-pink-50 text-pink-700 font-semibold">0% Fee</span>
        </div>
        <p class="text-[11px] text-neutral-500 leading-snug">Zero commission model with weight-slab shipping.</p>
      </a>

      <a href="/flipkart" class="card-ver p-4 hover:border-blue-300 hover:shadow-xs transition group bg-white">
        <div class="flex items-center justify-between mb-1">
          <span class="font-bold text-sm text-neutral-900 group-hover:text-blue-600">Flipkart</span>
          <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-blue-50 text-blue-700 font-semibold">2026 Slabs</span>
        </div>
        <p class="text-[11px] text-neutral-500 leading-snug">Fixed fees (₹13-₹52) + 2% collection fee.</p>
      </a>

      <a href="/amazon" class="card-ver p-4 hover:border-amber-300 hover:shadow-xs transition group bg-white">
        <div class="flex items-center justify-between mb-1">
          <span class="font-bold text-sm text-neutral-900 group-hover:text-amber-600">Amazon India</span>
          <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-amber-50 text-amber-700 font-semibold">Easy Ship</span>
        </div>
        <p class="text-[11px] text-neutral-500 leading-snug">Closing fee slabs (₹5-₹50) + referral commissions.</p>
      </a>

      <a href="/snapdeal" class="card-ver p-4 hover:border-red-300 hover:shadow-xs transition group bg-white">
        <div class="flex items-center justify-between mb-1">
          <span class="font-bold text-sm text-neutral-900 group-hover:text-red-600">Snapdeal</span>
          <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-red-50 text-red-700 font-semibold">Flat ₹10</span>
        </div>
        <p class="text-[11px] text-neutral-500 leading-snug">Value commerce pricing with flat closing fee.</p>
      </a>
    </div>
  </section>

  <Calculator />
  <ComparisonMatrix />
  <ReversePriceSolver />
  <FeeGuide />
  <FaqSection />
</Layout>
