---
import Layout from '../layouts/Layout.astro';
import Calculator from '../components/Calculator.astro';
import ComparisonMatrix from '../components/ComparisonMatrix.astro';
import ReversePriceSolver from '../components/ReversePriceSolver.astro';
import FeeGuide from '../components/FeeGuide.astro';
import FaqSection from '../components/FaqSection.astro';
---

<Layout
  title="Meesho Profit Calculator (2026) | Zero Commission Seller Payout & Fee Calculator"
  description="Calculate exact Meesho seller bank payout, 0% commission deductions, weight-slab courier shipping charges, reverse return penalties, and net take-home profit for 2026."
  canonicalPath="/meesho"
  activePlatform="meesho"
>
  <!-- Dedicated Platform Header Banner -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-6">
    <div class="bg-pink-50/60 border border-pink-200/80 rounded-2xl p-5 sm:p-6 mb-2">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 mb-1.5">
            <span class="text-xs font-mono font-bold px-2 py-0.5 rounded-full bg-pink-100 text-pink-800 border border-pink-200">
              0% Commission Model
            </span>
            <span class="text-xs text-neutral-500 font-mono">Updated for 2026</span>
          </div>
          <h1 class="text-xl sm:text-2xl font-bold text-neutral-900 tracking-tight">
            Meesho Seller Profit Calculator
          </h1>
          <p class="text-xs sm:text-sm text-neutral-600 mt-1 max-w-2xl leading-relaxed">
            Meesho charges <strong>0% referral fee</strong> and <strong>₹0 fixed closing fees</strong>. Payout deductions are strictly courier shipping plus 18% GST on shipping, with unrecoverable customer return penalties.
          </p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 shrink-0 text-xs font-mono">
          <div class="bg-white border border-pink-200 rounded-xl p-2.5 text-center">
            <div class="text-[10px] text-neutral-500 uppercase font-sans">Commission</div>
            <div class="font-bold text-pink-700 text-sm mt-0.5">0%</div>
          </div>
          <div class="bg-white border border-pink-200 rounded-xl p-2.5 text-center">
            <div class="text-[10px] text-neutral-500 uppercase font-sans">Closing Fee</div>
            <div class="font-bold text-neutral-900 text-sm mt-0.5">₹0.00</div>
          </div>
          <div class="bg-white border border-pink-200 rounded-xl p-2.5 text-center col-span-2 sm:col-span-1">
            <div class="text-[10px] text-neutral-500 uppercase font-sans">Base Shipping</div>
            <div class="font-bold text-neutral-900 text-sm mt-0.5">₹49 (500g)</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Calculator Preloaded with Meesho -->
  <Calculator
    initialMarketplace="meesho"
    title="Calculate Meesho Net Profit & Bank Settlement"
    subtitle="Adjust your selling price, manufacturing cost, and category to see exact in-hand take-home margins."
  />

  <!-- Side-by-Side Comparison -->
  <ComparisonMatrix />

  <!-- Reverse Target Price Solver -->
  <ReversePriceSolver />

  <!-- Fee Guide -->
  <FeeGuide />

  <!-- FAQ -->
  <FaqSection />
</Layout>