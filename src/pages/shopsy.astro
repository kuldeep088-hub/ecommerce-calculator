---
import Layout from '../layouts/Layout.astro';
import Calculator from '../components/Calculator.astro';
import ComparisonMatrix from '../components/ComparisonMatrix.astro';
import ReversePriceSolver from '../components/ReversePriceSolver.astro';
import FeeGuide from '../components/FeeGuide.astro';
import FaqSection from '../components/FaqSection.astro';
---

<Layout
  title="Shopsy Seller Profit Calculator (2026) | Flipkart Value Commerce Fee Calculator"
  description="Calculate exact Shopsy seller payout, 0% budget commission rates, low fixed fees, courier charges, COD return buffers, and net take-home profit for 2026."
  canonicalPath="/shopsy"
  activePlatform="shopsy"
>
  <!-- Dedicated Platform Header Banner -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-6">
    <div class="bg-emerald-50/60 border border-emerald-200/80 rounded-2xl p-5 sm:p-6 mb-2">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 mb-1.5">
            <span class="text-xs font-mono font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-200">
              Flipkart Value Commerce
            </span>
            <span class="text-xs text-neutral-500 font-mono">2026 Slabs</span>
          </div>
          <h1 class="text-xl sm:text-2xl font-bold text-neutral-900 tracking-tight">
            Shopsy Seller Profit Calculator
          </h1>
          <p class="text-xs sm:text-sm text-neutral-600 mt-1 max-w-2xl leading-relaxed">
            Shopsy offers <strong>0% commission</strong> on select budget clothing and footwear, with low 3%&ndash;8% fees on other catalog items and <strong>nominal fixed fees (₹0&ndash;₹12)</strong> designed for value-conscious Bharat shoppers.
          </p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 shrink-0 text-xs font-mono">
          <div class="bg-white border border-emerald-200 rounded-xl p-2.5 text-center">
            <div class="text-[10px] text-neutral-500 uppercase font-sans">Commission</div>
            <div class="font-bold text-emerald-700 text-sm mt-0.5">0% &ndash; 8%</div>
          </div>
          <div class="bg-white border border-emerald-200 rounded-xl p-2.5 text-center">
            <div class="text-[10px] text-neutral-500 uppercase font-sans">Fixed Fee</div>
            <div class="font-bold text-neutral-900 text-sm mt-0.5">₹0 &ndash; ₹12</div>
          </div>
          <div class="bg-white border border-emerald-200 rounded-xl p-2.5 text-center col-span-2 sm:col-span-1">
            <div class="text-[10px] text-neutral-500 uppercase font-sans">Base Shipping</div>
            <div class="font-bold text-neutral-900 text-sm mt-0.5">₹45.00</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Calculator Preloaded with Shopsy -->
  <Calculator
    initialMarketplace="shopsy"
    title="Calculate Shopsy Seller Payout & Net Profit"
    subtitle="Model budget commission slabs, low fixed closing fees, courier shipping, and COD return loss buffers."
  />

  <!-- Side-by-Side Comparison -->
  <ComparisonMatrix />

  <!-- Reverse Target Price Solver -->
  <ReversePriceSolver />

  <!-- Fee Guide -->
  <FeeGuide />

  <!-- FAQ -->
  <FaqSection />
</Layout>
