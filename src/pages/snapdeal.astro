---
import Layout from '../layouts/Layout.astro';
import Calculator from '../components/Calculator.astro';
import ComparisonMatrix from '../components/ComparisonMatrix.astro';
import ReversePriceSolver from '../components/ReversePriceSolver.astro';
import FeeGuide from '../components/FeeGuide.astro';
import FaqSection from '../components/FaqSection.astro';
---

<Layout
  title="Snapdeal Seller Fee & Profit Calculator (2026) | Net Payout & Commission Calculator"
  description="Calculate exact Snapdeal seller bank settlement, value-commerce commissions (0%-10%), flat ₹10 closing fees, courier shipping, and expected return loss buffers for 2026."
  canonicalPath="/snapdeal"
  activePlatform="snapdeal"
>
  <!-- Dedicated Platform Header Banner -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-6">
    <div class="bg-red-50/60 border border-red-200/80 rounded-2xl p-5 sm:p-6 mb-2">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 mb-1.5">
            <span class="text-xs font-mono font-bold px-2 py-0.5 rounded-full bg-red-100 text-red-800 border border-red-200">
              Value E-Commerce
            </span>
            <span class="text-xs text-neutral-500 font-mono">2026 Structure</span>
          </div>
          <h1 class="text-xl sm:text-2xl font-bold text-neutral-900 tracking-tight">
            Snapdeal Seller Fee &amp; Profit Calculator
          </h1>
          <p class="text-xs sm:text-sm text-neutral-600 mt-1 max-w-2xl leading-relaxed">
            Snapdeal caters to value-conscious Tier 2&ndash;4 buyers with low <strong>0% to 10% commissions</strong> and a <strong>flat ₹10 closing fee</strong> across product pricing tiers.
          </p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 shrink-0 text-xs font-mono">
          <div class="bg-white border border-red-200 rounded-xl p-2.5 text-center">
            <div class="text-[10px] text-neutral-500 uppercase font-sans">Commission</div>
            <div class="font-bold text-red-700 text-sm mt-0.5">0% &ndash; 10%</div>
          </div>
          <div class="bg-white border border-red-200 rounded-xl p-2.5 text-center">
            <div class="text-[10px] text-neutral-500 uppercase font-sans">Closing Fee</div>
            <div class="font-bold text-neutral-900 text-sm mt-0.5">₹10.00</div>
          </div>
          <div class="bg-white border border-red-200 rounded-xl p-2.5 text-center col-span-2 sm:col-span-1">
            <div class="text-[10px] text-neutral-500 uppercase font-sans">Base Shipping</div>
            <div class="font-bold text-neutral-900 text-sm mt-0.5">₹55.00</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Calculator Preloaded with Snapdeal -->
  <Calculator
    initialMarketplace="snapdeal"
    title="Calculate Snapdeal Payout & True Profit"
    subtitle="Model Snapdeal value pricing, ₹10 flat closing fees, courier delivery slabs, and COD return buffers."
  />

  <!-- Side-by-Side Comparison -->
  <ComparisonMatrix />

  <!-- Reverse Target Price Solver -->
  <ReversePriceSolver />

  <!-- Fee Guide -->
  <FeeGuide />

  <!-- FAQ -->
  <FaqSection />
</Layout>