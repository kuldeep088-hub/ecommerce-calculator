---
import Layout from '../layouts/Layout.astro';
import Calculator from '../components/Calculator.astro';
import ComparisonMatrix from '../components/ComparisonMatrix.astro';
import ReversePriceSolver from '../components/ReversePriceSolver.astro';
import FeeGuide from '../components/FeeGuide.astro';
import FaqSection from '../components/FaqSection.astro';

const flipkartFaqs = [
  {
    q: "What are the primary fee components for selling on Flipkart in 2026?",
    a: "Flipkart seller deductions include: 1) Category Referral Commission (3% to 18%), 2) Fixed Fee based on selling price slabs (₹13 to ₹52), 3) 2% Payment Collection Fee on all orders (prepaid and COD), 4) Shipping Fee based on weight and seller tier (Bronze, Silver, Gold), and 5) 18% GST on all marketplace fees."
  },
  {
    q: "How does Flipkart seller tiering (Bronze, Silver, Gold) impact shipping fees?",
    a: "Flipkart rewards top-performing sellers with discounted shipping rates. Gold sellers enjoy the lowest shipping fees and fast-track payment cycles, Silver sellers receive standard rates, and Bronze sellers pay slightly higher fulfillment fees. Upgrading your tier by reducing dispatch delays and cancellation rates improves net margin by 2% to 4%."
  },
  {
    q: "What is Flipkart FBF (Fulfilled by Flipkart) vs Non-FBF?",
    a: "With FBF, products are stored in Flipkart's automated fulfillment centers with Assured badges, priority search placement, and fast delivery, but incur pick & pack and monthly storage charges. Non-FBF (Standard) requires you to pack and dispatch orders from your own location using Flipkart eKart logistics."
  },
  {
    q: "How are customer returns and cancellation fees handled on Flipkart?",
    a: "For customer returns, Flipkart charges reverse shipping fees back to the seller. For seller-side order cancellations due to stockouts, Flipkart imposes strict monetary penalties (often equivalent to the referral fee of the cancelled product). Our calculator helps you factor these operational risks into your retail pricing."
  }
];
---

<Layout
  title="Flipkart Seller Fee & Profit Calculator (2026) | Settlement & Commission Calculator"
  description="Calculate exact Flipkart seller bank payout, category referral fees (4%-16%), price-slab fixed fees (₹13-₹52), 2% payment collection fee, tier shipping, and net profit for 2026."
  canonicalPath="/flipkart"
  activePlatform="flipkart"
>
  <!-- Dedicated Platform Header Banner -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-6">
    <div class="bg-blue-50/60 border border-blue-200/80 rounded-2xl p-5 sm:p-6 mb-2">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 mb-1.5">
            <span class="text-xs font-mono font-bold px-2 py-0.5 rounded-full bg-blue-100 text-blue-800 border border-blue-200">
              Flipkart Non-FBF &amp; FBF
            </span>
            <span class="text-xs text-neutral-500 font-mono">Verified 2026 Slabs</span>
          </div>
          <h1 class="text-xl sm:text-2xl font-bold text-neutral-900 tracking-tight">
            Flipkart Seller Fee &amp; Profit Calculator
          </h1>
          <p class="text-xs sm:text-sm text-neutral-600 mt-1 max-w-2xl leading-relaxed">
            Flipkart deducts <strong>category referral commissions (4%&ndash;16%)</strong>, <strong>price-slab fixed fees (₹13&ndash;₹52)</strong>, a <strong>2% payment collection fee</strong> on order value, plus courier charges.
          </p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 shrink-0 text-xs font-mono">
          <div class="bg-white border border-blue-200 rounded-xl p-2.5 text-center">
            <div class="text-[10px] text-neutral-500 uppercase font-sans">Commission</div>
            <div class="font-bold text-blue-700 text-sm mt-0.5">4% &ndash; 16%</div>
          </div>
          <div class="bg-white border border-blue-200 rounded-xl p-2.5 text-center">
            <div class="text-[10px] text-neutral-500 uppercase font-sans">Fixed Fee</div>
            <div class="font-bold text-neutral-900 text-sm mt-0.5">₹13 &ndash; ₹52</div>
          </div>
          <div class="bg-white border border-blue-200 rounded-xl p-2.5 text-center col-span-2 sm:col-span-1">
            <div class="text-[10px] text-neutral-500 uppercase font-sans">Collection Fee</div>
            <div class="font-bold text-neutral-900 text-sm mt-0.5">2.0%</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Calculator Preloaded with Flipkart -->
  <Calculator
    initialMarketplace="flipkart"
    title="Calculate Flipkart Payout & In-Hand Profit"
    subtitle="Model exact fixed closing fees, 2% collection fee, category referral commission, and return buffers."
  />

  <!-- Side-by-Side Comparison -->
  <ComparisonMatrix />

  <!-- Reverse Target Price Solver -->
  <ReversePriceSolver />

  <!-- Fee Guide -->
  <FeeGuide />

  <!-- FAQ -->
  <FaqSection
    title="Flipkart Seller Fee & Profit Calculator Frequently Asked Questions"
    subtitle="Understand Flipkart fixed fee slabs, 2% collection charges, tier-based shipping, and return deductions."
    faqs={flipkartFaqs}
  />
</Layout>