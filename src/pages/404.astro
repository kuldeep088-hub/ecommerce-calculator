---
// src/pages/404.astro
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found (404) | Seller Profit Calculator"
  description="The page you are looking for does not exist or may have been moved. Explore our 21 free Indian e-commerce seller calculators."
  canonicalPath="/404"
  isNoIndex={true}
>
  <main class="min-h-[75vh] flex items-center justify-center bg-white px-4 py-16 sm:py-24">
    <div class="max-w-xl w-full text-center">
      
      <!-- Monospace Error Badge -->
      <div class="inline-flex items-center gap-1.5 mb-4">
        <span class="text-xs font-mono font-bold px-3 py-1 rounded-full bg-rose-50 text-rose-800 border border-rose-200">
          404 &bull; Page Not Found
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-neutral-900">
        Lost in the Marketplace?
      </h1>
      
      <p class="mt-3 text-sm sm:text-base text-neutral-500 max-w-md mx-auto leading-relaxed">
        The link you followed may be broken, or the page has been moved. Use the quick links below to calculate your seller margins.
      </p>

      <!-- Primary Action Buttons -->
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href="/"
          class="w-full sm:w-auto px-5 py-2.5 rounded-xl bg-neutral-900 text-white font-medium text-xs sm:text-sm hover:bg-neutral-800 transition shadow-2xs"
        >
          &larr; Back to Home Calculator
        </a>
        <a
          href="/#comparison"
          class="w-full sm:w-auto px-5 py-2.5 rounded-xl bg-white border border-neutral-200 text-neutral-800 font-medium text-xs sm:text-sm hover:bg-neutral-50 hover:border-neutral-900 transition"
        >
          Compare Marketplaces &rarr;
        </a>
      </div>

      <!-- Quick Platform Shortcuts -->
      <div class="mt-12 pt-8 border-t border-neutral-100">
        <span class="text-xs font-semibold text-neutral-400 uppercase tracking-wider block mb-3">
          Popular Seller Calculators
        </span>
        <div class="flex flex-wrap items-center justify-center gap-2 text-xs">
          <a
            href="/meesho-profit-calculator/"
            class="px-3 py-1.5 rounded-lg bg-neutral-50 border border-neutral-200 text-neutral-700 hover:text-neutral-900 hover:border-neutral-900 transition"
          >
            Meesho (0%)
          </a>
          <a
            href="/flipkart-profit-calculator/"
            class="px-3 py-1.5 rounded-lg bg-neutral-50 border border-neutral-200 text-neutral-700 hover:text-neutral-900 hover:border-neutral-900 transition"
          >
            Flipkart (2026)
          </a>
          <a
            href="/amazon-profit-calculator/"
            class="px-3 py-1.5 rounded-lg bg-neutral-50 border border-neutral-200 text-neutral-700 hover:text-neutral-900 hover:border-neutral-900 transition"
          >
            Amazon Easy Ship
          </a>
          <a
            href="/gst-calculator/"
            class="px-3 py-1.5 rounded-lg bg-neutral-50 border border-neutral-200 text-neutral-700 hover:text-neutral-900 hover:border-neutral-900 transition"
          >
            GST &amp; ITC
          </a>
          <a
            href="/profit-margin-calculator/"
            class="px-3 py-1.5 rounded-lg bg-neutral-50 border border-neutral-200 text-neutral-700 hover:text-neutral-900 hover:border-neutral-900 transition"
          >
            Profit Margin %
          </a>
          <a
            href="/roas-calculator/"
            class="px-3 py-1.5 rounded-lg bg-neutral-50 border border-neutral-200 text-neutral-700 hover:text-neutral-900 hover:border-neutral-900 transition"
          >
            ROAS Multiplier
          </a>
        </div>
      </div>

      <!-- Contact Help Text -->
      <p class="mt-8 text-xs text-neutral-400">
        Think this is a broken link? <a href="/contact-us/" class="underline hover:text-neutral-600 transition">Let us know</a>.
      </p>

    </div>
  </main>
</Layout>
