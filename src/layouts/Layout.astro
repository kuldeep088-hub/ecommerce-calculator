---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getHreflangList } from '../i18n/utils';
import type { SupportedLanguage } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  lang?: SupportedLanguage;
}

const {
  lang = 'en',
  title = "Seller Profit Calculator | Free Meesho, Flipkart & Amazon Profit & Fee Calculator",
  description = "Calculate exact net in-hand profit, marketplace commissions, courier shipping charges, GST deductions, and expected RTO / customer return losses for Meesho, Flipkart & Amazon sellers. 100% free, updated for 2026."
} = Astro.props;

const domain = "https://freesellerprofitcalculator.com";
const canonicalUrl = lang === 'en' ? `${domain}/` : `${domain}/${lang}/`;
const hreflangs = getHreflangList(domain);
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- HREFLANG MARKUP FOR MULTI-LANGUAGE SEO -->
    {hreflangs.map((item) => (
      <link rel="alternate" hreflang={item.lang} href={item.url} />
    ))}

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Seller Profit Calculator" />
    <meta property="og:locale" content={lang} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Google Fonts: Geist Sans & Geist Mono (Vercel Typography) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600;700&family=Geist:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon SVG -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%23171717'/><text x='50' y='68' font-size='56' font-family='sans-serif' font-weight='bold' fill='white' text-anchor='middle'>₹</text></svg>" />

    <!-- WebApplication JSON-LD Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Seller Profit Calculator",
      "url": canonicalUrl,
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Any",
      "inLanguage": lang,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      },
      "description": description
    })} />
  </head>
  <body class="min-h-screen flex flex-col bg-[#fafafa] text-[#171717] antialiased selection:bg-neutral-900 selection:text-white">
    <Header lang={lang} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
