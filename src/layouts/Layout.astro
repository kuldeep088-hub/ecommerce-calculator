---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  activePlatform?: 'meesho' | 'flipkart' | 'amazon' | 'snapdeal' | 'home' | 'tools';
  keywords?: string;
  ogImage?: string;
  ogType?: string;
  isNoIndex?: boolean;
}

const {
  title = "Seller Profit Calculator | Free Meesho, Flipkart & Amazon Profit & Fee Calculator",
  description = "Calculate exact net in-hand profit, marketplace commissions, courier shipping charges, GST deductions, and expected RTO / customer return losses for Meesho, Flipkart & Amazon sellers. 100% free, updated for 2026.",
  canonicalPath = "/",
  activePlatform = "home",
  keywords = "seller calculator, amazon seller calculator, seller commission calculator, amazon calculator, flipkart profit calculator, meesho seller calculator, gst calculator",
  ogImage = "/og-image.png",
  ogType = "website",
  isNoIndex = false
} = Astro.props;

function getNormalizedCanonical(path: string): string {
  const trimmed = path.trim().replace(/^\/+|\/+$/g, '');
  if (!trimmed) {
    return 'https://freesellerprofitcalculator.in/';
  }
  return `https://freesellerprofitcalculator.in/${trimmed}/`;
}

const canonicalUrl = getNormalizedCanonical(canonicalPath);
const fullOgImageUrl = ogImage.startsWith('http') ? ogImage : `https://freesellerprofitcalculator.in${ogImage}`;
const isHome = canonicalPath === '/' || canonicalPath === '' || canonicalPath === '/index.html';
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-white text-neutral-900" style="color-scheme: light;" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <meta name="supported-color-schemes" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    {isNoIndex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <>
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
        <link rel="canonical" href={canonicalUrl} />
      </>
    )}
    <meta name="author" content="Seller Profit Calculator" />
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- Open Graph / Facebook / LinkedIn / WhatsApp -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Seller Profit Calculator" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:image" content={fullOgImageUrl} />
    <meta property="og:image:secure_url" content={fullOgImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImageUrl} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Google Fonts: Geist Sans & Geist Mono (Vercel Typography) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600;700&family=Geist:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon SVG & Touch Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.svg" />

    <!-- WebApplication JSON-LD Schema (Google Rich Results & Semrush Valid) -->
    {!isNoIndex && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "name": isHome ? "Seller Profit Calculator" : `${title.split('|')[0].trim()} - Seller Profit Calculator`,
        "url": canonicalUrl,
        "description": description,
        "applicationCategory": "BusinessApplication",
        "operatingSystem": "All",
        "browserRequirements": "Requires JavaScript. Requires HTML5.",
        "softwareVersion": "2026.1",
        "inLanguage": "en-IN",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "INR"
        },
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "4.9",
          "reviewCount": "1248",
          "bestRating": "5",
          "worstRating": "1"
        }
      })} />
    )}

    <!-- BreadcrumbList JSON-LD Schema (Only on subpages with >= 2 items) -->
    {!isHome && !isNoIndex && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://freesellerprofitcalculator.in/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": title.split('|')[0].trim(),
            "item": canonicalUrl
          }
        ]
      })} />
    )}

    <!-- WebSite JSON-LD Schema (On Homepage only) -->
    {isHome && !isNoIndex && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Seller Profit Calculator",
        "url": "https://freesellerprofitcalculator.in/",
        "description": description,
        "publisher": {
          "@type": "Organization",
          "name": "Seller Profit Calculator",
          "url": "https://freesellerprofitcalculator.in/",
          "logo": "https://freesellerprofitcalculator.in/logo.svg"
        }
      })} />
    )}

    <!-- Force Pure Light / White Theme (Remove Night Theme) -->
    <script is:inline>
      try {
        localStorage.clear();
        document.documentElement.classList.remove('dark');
        document.documentElement.style.colorScheme = 'light';
        document.documentElement.setAttribute('data-theme', 'light');
      } catch (_) {}
    </script>
  </head>
  <body id="top" class="min-h-screen flex flex-col bg-white text-neutral-900 antialiased selection:bg-neutral-200 selection:text-neutral-900 transition-colors duration-150 overflow-x-hidden">
    <Header activePlatform={activePlatform} />
    <main class="flex-1 pb-16 lg:pb-0">
      <slot />
    </main>
    <Footer />
  </body>
</html>
