---
// src/components/ComparisonMatrix.astro
---

<section id="comparison" class="py-12 sm:py-16 bg-transparent border-t border-neutral-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <div class="mb-4 sm:mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
      <div>
        <h2 class="text-xl sm:text-2xl font-semibold tracking-tight text-neutral-900">
          Side-by-Side Platform Comparison
        </h2>
        <p class="text-xs sm:text-sm text-neutral-500 mt-1">
          Direct profit comparison for your exact product price and cost across platforms.
        </p>
      </div>
      <div class="sm:hidden inline-flex items-center gap-1.5 text-[11px] font-mono text-neutral-400 bg-neutral-100 px-2.5 py-1 rounded-md self-start">
        <span>&larr; Swipe to compare &rarr;</span>
      </div>
    </div>

    <!-- Comparison Table Card -->
    <div class="bg-white border border-neutral-200 rounded-2xl overflow-hidden shadow-xs">
      
      <div class="overflow-x-auto touch-scroll no-scrollbar">
        <table class="w-full min-w-[560px] text-left text-xs sm:text-sm">
          
          <!-- Head -->
          <thead>
            <tr class="border-b border-neutral-200 bg-neutral-50 font-semibold text-neutral-700">
              <th class="p-4 w-1/4 sticky left-0 bg-neutral-50 z-10">Metric / Fee Breakdown</th>
              
              <!-- Meesho -->
              <th class="p-4 w-1/4 border-l border-neutral-200">
                <div class="flex items-center justify-between">
                  <span class="font-bold text-neutral-900">Meesho</span>
                  <span id="badgeWinnerMeesho" class="hidden text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 font-bold">
                    WINNER
                  </span>
                </div>
              </th>

              <!-- Flipkart -->
              <th class="p-4 w-1/4 border-l border-neutral-200">
                <div class="flex items-center justify-between">
                  <span class="font-bold text-neutral-900">Flipkart</span>
                  <span id="badgeWinnerFlipkart" class="hidden text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 font-bold">
                    WINNER
                  </span>
                </div>
              </th>

              <!-- Amazon -->
              <th class="p-4 w-1/4 border-l border-neutral-200">
                <div class="flex items-center justify-between">
                  <span class="font-bold text-neutral-900">Amazon India</span>
                  <span id="badgeWinnerAmazon" class="hidden text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 font-bold">
                    WINNER
                  </span>
                </div>
              </th>

            </tr>
          </thead>

          <!-- Body -->
          <tbody class="divide-y divide-neutral-100 font-mono">
            
            <tr class="hover:bg-neutral-50/50">
              <td class="p-4 font-sans text-neutral-600 font-medium sticky left-0 bg-white z-10">Referral Commission</td>
              <td class="p-4 border-l border-neutral-100 text-emerald-700 font-semibold" id="cmpCommMeesho">0% (₹0.00)</td>
              <td class="p-4 border-l border-neutral-100 text-neutral-800" id="cmpCommFlipkart">15.0% (₹80.22)</td>
              <td class="p-4 border-l border-neutral-100 text-neutral-800" id="cmpCommAmazon">13.5% (₹72.20)</td>
            </tr>

            <tr class="hover:bg-neutral-50/50">
              <td class="p-4 font-sans text-neutral-600 sticky left-0 bg-white z-10">Closing / Fixed Fee</td>
              <td class="p-4 border-l border-neutral-100 text-neutral-700" id="cmpFixedMeesho">₹0.00</td>
              <td class="p-4 border-l border-neutral-100 text-neutral-700" id="cmpFixedFlipkart">₹30.00</td>
              <td class="p-4 border-l border-neutral-100 text-neutral-700" id="cmpFixedAmazon">₹25.00</td>
            </tr>

            <tr class="hover:bg-neutral-50/50">
              <td class="p-4 font-sans text-neutral-600 sticky left-0 bg-white z-10">Payment Collection Fee (2%)</td>
              <td class="p-4 border-l border-neutral-100 text-neutral-700" id="cmpCollectMeesho">₹0.00</td>
              <td class="p-4 border-l border-neutral-100 text-neutral-700" id="cmpCollectFlipkart">₹11.98</td>
              <td class="p-4 border-l border-neutral-100 text-neutral-700" id="cmpCollectAmazon">₹11.98</td>
            </tr>

            <tr class="hover:bg-neutral-50/50">
              <td class="p-4 font-sans text-neutral-600 sticky left-0 bg-white z-10">Forward Shipping Fee</td>
              <td class="p-4 border-l border-neutral-100 text-neutral-700" id="cmpShipMeesho">₹49.00</td>
              <td class="p-4 border-l border-neutral-100 text-neutral-700" id="cmpShipFlipkart">₹69.00</td>
              <td class="p-4 border-l border-neutral-100 text-neutral-700" id="cmpShipAmazon">₹74.00</td>
            </tr>

            <tr class="hover:bg-neutral-50/50">
              <td class="p-4 font-sans text-neutral-600 sticky left-0 bg-white z-10">GST on Marketplace Fees (18%)</td>
              <td class="p-4 border-l border-neutral-100 text-rose-600" id="cmpGstMeesho">₹8.82</td>
              <td class="p-4 border-l border-neutral-100 text-rose-600" id="cmpGstFlipkart">₹34.42</td>
              <td class="p-4 border-l border-neutral-100 text-rose-600" id="cmpGstAmazon">₹32.97</td>
            </tr>

            <tr class="bg-neutral-50 font-semibold">
              <td class="p-4 font-sans text-neutral-900 sticky left-0 bg-neutral-50 z-10">Total Deductions</td>
              <td class="p-4 border-l border-neutral-200 text-neutral-900" id="cmpTotalDeductMeesho">₹63.70</td>
              <td class="p-4 border-l border-neutral-200 text-neutral-900" id="cmpTotalDeductFlipkart">₹231.50</td>
              <td class="p-4 border-l border-neutral-200 text-neutral-900" id="cmpTotalDeductAmazon">₹222.03</td>
            </tr>

            <tr class="bg-blue-50/40">
              <td class="p-4 font-sans text-blue-900 font-semibold sticky left-0 bg-[#f4f7fe] z-10">Bank Settlement Payout</td>
              <td class="p-4 border-l border-neutral-100 font-bold text-blue-700" id="cmpBankMeesho">₹535.30</td>
              <td class="p-4 border-l border-neutral-100 font-bold text-blue-700" id="cmpBankFlipkart">₹367.50</td>
              <td class="p-4 border-l border-neutral-100 font-bold text-blue-700" id="cmpBankAmazon">₹376.97</td>
            </tr>

            <tr class="hover:bg-neutral-50/50">
              <td class="p-4 font-sans text-neutral-600 sticky left-0 bg-white z-10">Expected Return Loss Buffer</td>
              <td class="p-4 border-l border-neutral-100 text-amber-700" id="cmpReturnMeesho">- ₹39.80</td>
              <td class="p-4 border-l border-neutral-100 text-amber-700" id="cmpReturnFlipkart">- ₹52.40</td>
              <td class="p-4 border-l border-neutral-100 text-amber-700" id="cmpReturnAmazon">- ₹54.20</td>
            </tr>

            <!-- Final Profit Row (Clean Light Theme) -->
            <tr class="bg-emerald-50 text-emerald-950 font-bold text-sm sm:text-base border-t-2 border-emerald-500">
              <td class="p-4 sm:p-5 font-sans sticky left-0 bg-emerald-50 z-10">
                <div class="text-neutral-900 font-bold">True In-Hand Net Profit</div>
                <span class="block text-[11px] font-normal text-neutral-600 font-sans">After COGS &amp; Return loss</span>
              </td>
              <td class="p-4 sm:p-5 border-l border-emerald-200 text-emerald-700 font-extrabold" id="cmpProfitMeesho">₹260.50</td>
              <td class="p-4 sm:p-5 border-l border-emerald-200 text-emerald-700 font-extrabold" id="cmpProfitFlipkart">₹80.10</td>
              <td class="p-4 sm:p-5 border-l border-emerald-200 text-emerald-700 font-extrabold" id="cmpProfitAmazon">₹87.77</td>
            </tr>

            <!-- Net Margin % Row (Clean Light Theme) -->
            <tr class="bg-emerald-100/50 text-emerald-900 text-xs sm:text-sm border-t border-emerald-200">
              <td class="p-3.5 sm:p-4 font-sans text-neutral-700 font-medium sticky left-0 bg-emerald-100/50 z-10">Net Profit Margin %</td>
              <td class="p-3.5 sm:p-4 border-l border-emerald-200 font-bold text-emerald-800" id="cmpMarginMeesho">43.5%</td>
              <td class="p-3.5 sm:p-4 border-l border-emerald-200 font-bold text-emerald-800" id="cmpMarginFlipkart">13.4%</td>
              <td class="p-3.5 sm:p-4 border-l border-emerald-200 font-bold text-emerald-800" id="cmpMarginAmazon">14.7%</td>
            </tr>

          </tbody>
        </table>
      </div>
    </div>

  </div>
</section>

<!-- CLIENT SCRIPT TO AUTO-UPDATE MATRIX -->
<script is:inline>
(function() {
  function formatCurr(val) {
    return '₹' + (val || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function getAmzClose(price) {
    if (price <= 250) return 5;
    if (price <= 500) return 10;
    if (price <= 1000) return 25;
    if (price <= 2000) return 35;
    return 50;
  }

  function getFkFixed(price) {
    if (price <= 300) return 13;
    if (price <= 500) return 17;
    if (price <= 1000) return 30;
    return 52;
  }

  function getShip(mp, weightGrams, zone) {
    if (mp === 'meesho') {
      if (weightGrams <= 500) return 49;
      if (weightGrams <= 1000) return 85;
      if (weightGrams <= 1500) return 125;
      return 125 + Math.ceil((weightGrams - 1500) / 500) * 40;
    }
    if (mp === 'amazon') {
      var base = zone === 'local' ? 44 : zone === 'regional' ? 53 : 74;
      var addl = zone === 'local' ? 25 : zone === 'regional' ? 30 : 36;
      if (weightGrams <= 500) return base;
      return base + Math.ceil((weightGrams - 500) / 500) * addl;
    }
    if (mp === 'flipkart') {
      var base = zone === 'local' ? 44 : zone === 'regional' ? 54 : 69;
      var addl = zone === 'local' ? 22 : zone === 'regional' ? 26 : 32;
      if (weightGrams <= 500) return base;
      return base + Math.ceil((weightGrams - 500) / 500) * addl;
    }
    return 55;
  }

  var CATEGORY_RATES = {
    fashion: { meesho: 0, flipkart: 15.0, amazon: 13.5 },
    footwear: { meesho: 0, flipkart: 14.0, amazon: 12.0 },
    electronics_accessories: { meesho: 0, flipkart: 12.5, amazon: 14.0 },
    home_kitchen: { meesho: 0, flipkart: 11.0, amazon: 10.5 },
    beauty_grooming: { meesho: 0, flipkart: 9.0, amazon: 8.5 },
    jewellery_fashion: { meesho: 0, flipkart: 16.0, amazon: 15.0 },
    grocery_fmcg: { meesho: 0, flipkart: 6.5, amazon: 6.0 },
    toys_baby: { meesho: 0, flipkart: 10.5, amazon: 9.5 },
    books: { meesho: 0, flipkart: 9.0, amazon: 8.0 },
    custom: { meesho: 0, flipkart: 10.0, amazon: 10.0 }
  };

  window.updateComparisonMatrix = function(data) {
    var sp = data.sellingPrice || 0;
    var cogs = data.costOfGoods || 0;
    var cat = data.category || 'fashion';
    var gst = data.productGstRate || 12;
    var weight = data.weightGrams || 500;
    var zone = data.shippingZone || 'national';
    var pkg = data.packagingCost || 15;
    var ads = data.adSpend || 0;
    var rtoRate = data.rtoRate || 15;
    var retRate = data.customerReturnRate || 8;
    var retCost = data.customerReturnReverseCost || 130;

    var taxable = sp > 0 ? sp / (1 + gst / 100) : 0;
    var rates = CATEGORY_RATES[cat] || CATEGORY_RATES['fashion'];

    var platforms = ['meesho', 'flipkart', 'amazon'];
    var profits = {};

    platforms.forEach(function(p) {
      var commRate = rates[p] || 0;
      var comm = taxable * (commRate / 100);
      var fixed = p === 'amazon' ? getAmzClose(sp) : p === 'flipkart' ? getFkFixed(sp) : 0;
      var coll = (p === 'flipkart' || p === 'amazon') ? (sp * 0.02) : 0;
      var ship = getShip(p, weight, zone);
      var feesExGst = comm + fixed + coll + ship;
      var gstOnFees = feesExGst * 0.18;
      var tcsTds = taxable * 0.011;
      var totalDeduct = feesExGst + gstOnFees + tcsTds;
      var bank = Math.max(0, sp - totalDeduct);

      var deliveredProfit = taxable - cogs - feesExGst - pkg - ads;
      var rtoCourierLoss = p === 'meesho' ? 0 : ship;
      var rtoLoss = rtoCourierLoss + pkg + 10;
      var custRetLoss = retCost + pkg + 15 + cogs * 0.05;

      var delivRate = Math.max(0, 100 - rtoRate - retRate) / 100;
      var rtoFrac = rtoRate / 100;
      var retFrac = retRate / 100;

      var retBuffer = (rtoLoss * rtoFrac) + (custRetLoss * retFrac);
      var blendedProfit = (deliveredProfit * delivRate) - retBuffer;
      var margin = sp > 0 ? (blendedProfit / sp) * 100 : 0;

      profits[p] = blendedProfit;

      var pCap = p.charAt(0).toUpperCase() + p.slice(1);
      if (p === 'amazon') pCap = 'Amazon';

      var elComm = document.getElementById('cmpComm' + pCap);
      if (elComm) elComm.textContent = commRate + '% (' + formatCurr(comm) + ')';

      var elFixed = document.getElementById('cmpFixed' + pCap);
      if (elFixed) elFixed.textContent = formatCurr(fixed);

      var elColl = document.getElementById('cmpCollect' + pCap);
      if (elColl) elColl.textContent = formatCurr(coll);

      var elShip = document.getElementById('cmpShip' + pCap);
      if (elShip) elShip.textContent = formatCurr(ship);

      var elGst = document.getElementById('cmpGst' + pCap);
      if (elGst) elGst.textContent = formatCurr(gstOnFees);

      var elTot = document.getElementById('cmpTotalDeduct' + pCap);
      if (elTot) elTot.textContent = formatCurr(totalDeduct);

      var elBank = document.getElementById('cmpBank' + pCap);
      if (elBank) elBank.textContent = formatCurr(bank);

      var elRet = document.getElementById('cmpReturn' + pCap);
      if (elRet) elRet.textContent = '- ' + formatCurr(retBuffer);

      var elProf = document.getElementById('cmpProfit' + pCap);
      if (elProf) {
        elProf.textContent = formatCurr(blendedProfit);
        elProf.className = blendedProfit >= 0 ? 'p-4 sm:p-5 border-l border-neutral-800 text-emerald-400 font-bold' : 'p-4 sm:p-5 border-l border-neutral-800 text-rose-400 font-bold';
      }

      var elMarg = document.getElementById('cmpMargin' + pCap);
      if (elMarg) elMarg.textContent = margin.toFixed(1) + '%';
    });

    // Winner badge
    var winner = 'meesho';
    if (profits.flipkart > profits[winner]) winner = 'flipkart';
    if (profits.amazon > profits[winner]) winner = 'amazon';

    var bMeesho = document.getElementById('badgeWinnerMeesho');
    var bFlipkart = document.getElementById('badgeWinnerFlipkart');
    var bAmazon = document.getElementById('badgeWinnerAmazon');

    if (bMeesho) bMeesho.classList.toggle('hidden', winner !== 'meesho');
    if (bFlipkart) bFlipkart.classList.toggle('hidden', winner !== 'flipkart');
    if (bAmazon) bAmazon.classList.toggle('hidden', winner !== 'amazon');
  };
})();
</script>
