---
// src/components/ComparisonMatrix.astro
import { useTranslations } from '../i18n/utils';
import type { SupportedLanguage } from '../i18n/ui';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<section id="comparison" class="py-12 sm:py-16 bg-transparent border-t border-black/[0.05] dark:border-white/[0.06]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-7 gap-4">
      <div>
        <div class="inline-flex items-center gap-1.5 text-xs font-mono text-neutral-500 dark:text-neutral-400 uppercase tracking-wider mb-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
          {t("cmp.badge")}
        </div>
        <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-neutral-900 dark:text-white">
          {t("cmp.title")}
        </h2>
        <p class="text-xs sm:text-sm text-neutral-500 dark:text-neutral-400 mt-1">
          {t("cmp.sub")}
        </p>
      </div>

      <div class="flex items-center gap-2">
        <span class="text-xs font-mono text-neutral-400 dark:text-neutral-500">Auto-synced with calculator</span>
      </div>
    </div>

    <!-- Comparison Table Card -->
    <div class="card-ver bg-white dark:bg-[#0b0b0b] border border-black/[0.06] dark:border-white/[0.08] rounded-2xl overflow-hidden">
      
      <!-- Mobile Swipe Helper Indicator -->
      <div class="sm:hidden px-4 py-2 bg-neutral-50/70 dark:bg-neutral-900/60 border-b border-black/[0.04] dark:border-white/[0.06] flex items-center justify-between text-[11px] text-neutral-500 dark:text-neutral-400 font-mono">
        <span class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-blue-500 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path></svg>
          Swipe sideways to compare all platforms
        </span>
        <span>Scroll &rarr;</span>
      </div>

      <div class="overflow-x-auto touch-scroll no-scrollbar">
        <table class="w-full min-w-[580px] text-left text-xs sm:text-sm">
          
          <!-- Head -->
          <thead>
            <tr class="border-b border-black/[0.06] dark:border-white/[0.08] bg-neutral-50/70 dark:bg-neutral-900/40 font-semibold text-neutral-700 dark:text-neutral-300">
              <th class="p-4 sm:p-5 w-1/4 sticky left-0 bg-neutral-50 dark:bg-neutral-900 z-10 shadow-[2px_0_5px_-2px_rgba(0,0,0,0.06)]">Metric / Fee Breakdown</th>
              
              <!-- Meesho -->
              <th class="p-4 sm:p-5 w-1/4 border-l border-black/[0.05] dark:border-white/[0.06]">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-pink-500"></span>
                    <span class="font-bold text-neutral-900 dark:text-white">Meesho</span>
                  </div>
                  <span id="badgeWinnerMeesho" class="hidden text-[10px] font-mono px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border border-emerald-500/20 font-bold">
                    HIGHEST PROFIT
                  </span>
                </div>
              </th>

              <!-- Flipkart -->
              <th class="p-4 sm:p-5 w-1/4 border-l border-black/[0.05] dark:border-white/[0.06]">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span>
                    <span class="font-bold text-neutral-900 dark:text-white">Flipkart</span>
                  </div>
                  <span id="badgeWinnerFlipkart" class="hidden text-[10px] font-mono px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border border-emerald-500/20 font-bold">
                    HIGHEST PROFIT
                  </span>
                </div>
              </th>

              <!-- Amazon -->
              <th class="p-4 sm:p-5 w-1/4 border-l border-black/[0.05] dark:border-white/[0.06]">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
                    <span class="font-bold text-neutral-900 dark:text-white">Amazon India</span>
                  </div>
                  <span id="badgeWinnerAmazon" class="hidden text-[10px] font-mono px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border border-emerald-500/20 font-bold">
                    HIGHEST PROFIT
                  </span>
                </div>
              </th>

            </tr>
          </thead>

          <!-- Body -->
          <tbody class="divide-y divide-black/[0.04] dark:divide-white/[0.04] font-mono">
            
            <tr class="hover:bg-black/[0.015] dark:hover:bg-white/[0.02]">
              <td class="p-4 font-sans text-neutral-600 dark:text-neutral-400 font-medium sticky left-0 bg-white dark:bg-[#0b0b0b] z-10 shadow-[2px_0_5px_-2px_rgba(0,0,0,0.06)]">Referral Commission</td>
              <td class="p-4 border-l border-black/[0.04] dark:border-white/[0.05] text-emerald-700 dark:text-emerald-400 font-semibold" id="cmpCommMeesho">0% (₹0.00)</td>
              <td class="p-4 border-l border-black/[0.04] dark:border-white/[0.05] text-neutral-800 dark:text-neutral-200" id="cmpCommFlipkart">15.0% (₹80.22)</td>
              <td class="p-4 border-l border-black/[0.04] dark:border-white/[0.05] text-neutral-800 dark:text-neutral-200" id="cmpCommAmazon">13.5% (₹72.20)</td>
            </tr>

            <tr class="hover:bg-black/[0.015] dark:hover:bg-white/[0.02]">
              <td class="p-4 font-sans text-neutral-600 dark:text-neutral-400 sticky left-0 bg-white dark:bg-[#0b0b0b] z-10 shadow-[2px_0_5px_-2px_rgba(0,0,0,0.06)]">Closing / Fixed Fee</td>
              <td class="p-4 border-l border-black/[0.04] dark:border-white/[0.05] text-neutral-700 dark:text-neutral-300" id="cmpFixedMeesho">₹0.00</td>
              <td class="p-4 border-l border-black/[0.04] dark:border-white/[0.05] text-neutral-700 dark:text-neutral-300" id="cmpFixedFlipkart">₹30.00</td>
              <td class="p-4 border-l border-black/[0.04] dark:border-white/[0.05] text-neutral-700 dark:text-neutral-300" id="cmpFixedAmazon">₹25.00</td>
            </tr>

            <tr class="hover:bg-black/[0.015] dark:hover:bg-white/[0.02]">
              <td class="p-4 font-sans text-neutral-600 dark:text-neutral-400 sticky left-0 bg-white dark:bg-[#0b0b0b] z-10 shadow-[2px_0_5px_-2px_rgba(0,0,0,0.06)]">Payment Collection Fee (2%)</td>
              <td class="p-4 border-l border-black/[0.04] dark:border-white/[0.05] text-neutral-700 dark:text-neutral-300" id="cmpCollectMeesho">₹0.00</td>
              <td class="p-4 border-l border-black/[0.04] dark:border-white/[0.05] text-neutral-700 dark:text-neutral-300" id="cmpCollectFlipkart">₹11.98</td>
              <td class="p-4 border-l border-black/[0.04] dark:border-white/[0.05] text-neutral-700 dark:text-neutral-300" id="cmpCollectAmazon">₹11.98</td>
            </tr>

            <tr class="hover:bg-black/[0.015] dark:hover:bg-white/[0.02]">
              <td class="p-4 font-sans text-neutral-600 dark:text-neutral-400 sticky left-0 bg-white dark:bg-[#0b0b0b] z-10 shadow-[2px_0_5px_-2px_rgba(0,0,0,0.06)]">Forward Shipping Fee</td>
              <td class="p-4 border-l border-black/[0.04] dark:border-white/[0.05] text-neutral-700 dark:text-neutral-300" id="cmpShipMeesho">₹49.00</td>
              <td class="p-4 border-l border-black/[0.04] dark:border-white/[0.05] text-neutral-700 dark:text-neutral-300" id="cmpShipFlipkart">₹69.00</td>
              <td class="p-4 border-l border-black/[0.04] dark:border-white/[0.05] text-neutral-700 dark:text-neutral-300" id="cmpShipAmazon">₹74.00</td>
            </tr>

            <tr class="hover:bg-black/[0.015] dark:hover:bg-white/[0.02]">
              <td class="p-4 font-sans text-neutral-600 dark:text-neutral-400 sticky left-0 bg-white dark:bg-[#0b0b0b] z-10 shadow-[2px_0_5px_-2px_rgba(0,0,0,0.06)]">GST on Marketplace Fees (18%)</td>
              <td class="p-4 border-l border-black/[0.04] dark:border-white/[0.05] text-rose-600 dark:text-rose-400" id="cmpGstMeesho">₹8.82</td>
              <td class="p-4 border-l border-black/[0.04] dark:border-white/[0.05] text-rose-600 dark:text-rose-400" id="cmpGstFlipkart">₹34.42</td>
              <td class="p-4 border-l border-black/[0.04] dark:border-white/[0.05] text-rose-600 dark:text-rose-400" id="cmpGstAmazon">₹32.97</td>
            </tr>

            <tr class="bg-neutral-50/70 dark:bg-neutral-900/60 font-semibold">
              <td class="p-4 font-sans text-neutral-900 dark:text-white sticky left-0 bg-neutral-50 dark:bg-neutral-900 z-10 shadow-[2px_0_5px_-2px_rgba(0,0,0,0.06)]">Total Deductions</td>
              <td class="p-4 border-l border-black/[0.05] dark:border-white/[0.06] text-neutral-900 dark:text-white" id="cmpTotalDeductMeesho">₹63.70</td>
              <td class="p-4 border-l border-black/[0.05] dark:border-white/[0.06] text-neutral-900 dark:text-white" id="cmpTotalDeductFlipkart">₹231.50</td>
              <td class="p-4 border-l border-black/[0.05] dark:border-white/[0.06] text-neutral-900 dark:text-white" id="cmpTotalDeductAmazon">₹222.03</td>
            </tr>

            <tr class="bg-blue-50/30 dark:bg-blue-950/20">
              <td class="p-4 font-sans text-blue-900 dark:text-blue-300 font-semibold sticky left-0 bg-[#f4f7fe] dark:bg-[#0c1324] z-10 shadow-[2px_0_5px_-2px_rgba(0,0,0,0.06)]">Bank Settlement Payout</td>
              <td class="p-4 border-l border-black/[0.04] dark:border-white/[0.05] font-bold text-blue-700 dark:text-blue-400" id="cmpBankMeesho">₹535.30</td>
              <td class="p-4 border-l border-black/[0.04] dark:border-white/[0.05] font-bold text-blue-700 dark:text-blue-400" id="cmpBankFlipkart">₹367.50</td>
              <td class="p-4 border-l border-black/[0.04] dark:border-white/[0.05] font-bold text-blue-700 dark:text-blue-400" id="cmpBankAmazon">₹376.97</td>
            </tr>

            <tr class="hover:bg-black/[0.015] dark:hover:bg-white/[0.02]">
              <td class="p-4 font-sans text-neutral-600 dark:text-neutral-400 sticky left-0 bg-white dark:bg-[#0b0b0b] z-10 shadow-[2px_0_5px_-2px_rgba(0,0,0,0.06)]">Expected Return Loss Buffer</td>
              <td class="p-4 border-l border-black/[0.04] dark:border-white/[0.05] text-amber-700 dark:text-amber-400" id="cmpReturnMeesho">- ₹39.80</td>
              <td class="p-4 border-l border-black/[0.04] dark:border-white/[0.05] text-amber-700 dark:text-amber-400" id="cmpReturnFlipkart">- ₹52.40</td>
              <td class="p-4 border-l border-black/[0.04] dark:border-white/[0.05] text-amber-700 dark:text-amber-400" id="cmpReturnAmazon">- ₹54.20</td>
            </tr>

            <!-- Final Profit Row -->
            <tr class="bg-neutral-900 dark:bg-black text-white font-bold text-sm sm:text-base border-t border-black/10 dark:border-white/10">
              <td class="p-4 sm:p-5 font-sans sticky left-0 bg-neutral-900 dark:bg-black z-10 shadow-[2px_0_5px_-2px_rgba(0,0,0,0.2)]">
                True In-Hand Net Profit
                <span class="block text-[11px] font-normal text-neutral-400 font-sans">After COGS &amp; Return loss</span>
              </td>
              <td class="p-4 sm:p-5 border-l border-neutral-800 text-emerald-400" id="cmpProfitMeesho">₹260.50</td>
              <td class="p-4 sm:p-5 border-l border-neutral-800 text-emerald-400" id="cmpProfitFlipkart">₹80.10</td>
              <td class="p-4 sm:p-5 border-l border-neutral-800 text-emerald-400" id="cmpProfitAmazon">₹87.77</td>
            </tr>

            <!-- Net Margin % Row -->
            <tr class="bg-neutral-800 dark:bg-neutral-950 text-neutral-300 dark:text-neutral-400 text-xs sm:text-sm">
              <td class="p-3.5 sm:p-4 font-sans text-neutral-400 font-medium sticky left-0 bg-neutral-800 dark:bg-neutral-950 z-10 shadow-[2px_0_5px_-2px_rgba(0,0,0,0.2)]">Net Profit Margin %</td>
              <td class="p-3.5 sm:p-4 border-l border-neutral-700 dark:border-neutral-850 font-bold text-white" id="cmpMarginMeesho">43.5%</td>
              <td class="p-3.5 sm:p-4 border-l border-neutral-700 dark:border-neutral-850 font-bold text-white" id="cmpMarginFlipkart">13.4%</td>
              <td class="p-3.5 sm:p-4 border-l border-neutral-700 dark:border-neutral-850 font-bold text-white" id="cmpMarginAmazon">14.7%</td>
            </tr>

          </tbody>
        </table>
      </div>
    </div>

  </div>
</section>

<script is:inline>
(function() {
  function fmt(v) {
    return '₹' + (v || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function getAmazonClosing(sp) {
    if (sp <= 250) return 5;
    if (sp <= 500) return 10;
    if (sp <= 1000) return 25;
    if (sp <= 2000) return 35;
    return 50;
  }

  function getFlipkartFixed(sp) {
    if (sp <= 300) return 13;
    if (sp <= 500) return 17;
    if (sp <= 1000) return 30;
    return 52;
  }

  function getShip(mp, wt, zone) {
    if (mp === 'meesho') {
      if (wt <= 500) return 49;
      if (wt <= 1000) return 85;
      if (wt <= 1500) return 125;
      return 125 + Math.ceil((wt - 1500) / 500) * 40;
    }
    if (mp === 'amazon') {
      var base = zone === 'local' ? 44 : zone === 'regional' ? 53 : 74;
      var addl = zone === 'local' ? 25 : zone === 'regional' ? 30 : 36;
      if (wt <= 500) return base;
      return base + Math.ceil((wt - 500) / 500) * addl;
    }
    if (mp === 'flipkart') {
      var base = zone === 'local' ? 44 : zone === 'regional' ? 54 : 69;
      var addl = zone === 'local' ? 22 : zone === 'regional' ? 26 : 32;
      if (wt <= 500) return base;
      return base + Math.ceil((wt - 500) / 500) * addl;
    }
    return 55;
  }

  var CATS = {
    fashion: { meesho: 0, flipkart: 15.0, amazon: 13.5 },
    footwear: { meesho: 0, flipkart: 14.0, amazon: 12.0 },
    electronics_accessories: { meesho: 0, flipkart: 12.5, amazon: 14.0 },
    home_kitchen: { meesho: 0, flipkart: 11.0, amazon: 10.5 },
    beauty_grooming: { meesho: 0, flipkart: 9.0, amazon: 8.5 },
    jewellery_fashion: { meesho: 0, flipkart: 16.0, amazon: 15.0 },
    grocery_fmcg: { meesho: 0, flipkart: 6.5, amazon: 6.0 },
    toys_baby: { meesho: 0, flipkart: 10.5, amazon: 9.5 },
    books: { meesho: 0, flipkart: 9.0, amazon: 8.0 },
    custom: { meesho: 0, flipkart: 10.0, amazon: 10.0 }
  };

  window.updateComparisonMatrix = function(data) {
    var sp = data.sellingPrice || 0;
    var cogs = data.costOfGoods || 0;
    var pkg = data.packagingCost || 0;
    var ads = data.adSpend || 0;
    var wt = data.weightGrams || 500;
    var zone = data.shippingZone || 'national';
    var gstRate = data.productGstRate || 12;
    var rtoRate = data.rtoRate || 0;
    var retRate = data.customerReturnRate || 0;
    var revCost = data.customerReturnReverseCost || 130;

    var taxable = sp > 0 ? sp / (1 + gstRate / 100) : 0;
    var catInfo = CATS[data.category] || CATS['fashion'];

    var platforms = ['meesho', 'flipkart', 'amazon'];
    var results = {};

    platforms.forEach(function(p) {
      var commRate = catInfo[p] !== undefined ? catInfo[p] : 10;
      var commAmt = taxable * (commRate / 100);
      var fixed = p === 'amazon' ? getAmazonClosing(sp) : p === 'flipkart' ? getFlipkartFixed(sp) : 0;
      var collect = (p === 'flipkart' || p === 'amazon') ? (sp * 0.02) : 0;
      var ship = getShip(p, wt, zone);
      var feesExGst = commAmt + fixed + collect + ship;
      var gstOnFees = feesExGst * 0.18;
      var tcsTds = taxable * 0.011;
      var totalDeduct = feesExGst + gstOnFees + tcsTds;
      var bank = Math.max(0, sp - totalDeduct);
      var delivProfit = taxable - cogs - feesExGst - pkg - ads;

      var rtoLoss = (p === 'meesho' ? 0 : ship) + pkg + 10;
      var custRetLoss = revCost + pkg + 15 + cogs * 0.05;
      var delivRate = Math.max(0, 100 - rtoRate - retRate) / 100;
      var rtoFrac = rtoRate / 100;
      var retFrac = retRate / 100;

      var retBuffer = (rtoLoss * rtoFrac) + (custRetLoss * retFrac);
      var netProfit = (delivProfit * delivRate) - retBuffer;
      var margin = sp > 0 ? (netProfit / sp) * 100 : 0;

      results[p] = {
        commRate: commRate,
        commAmt: commAmt,
        fixed: fixed,
        collect: collect,
        ship: ship,
        gstOnFees: gstOnFees,
        totalDeduct: totalDeduct,
        bank: bank,
        retBuffer: retBuffer,
        netProfit: netProfit,
        margin: margin
      };
    });

    // Populate Meesho
    document.getElementById('cmpCommMeesho').textContent = results.meesho.commRate + '% (' + fmt(results.meesho.commAmt) + ')';
    document.getElementById('cmpFixedMeesho').textContent = fmt(results.meesho.fixed);
    document.getElementById('cmpCollectMeesho').textContent = fmt(results.meesho.collect);
    document.getElementById('cmpShipMeesho').textContent = fmt(results.meesho.ship);
    document.getElementById('cmpGstMeesho').textContent = fmt(results.meesho.gstOnFees);
    document.getElementById('cmpTotalDeductMeesho').textContent = fmt(results.meesho.totalDeduct);
    document.getElementById('cmpBankMeesho').textContent = fmt(results.meesho.bank);
    document.getElementById('cmpReturnMeesho').textContent = '- ' + fmt(results.meesho.retBuffer);
    document.getElementById('cmpProfitMeesho').textContent = fmt(results.meesho.netProfit);
    document.getElementById('cmpMarginMeesho').textContent = results.meesho.margin.toFixed(1) + '%';

    // Populate Flipkart
    document.getElementById('cmpCommFlipkart').textContent = results.flipkart.commRate + '% (' + fmt(results.flipkart.commAmt) + ')';
    document.getElementById('cmpFixedFlipkart').textContent = fmt(results.flipkart.fixed);
    document.getElementById('cmpCollectFlipkart').textContent = fmt(results.flipkart.collect);
    document.getElementById('cmpShipFlipkart').textContent = fmt(results.flipkart.ship);
    document.getElementById('cmpGstFlipkart').textContent = fmt(results.flipkart.gstOnFees);
    document.getElementById('cmpTotalDeductFlipkart').textContent = fmt(results.flipkart.totalDeduct);
    document.getElementById('cmpBankFlipkart').textContent = fmt(results.flipkart.bank);
    document.getElementById('cmpReturnFlipkart').textContent = '- ' + fmt(results.flipkart.retBuffer);
    document.getElementById('cmpProfitFlipkart').textContent = fmt(results.flipkart.netProfit);
    document.getElementById('cmpMarginFlipkart').textContent = results.flipkart.margin.toFixed(1) + '%';

    // Populate Amazon
    document.getElementById('cmpCommAmazon').textContent = results.amazon.commRate + '% (' + fmt(results.amazon.commAmt) + ')';
    document.getElementById('cmpFixedAmazon').textContent = fmt(results.amazon.fixed);
    document.getElementById('cmpCollectAmazon').textContent = fmt(results.amazon.collect);
    document.getElementById('cmpShipAmazon').textContent = fmt(results.amazon.ship);
    document.getElementById('cmpGstAmazon').textContent = fmt(results.amazon.gstOnFees);
    document.getElementById('cmpTotalDeductAmazon').textContent = fmt(results.amazon.totalDeduct);
    document.getElementById('cmpBankAmazon').textContent = fmt(results.amazon.bank);
    document.getElementById('cmpReturnAmazon').textContent = '- ' + fmt(results.amazon.retBuffer);
    document.getElementById('cmpProfitAmazon').textContent = fmt(results.amazon.netProfit);
    document.getElementById('cmpMarginAmazon').textContent = results.amazon.margin.toFixed(1) + '%';

    // Winner badge logic
    var highest = Math.max(results.meesho.netProfit, results.flipkart.netProfit, results.amazon.netProfit);
    var badgeMeesho = document.getElementById('badgeWinnerMeesho');
    var badgeFlipkart = document.getElementById('badgeWinnerFlipkart');
    var badgeAmazon = document.getElementById('badgeWinnerAmazon');
    if (badgeMeesho) badgeMeesho.classList.toggle('hidden', results.meesho.netProfit !== highest);
    if (badgeFlipkart) badgeFlipkart.classList.toggle('hidden', results.flipkart.netProfit !== highest);
    if (badgeAmazon) badgeAmazon.classList.toggle('hidden', results.amazon.netProfit !== highest);
  };

  // Ensure matrix syncs on initial load
  function syncMatrix() {
    if (window.triggerCalculatorUpdate) {
      window.triggerCalculatorUpdate();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', syncMatrix);
  } else {
    syncMatrix();
  }
})();
</script>
