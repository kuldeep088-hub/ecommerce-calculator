---

<section id="tools-catalog" class="py-12 sm:py-16 bg-neutral-50/60 border-t border-b border-neutral-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-8 sm:mb-10">
      <div class="inline-flex items-center gap-2 mb-2">
        <span class="text-xs font-mono font-bold px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200">
          All 31 E-Commerce Calculators
        </span>
        <span class="text-xs text-neutral-500 font-mono">100% Free &bull; Updated 2026 Slabs</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-neutral-900">
        Complete Suite of Indian Seller Calculators
      </h2>
      <p class="mt-2 text-xs sm:text-sm text-neutral-600 leading-relaxed">
        Select a calculator to model exact marketplace fees, GST input tax credits, courier charges, ad ROAS, and take-home profits.
      </p>

      <!-- Category Filter Tabs -->
      <div class="flex flex-wrap items-center justify-center gap-1.5 mt-5" id="homeCatalogFilters">
        {filterCategories.map((cat, idx) => (
          <button
            type="button"
            data-filter={cat}
            class={`catalog-filter-btn px-3 py-1.5 rounded-full text-xs font-medium transition-all border cursor-pointer ${
              idx === 0
                ? 'bg-neutral-900 text-white border-transparent shadow-xs font-semibold'
                : 'bg-white hover:bg-neutral-100 text-neutral-600 border-neutral-200'
            }`}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>

    <!-- Categorized Grid of Tools -->
    <div class="space-y-10" id="catalogGroupsContainer">
      {CATEGORIES.map((cat) => (
        <div class="catalog-group" data-category={cat.title}>
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-4 pb-2 border-b border-neutral-200">
            <h3 class="text-base sm:text-lg font-semibold text-neutral-900 flex items-center gap-2">
              <span>{cat.title}</span>
              <span class="text-[11px] font-mono font-normal text-neutral-400">({cat.tools.length})</span>
            </h3>
            <p class="text-xs text-neutral-500">{cat.subtitle}</p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {cat.tools.map((tool) => (
              <a
                href={tool.url}
                data-tool-category={tool.category}
                class="tool-card group flex flex-col justify-between p-4 sm:p-5 rounded-2xl bg-white border border-neutral-200 hover:border-neutral-900 transition-all hover:shadow-xs"
              >
                <div>
                  <div class="flex items-center justify-between gap-2 mb-2">
                    <span class="text-[11px] font-mono font-semibold px-2 py-0.5 rounded-full bg-neutral-50 text-neutral-700 border border-neutral-200 group-hover:bg-emerald-50 group-hover:text-emerald-800 group-hover:border-emerald-200 transition">
                      {tool.badge}
                    </span>
                    <span class="text-neutral-300 group-hover:text-neutral-900 group-hover:translate-x-0.5 transition-all text-xs font-semibold">
                      &rarr;
                    </span>
                  </div>
                  <h4 class="text-sm font-semibold text-neutral-900 group-hover:text-emerald-700 transition leading-snug">
                    {tool.title}
                  </h4>
                  <p class="text-xs text-neutral-500 mt-1.5 leading-relaxed line-clamp-2">
                    {tool.desc}
                  </p>
                </div>

                <div class="mt-4 pt-3 border-t border-neutral-100 flex items-center justify-between text-[11px] text-neutral-400 font-mono">
                  <span>Open Tool</span>
                  <span class="text-neutral-600 group-hover:text-neutral-900 font-medium">Free &bull; 2026</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<!-- Filter Script -->
<script is:inline>
(function() {
  function initCatalogFilter() {
    var buttons = document.querySelectorAll('.catalog-filter-btn');
    var cards = document.querySelectorAll('.tool-card');
    var groups = document.querySelectorAll('.catalog-group');

    buttons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var filter = btn.dataset.filter;

        // Update button styles
        buttons.forEach(function(b) {
          b.className = 'catalog-filter-btn px-3 py-1.5 rounded-full text-xs font-medium transition-all border bg-white hover:bg-neutral-100 text-neutral-600 border-neutral-200 cursor-pointer';
        });
        btn.className = 'catalog-filter-btn px-3 py-1.5 rounded-full text-xs font-medium transition-all border bg-neutral-900 text-white border-transparent shadow-xs font-semibold cursor-pointer';

        // Filter cards and section visibility
        groups.forEach(function(group) {
          var groupCards = group.querySelectorAll('.tool-card');
          var visibleCount = 0;

          groupCards.forEach(function(card) {
            var cat = card.dataset.toolCategory;
            if (filter === 'All Tools' || cat === filter) {
              card.classList.remove('hidden');
              visibleCount++;
            } else {
              card.classList.add('hidden');
            }
          });

          if (visibleCount === 0) {
            group.classList.add('hidden');
          } else {
            group.classList.remove('hidden');
          }
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCatalogFilter);
  } else {
    initCatalogFilter();
  }
})();
</script>
