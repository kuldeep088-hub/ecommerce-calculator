---
import { CATEGORIES } from '../data/categories';
import { useTranslations } from '../i18n/utils';
import type { SupportedLanguage } from '../i18n/ui';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<section id="reverse-solver" class="py-12 bg-white dark:bg-[#000000]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="max-w-3xl mb-8">
      <div class="inline-flex items-center gap-1.5 text-xs font-mono text-neutral-500 dark:text-neutral-400 uppercase tracking-wider mb-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        {t("solver.badge")}
      </div>
      <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-[#171717] dark:text-white">
        {t("solver.title")}
      </h2>
      <p class="text-sm text-neutral-600 dark:text-neutral-400 mt-1">
        {t("solver.sub")}
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Inputs (5 Cols) -->
      <div class="lg:col-span-5 bg-neutral-50/70 dark:bg-[#0a0a0a] border border-[#ebebeb] dark:border-[#262626] rounded-2xl p-6 sm:p-7">
        <h3 class="text-sm font-semibold text-[#171717] dark:text-white mb-4">Your Cost &amp; Profit Goal</h3>
        
        <form id="solverForm" class="space-y-4" onsubmit="return false;">
          
          <div>
            <label for="solvCogs" class="block text-xs font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300 mb-1">
              Product Cost (COGS)
            </label>
            <div class="relative">
              <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-neutral-400 dark:text-neutral-500 font-semibold text-sm">₹</div>
              <input
                type="number"
                id="solvCogs"
                value="250"
                min="0"
                class="w-full pl-8 pr-4 py-2.5 bg-white dark:bg-[#141414] border border-neutral-200 dark:border-neutral-800 rounded-xl text-sm font-mono text-neutral-900 dark:text-white outline-none focus:border-neutral-900 dark:focus:border-white"
              />
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="solvTargetMode" class="block text-xs font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300 mb-1">
                Goal Type
              </label>
              <select
                id="solvTargetMode"
                class="w-full px-3 py-2.5 bg-white dark:bg-[#141414] border border-neutral-200 dark:border-neutral-800 rounded-xl text-xs sm:text-sm text-neutral-800 dark:text-neutral-200 outline-none"
              >
                <option value="fixed" class="bg-white dark:bg-[#141414] text-neutral-900 dark:text-neutral-100">Fixed ₹ Profit</option>
                <option value="margin" class="bg-white dark:bg-[#141414] text-neutral-900 dark:text-neutral-100">Margin % of Price</option>
              </select>
            </div>

            <div>
              <label for="solvTargetVal" class="block text-xs font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300 mb-1" id="solvTargetValLabel">
                Desired Profit (₹)
              </label>
              <input
                type="number"
                id="solvTargetVal"
                value="100"
                min="1"
                class="w-full px-3 py-2.5 bg-white dark:bg-[#141414] border border-neutral-200 dark:border-neutral-800 rounded-xl text-sm font-mono text-neutral-900 dark:text-white outline-none"
              />
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="solvCategory" class="block text-xs font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300 mb-1">
                Category
              </label>
              <select
                id="solvCategory"
                class="w-full px-3 py-2 bg-white dark:bg-[#141414] border border-neutral-200 dark:border-neutral-800 rounded-xl text-xs text-neutral-800 dark:text-neutral-200 outline-none"
              >
                {CATEGORIES.map((c) => (
                  <option value={c.id} class="bg-white dark:bg-[#141414] text-neutral-900 dark:text-neutral-100">{c.name}</option>
                ))}
              </select>
            </div>

            <div>
              <label for="solvWeight" class="block text-xs font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300 mb-1">
                Weight (g)
              </label>
              <input
                type="number"
                id="solvWeight"
                value="500"
                step="50"
                class="w-full px-3 py-2 bg-white dark:bg-[#141414] border border-neutral-200 dark:border-neutral-800 rounded-xl text-xs font-mono text-neutral-900 dark:text-white outline-none"
              />
            </div>
          </div>

          <div class="pt-2">
            <button
              type="button"
              id="solvCalculateBtn"
              class="w-full py-3 bg-[#171717] hover:bg-[#262626] dark:bg-white dark:hover:bg-neutral-200 text-white dark:text-black rounded-xl text-sm font-semibold transition active:scale-98 shadow-sm flex items-center justify-center gap-2"
            >
              <span>Solve Minimum Selling Prices</span>
              <span>&rarr;</span>
            </button>
          </div>

        </form>
      </div>

      <!-- Results Cards (7 Cols) -->
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-3 gap-4">
        
        <!-- Meesho Target Price -->
        <div class="card-ver p-5 bg-white dark:bg-[#0a0a0a] border border-[#ebebeb] dark:border-[#262626] flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-2 mb-2">
              <span class="w-2.5 h-2.5 rounded-full bg-pink-500"></span>
              <span class="font-bold text-sm text-neutral-900 dark:text-white">Meesho</span>
            </div>
            <span class="text-xs text-neutral-500 dark:text-neutral-400">Required Selling Price</span>
            <div class="text-3xl font-mono font-bold text-neutral-900 dark:text-white mt-2" id="solvPriceMeesho">
              ₹449
            </div>
          </div>
          <div class="mt-4 pt-3 border-t border-neutral-100 dark:border-neutral-800 text-xs text-neutral-500 dark:text-neutral-400 space-y-1">
            <div class="flex justify-between">
              <span>Commission:</span>
              <strong class="font-mono text-emerald-600 dark:text-emerald-400">0%</strong>
            </div>
            <div class="flex justify-between">
              <span>Courier &amp; RTO buffer:</span>
              <span class="font-mono text-neutral-700 dark:text-neutral-300" id="solvBufferMeesho">₹89</span>
            </div>
          </div>
        </div>

        <!-- Flipkart Target Price -->
        <div class="card-ver p-5 bg-white dark:bg-[#0a0a0a] border border-[#ebebeb] dark:border-[#262626] flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-2 mb-2">
              <span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span>
              <span class="font-bold text-sm text-neutral-900 dark:text-white">Flipkart</span>
            </div>
            <span class="text-xs text-neutral-500 dark:text-neutral-400">Required Selling Price</span>
            <div class="text-3xl font-mono font-bold text-neutral-900 dark:text-white mt-2" id="solvPriceFlipkart">
              ₹589
            </div>
          </div>
          <div class="mt-4 pt-3 border-t border-neutral-100 dark:border-neutral-800 text-xs text-neutral-500 dark:text-neutral-400 space-y-1">
            <div class="flex justify-between">
              <span>Commission:</span>
              <span class="font-mono text-neutral-700 dark:text-neutral-300" id="solvCommFlipkart">15.0%</span>
            </div>
            <div class="flex justify-between">
              <span>Total Fees &amp; GST:</span>
              <span class="font-mono text-neutral-700 dark:text-neutral-300" id="solvBufferFlipkart">₹219</span>
            </div>
          </div>
        </div>

        <!-- Amazon Target Price -->
        <div class="card-ver p-5 bg-white dark:bg-[#0a0a0a] border border-[#ebebeb] dark:border-[#262626] flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-2 mb-2">
              <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
              <span class="font-bold text-sm text-neutral-900 dark:text-white">Amazon</span>
            </div>
            <span class="text-xs text-neutral-500 dark:text-neutral-400">Required Selling Price</span>
            <div class="text-3xl font-mono font-bold text-neutral-900 dark:text-white mt-2" id="solvPriceAmazon">
              ₹599
            </div>
          </div>
          <div class="mt-4 pt-3 border-t border-neutral-100 dark:border-neutral-800 text-xs text-neutral-500 dark:text-neutral-400 space-y-1">
            <div class="flex justify-between">
              <span>Commission:</span>
              <span class="font-mono text-neutral-700 dark:text-neutral-300" id="solvCommAmazon">13.5%</span>
            </div>
            <div class="flex justify-between">
              <span>Total Fees &amp; GST:</span>
              <span class="font-mono text-neutral-700 dark:text-neutral-300" id="solvBufferAmazon">₹225</span>
            </div>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>

<script is:inline>
(function() {
  function solveForMp(mp, cogs, targetVal, targetMode, cat) {
    // Binary search for required price
    var low = Math.max(1, cogs);
    var high = low * 8 + 1500;
    var best = high;

    var commRate = mp === 'meesho' ? 0 : mp === 'flipkart' ? 15 : 13.5;
    var ship = mp === 'meesho' ? 49 : mp === 'flipkart' ? 69 : 74;

    for (var i = 0; i < 30; i++) {
      var mid = (low + high) / 2;
      var taxable = mid / 1.12; // 12% standard
      var comm = taxable * (commRate / 100);
      var fixed = mp === 'amazon' ? (mid <= 500 ? 10 : mid <= 1000 ? 25 : 35) : mp === 'flipkart' ? (mid <= 500 ? 17 : 30) : 0;
      var collect = mp === 'meesho' ? 0 : mid * 0.02;
      var feesExGst = comm + fixed + collect + ship;
      var gstOnFees = feesExGst * 0.18;
      var tcsTds = taxable * 0.011;
      var delivProfit = taxable - cogs - feesExGst - 15;
      
      // Estimated blended profit with 20% total return
      var blendedProfit = (delivProfit * 0.8) - 40;
      var currentMetric = targetMode === 'fixed' ? blendedProfit : (blendedProfit / mid) * 100;

      if (Math.abs(currentMetric - targetVal) < 1) {
        return Math.round(mid);
      }

      if (currentMetric < targetVal) {
        low = mid;
      } else {
        high = mid;
        best = mid;
      }
    }
    return Math.round(best);
  }

  function runSolver() {
    var cogs = parseFloat(document.getElementById('solvCogs').value) || 250;
    var targetMode = document.getElementById('solvTargetMode').value;
    var targetVal = parseFloat(document.getElementById('solvTargetVal').value) || 100;
    var cat = document.getElementById('solvCategory').value;

    var pMeesho = solveForMp('meesho', cogs, targetVal, targetMode, cat);
    var pFlipkart = solveForMp('flipkart', cogs, targetVal, targetMode, cat);
    var pAmazon = solveForMp('amazon', cogs, targetVal, targetMode, cat);

    document.getElementById('solvPriceMeesho').textContent = '₹' + pMeesho;
    document.getElementById('solvPriceFlipkart').textContent = '₹' + pFlipkart;
    document.getElementById('solvPriceAmazon').textContent = '₹' + pAmazon;
  }

  document.addEventListener('DOMContentLoaded', function() {
    var btn = document.getElementById('solvCalculateBtn');
    if (btn) btn.addEventListener('click', runSolver);

    var modeSelect = document.getElementById('solvTargetMode');
    if (modeSelect) {
      modeSelect.addEventListener('change', function() {
        var label = document.getElementById('solvTargetValLabel');
        var input = document.getElementById('solvTargetVal');
        if (modeSelect.value === 'fixed') {
          label.textContent = 'Desired Profit (₹)';
          input.value = '100';
        } else {
          label.textContent = 'Desired Margin (%)';
          input.value = '25';
        }
        runSolver();
      });
    }

    var solverInputs = ['solvCogs', 'solvTargetVal', 'solvCategory', 'solvWeight'];
    solverInputs.forEach(function(id) {
      var el = document.getElementById(id);
      if (el) {
        el.addEventListener('input', runSolver);
      }
    });

    runSolver();
  });
})();
</script>
