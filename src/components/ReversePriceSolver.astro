---
import { CATEGORIES } from '../data/categories';

interface Props {
  lang?: string;
}
---

<section id="reverse-solver" class="py-12 sm:py-16 bg-transparent border-t border-neutral-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <div class="mb-6">
      <h2 class="text-xl sm:text-2xl font-semibold tracking-tight text-neutral-900">
        Target Price Solver
      </h2>
      <p class="text-xs sm:text-sm text-neutral-500 mt-1">
        Enter your desired profit or margin to find the required listing price across platforms.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      
      <!-- Inputs (5 Cols) -->
      <div class="lg:col-span-5 bg-white border border-neutral-200 rounded-2xl p-5 sm:p-6 shadow-xs">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-neutral-700 mb-4">Cost &amp; Profit Goal</h3>
        
        <form id="solverForm" class="space-y-4" onsubmit="return false;">
          
          <div>
            <label for="solvCogs" class="block text-xs font-medium text-neutral-700 mb-1">
              Product Cost (COGS)
            </label>
            <div class="relative rounded-xl border border-neutral-200 bg-white focus-within:border-neutral-900 transition-all">
              <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-neutral-400 font-semibold text-sm">₹</div>
              <input
                type="number"
                id="solvCogs"
                value="250"
                min="0"
                class="w-full pl-8 pr-4 py-2.5 bg-transparent rounded-xl text-sm font-mono text-neutral-900 outline-none min-h-[42px]"
              />
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="solvTargetMode" class="block text-xs font-medium text-neutral-700 mb-1">
                Goal Type
              </label>
              <select
                id="solvTargetMode"
                class="w-full px-3 py-2.5 bg-white border border-neutral-200 focus:border-neutral-900 rounded-xl text-xs sm:text-sm text-neutral-800 outline-none cursor-pointer min-h-[42px]"
              >
                <option value="fixed">Fixed ₹ Profit</option>
                <option value="margin">Margin % of Price</option>
              </select>
            </div>

            <div>
              <label for="solvTargetVal" class="block text-xs font-medium text-neutral-700 mb-1" id="solvTargetValLabel">
                Desired Profit (₹)
              </label>
              <div class="rounded-xl border border-neutral-200 bg-white focus-within:border-neutral-900 transition-all">
                <input
                  type="number"
                  id="solvTargetVal"
                  value="100"
                  min="1"
                  class="w-full px-3 py-2.5 bg-transparent rounded-xl text-sm font-mono text-neutral-900 outline-none min-h-[42px]"
                />
              </div>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="solvCategory" class="block text-xs font-medium text-neutral-700 mb-1">
                Category
              </label>
              <select
                id="solvCategory"
                class="w-full px-3 py-2.5 bg-white border border-neutral-200 focus:border-neutral-900 rounded-xl text-xs sm:text-sm text-neutral-800 outline-none cursor-pointer min-h-[42px]"
              >
                {CATEGORIES.map((c) => (
                  <option value={c.id}>{c.name}</option>
                ))}
              </select>
            </div>

            <div>
              <label for="solvWeight" class="block text-xs font-medium text-neutral-700 mb-1">
                Weight (g)
              </label>
              <div class="rounded-xl border border-neutral-200 bg-white focus-within:border-neutral-900 transition-all">
                <input
                  type="number"
                  id="solvWeight"
                  value="500"
                  step="50"
                  class="w-full px-3 py-2.5 bg-transparent rounded-xl text-xs sm:text-sm font-mono text-neutral-900 outline-none min-h-[42px]"
                />
              </div>
            </div>
          </div>

          <div class="pt-2">
            <button
              type="button"
              id="solvCalculateBtn"
              class="w-full py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs sm:text-sm font-semibold transition cursor-pointer shadow-xs"
            >
              Solve Minimum Selling Prices
            </button>
          </div>

        </form>
      </div>

      <!-- Results Cards (7 Cols) -->
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-3.5">
        
        <!-- Meesho Target Price -->
        <div class="bg-white border border-neutral-200 rounded-2xl p-4 sm:p-5 shadow-xs flex flex-col justify-between">
          <div>
            <span class="font-semibold text-sm text-neutral-900 block mb-1">Meesho</span>
            <span class="text-xs text-neutral-500">Required Selling Price</span>
            <div class="text-2xl sm:text-3xl font-mono font-bold text-neutral-900 mt-1" id="solvPriceMeesho">
              ₹449
            </div>
          </div>
          <div class="mt-4 pt-3 border-t border-neutral-100 text-xs text-neutral-500 space-y-1">
            <div class="flex justify-between">
              <span>Commission:</span>
              <strong class="font-mono text-emerald-600 font-semibold">0%</strong>
            </div>
            <div class="flex justify-between">
              <span>Courier &amp; RTO:</span>
              <span class="font-mono text-neutral-700" id="solvBufferMeesho">₹89</span>
            </div>
          </div>
        </div>

        <!-- Flipkart Target Price -->
        <div class="bg-white border border-neutral-200 rounded-2xl p-4 sm:p-5 shadow-xs flex flex-col justify-between">
          <div>
            <span class="font-semibold text-sm text-neutral-900 block mb-1">Flipkart</span>
            <span class="text-xs text-neutral-500">Required Selling Price</span>
            <div class="text-2xl sm:text-3xl font-mono font-bold text-neutral-900 mt-1" id="solvPriceFlipkart">
              ₹589
            </div>
          </div>
          <div class="mt-4 pt-3 border-t border-neutral-100 text-xs text-neutral-500 space-y-1">
            <div class="flex justify-between">
              <span>Commission:</span>
              <span class="font-mono text-neutral-700" id="solvCommFlipkart">15.0%</span>
            </div>
            <div class="flex justify-between">
              <span>Fees &amp; GST:</span>
              <span class="font-mono text-neutral-700" id="solvBufferFlipkart">₹219</span>
            </div>
          </div>
        </div>

        <!-- Amazon Target Price -->
        <div class="bg-white border border-neutral-200 rounded-2xl p-4 sm:p-5 shadow-xs flex flex-col justify-between">
          <div>
            <span class="font-semibold text-sm text-neutral-900 block mb-1">Amazon India</span>
            <span class="text-xs text-neutral-500">Required Selling Price</span>
            <div class="text-2xl sm:text-3xl font-mono font-bold text-neutral-900 mt-1" id="solvPriceAmazon">
              ₹599
            </div>
          </div>
          <div class="mt-4 pt-3 border-t border-neutral-100 text-xs text-neutral-500 space-y-1">
            <div class="flex justify-between">
              <span>Commission:</span>
              <span class="font-mono text-neutral-700" id="solvCommAmazon">13.5%</span>
            </div>
            <div class="flex justify-between">
              <span>Fees &amp; GST:</span>
              <span class="font-mono text-neutral-700" id="solvBufferAmazon">₹225</span>
            </div>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>

<!-- CLIENT SCRIPT TO RUN REVERSE SOLVER -->
<script is:inline>
(function() {
  var CAT_COMMISSIONS = {
    fashion: { meesho: 0, flipkart: 15.0, amazon: 13.5 },
    footwear: { meesho: 0, flipkart: 14.0, amazon: 12.0 },
    electronics_accessories: { meesho: 0, flipkart: 12.5, amazon: 14.0 },
    home_kitchen: { meesho: 0, flipkart: 11.0, amazon: 10.5 },
    beauty_grooming: { meesho: 0, flipkart: 9.0, amazon: 8.5 },
    jewellery_fashion: { meesho: 0, flipkart: 16.0, amazon: 15.0 },
    grocery_fmcg: { meesho: 0, flipkart: 6.5, amazon: 6.0 },
    toys_baby: { meesho: 0, flipkart: 10.5, amazon: 9.5 },
    books: { meesho: 0, flipkart: 9.0, amazon: 8.0 },
    custom: { meesho: 0, flipkart: 10.0, amazon: 10.0 }
  };

  function getAmzClose(p) {
    if (p <= 250) return 5;
    if (p <= 500) return 10;
    if (p <= 1000) return 25;
    if (p <= 2000) return 35;
    return 50;
  }

  function getFkFixed(p) {
    if (p <= 300) return 13;
    if (p <= 500) return 17;
    if (p <= 1000) return 30;
    return 52;
  }

  function getShip(mp, w) {
    if (mp === 'meesho') return w <= 500 ? 49 : 85;
    if (mp === 'amazon') return w <= 500 ? 74 : 110;
    if (mp === 'flipkart') return w <= 500 ? 69 : 101;
    return 55;
  }

  function solvePrice(mp, cogs, targetType, targetVal, category, weight) {
    var commRate = (CAT_COMMISSIONS[category] && CAT_COMMISSIONS[category][mp]) || 0;
    var shipFee = getShip(mp, weight);
    var pkg = 15;

    var low = Math.max(1, cogs);
    var high = low * 12 + 2500;
    var best = low;

    for (var i = 0; i < 35; i++) {
      var mid = (low + high) / 2;
      var taxable = mid / 1.12; // 12% standard GST
      var comm = taxable * (commRate / 100);
      var fixed = mp === 'amazon' ? getAmzClose(mid) : mp === 'flipkart' ? getFkFixed(mid) : 0;
      var coll = (mp === 'flipkart' || mp === 'amazon') ? (mid * 0.02) : 0;
      var feesExGst = comm + fixed + coll + shipFee;
      var gstOnFees = feesExGst * 0.18;
      var tcsTds = taxable * 0.011;
      var totalDeduct = feesExGst + gstOnFees + tcsTds;

      var deliveredProfit = taxable - cogs - feesExGst - pkg;
      var rtoLoss = (mp === 'meesho' ? 0 : shipFee) + pkg + 10;
      var custRetLoss = 130 + pkg + 15 + cogs * 0.05;

      var rtoRate = 0.15;
      var retRate = 0.08;
      var delivRate = 1 - rtoRate - retRate;
      var retBuffer = (rtoLoss * rtoRate) + (custRetLoss * retRate);

      var blendedProfit = (deliveredProfit * delivRate) - retBuffer;
      var metric = targetType === 'fixed' ? blendedProfit : (blendedProfit / mid) * 100;

      if (Math.abs(metric - targetVal) < 0.25) {
        return Math.round(mid);
      }

      if (metric < targetVal) {
        low = mid;
      } else {
        high = mid;
        best = mid;
      }
    }
    return Math.round(best);
  }

  function runSolver() {
    var cogs = parseFloat(document.getElementById('solvCogs').value) || 250;
    var mode = document.getElementById('solvTargetMode').value;
    var target = parseFloat(document.getElementById('solvTargetVal').value) || 100;
    var cat = document.getElementById('solvCategory').value;
    var weight = parseFloat(document.getElementById('solvWeight').value) || 500;

    var meeshoPrice = solvePrice('meesho', cogs, mode, target, cat, weight);
    var flipkartPrice = solvePrice('flipkart', cogs, mode, target, cat, weight);
    var amazonPrice = solvePrice('amazon', cogs, mode, target, cat, weight);

    document.getElementById('solvPriceMeesho').textContent = '₹' + meeshoPrice.toLocaleString('en-IN');
    document.getElementById('solvPriceFlipkart').textContent = '₹' + flipkartPrice.toLocaleString('en-IN');
    document.getElementById('solvPriceAmazon').textContent = '₹' + amazonPrice.toLocaleString('en-IN');

    var rates = CAT_COMMISSIONS[cat] || CAT_COMMISSIONS['fashion'];
    document.getElementById('solvCommFlipkart').textContent = rates.flipkart + '%';
    document.getElementById('solvCommAmazon').textContent = rates.amazon + '%';

    document.getElementById('solvBufferMeesho').textContent = '₹' + Math.round(meeshoPrice - cogs - target);
    document.getElementById('solvBufferFlipkart').textContent = '₹' + Math.round(flipkartPrice - cogs - target);
    document.getElementById('solvBufferAmazon').textContent = '₹' + Math.round(amazonPrice - cogs - target);
  }

  function initSolver() {
    var modeSelect = document.getElementById('solvTargetMode');
    var valLabel = document.getElementById('solvTargetValLabel');
    var valInput = document.getElementById('solvTargetVal');

    if (modeSelect) {
      modeSelect.addEventListener('change', function() {
        if (modeSelect.value === 'fixed') {
          valLabel.textContent = 'Desired Profit (₹)';
          valInput.value = '100';
        } else {
          valLabel.textContent = 'Desired Margin (%)';
          valInput.value = '20';
        }
        runSolver();
      });
    }

    ['solvCogs', 'solvTargetVal', 'solvCategory', 'solvWeight'].forEach(function(id) {
      var el = document.getElementById(id);
      if (el) {
        el.addEventListener('input', runSolver);
        el.addEventListener('change', runSolver);
      }
    });

    var calcBtn = document.getElementById('solvCalculateBtn');
    if (calcBtn) calcBtn.addEventListener('click', runSolver);

    runSolver();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSolver);
  } else {
    initSolver();
  }
})();
</script>
