---
// src/components/Footer.astro
---

<footer class="bg-white border-t border-neutral-200 py-12 text-xs text-neutral-500">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-6 sm:gap-8 mb-10">
      
      <!-- Marketplaces -->
      <div>
        <h4 class="font-semibold text-neutral-900 mb-3 uppercase tracking-wider text-[11px]">
          Marketplaces
        </h4>
        <ul class="space-y-1.5">
          <li><a href="/amazon-profit-calculator" class="hover:text-black transition">Amazon Profit</a></li>
          <li><a href="/flipkart-profit-calculator" class="hover:text-black transition">Flipkart Fee</a></li>
          <li><a href="/meesho-profit-calculator" class="hover:text-black transition">Meesho Profit (0%)</a></li>
          <li><a href="/amazon-fba-calculator" class="hover:text-black transition">Amazon FBA Profit</a></li>
        </ul>
      </div>

      <!-- Cost & Profit -->
      <div>
        <h4 class="font-semibold text-neutral-900 mb-3 uppercase tracking-wider text-[11px]">
          Cost &amp; Profit
        </h4>
        <ul class="space-y-1.5">
          <li><a href="/profit-margin-calculator" class="hover:text-black transition font-medium">Profit Margin %</a></li>
          <li><a href="/selling-price-calculator" class="hover:text-black transition font-medium">Product Selling Price</a></li>
          <li><a href="/net-profit-calculator" class="hover:text-black transition">Net Profit Calculator</a></li>
          <li><a href="/gross-profit-calculator" class="hover:text-black transition">Gross Profit Margin</a></li>
          <li><a href="/product-roi-calculator" class="hover:text-black transition">Product ROI %</a></li>
          <li><a href="/wholesale-profit-calculator" class="hover:text-black transition">Wholesale Profit</a></li>
          <li><a href="/dropshipping-profit-calculator" class="hover:text-black transition">Dropshipping Profit</a></li>
        </ul>
      </div>

      <!-- Shipping & Logistics -->
      <div>
        <h4 class="font-semibold text-neutral-900 mb-3 uppercase tracking-wider text-[11px]">
          Shipping &amp; Logistics
        </h4>
        <ul class="space-y-1.5">
          <li><a href="/shipping-cost-calculator" class="hover:text-black transition">Volumetric Weight</a></li>
          <li><a href="/courier-charges-calculator" class="hover:text-black transition">Courier Charges (3PL)</a></li>
        </ul>
      </div>

      <!-- GST & Taxes -->
      <div>
        <h4 class="font-semibold text-neutral-900 mb-3 uppercase tracking-wider text-[11px]">
          GST &amp; Taxes
        </h4>
        <ul class="space-y-1.5">
          <li><a href="/gst-calculator" class="hover:text-black transition font-medium">GST &amp; ITC Slabs</a></li>
          <li><a href="/gst-inclusive-exclusive-calculator" class="hover:text-black transition">GST Inclusive/Exclusive</a></li>
          <li><a href="/input-tax-credit-calculator" class="hover:text-black transition">Input Tax Credit (ITC)</a></li>
          <li><a href="/tcs-calculator" class="hover:text-black transition">0.5% TCS on E-commerce</a></li>
          <li><a href="/tds-calculator" class="hover:text-black transition">0.1% TDS (Sec 194-O)</a></li>
        </ul>
      </div>

      <!-- Advertising -->
      <div>
        <h4 class="font-semibold text-neutral-900 mb-3 uppercase tracking-wider text-[11px]">
          Advertising
        </h4>
        <ul class="space-y-1.5">
          <li><a href="/roas-calculator" class="hover:text-black transition font-medium">ROAS Multiplier</a></li>
          <li><a href="/acos-calculator" class="hover:text-black transition font-medium">ACOS Calculator</a></li>
          <li><a href="/ad-profit-calculator" class="hover:text-black transition">Ad Profit Calculator</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-neutral-100 pt-6 flex flex-col md:flex-row items-center justify-between gap-4 text-neutral-400 text-[11px]">
      <div class="flex items-center gap-2">
        <img src="/logo.svg" alt="Seller Profit Calculator" class="w-4 h-4 rounded-sm object-contain" width="16" height="16" />
        <span>&copy; 2026 freesellerprofitcalculator.in &bull; Free Indian marketplace seller tool suite.</span>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1.5 text-neutral-500">
        <a href="/about-us" class="hover:text-neutral-900 transition">About Us</a>
        <a href="/contact-us" class="hover:text-neutral-900 transition">Contact Us</a>
        <a href="/privacy-policy" class="hover:text-neutral-900 transition">Privacy Policy</a>
        <a href="/terms-and-conditions" class="hover:text-neutral-900 transition">Terms &amp; Conditions</a>
        <a href="#top" class="hover:text-neutral-900 transition">Back to Top &uarr;</a>
      </div>
    </div>

  </div>
</footer>
