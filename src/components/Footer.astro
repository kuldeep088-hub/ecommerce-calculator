---
// src/components/Footer.astro
---

<footer class="bg-white border-t border-neutral-200 py-10 text-xs text-neutral-500">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8 mb-8">
      
      <!-- Brand & Description -->
      <div class="space-y-2">
        <div class="flex items-center gap-2">
          <div class="w-6 h-6 rounded-md bg-emerald-600 flex items-center justify-center text-white font-bold text-xs">
            ₹
          </div>
          <span class="font-semibold text-sm text-neutral-900">Seller Profit Calculator</span>
        </div>
        <p class="text-neutral-500 leading-relaxed text-xs">
          Comprehensive, 100% free profit &amp; fee calculation suite for Indian e-commerce, D2C, and quick commerce brands.
        </p>
      </div>

      <!-- Marketplace Calculators -->
      <div>
        <h4 class="font-semibold text-neutral-900 mb-2.5 uppercase tracking-wider text-[11px]">
          Marketplaces
        </h4>
        <ul class="space-y-1.5">
          <li><a href="/meesho" class="hover:text-black transition">Meesho Profit Calculator (0%)</a></li>
          <li><a href="/flipkart" class="hover:text-black transition">Flipkart Fee Calculator (2026)</a></li>
          <li><a href="/amazon" class="hover:text-black transition">Amazon Easy Ship Calculator</a></li>
          <li><a href="/myntra" class="hover:text-black transition">Myntra Fashion Calculator</a></li>
          <li><a href="/shopsy" class="hover:text-black transition">Shopsy Value Calculator</a></li>
          <li><a href="/snapdeal" class="hover:text-black transition">Snapdeal Fee Calculator</a></li>
        </ul>
      </div>

      <!-- Quick Commerce -->
      <div>
        <h4 class="font-semibold text-neutral-900 mb-2.5 uppercase tracking-wider text-[11px]">
          Quick Commerce
        </h4>
        <ul class="space-y-1.5">
          <li><a href="/blinkit" class="hover:text-black transition">Blinkit Margin Calculator</a></li>
          <li><a href="/zepto" class="hover:text-black transition">Zepto Instant Delivery Calculator</a></li>
          <li><a href="/#comparison" class="hover:text-black transition">Multi-Platform Comparison</a></li>
          <li><a href="/#fee-guide" class="hover:text-black transition">2026 Fee Slabs Guide</a></li>
        </ul>
      </div>

      <!-- Seller Tools -->
      <div>
        <h4 class="font-semibold text-emerald-800 mb-2.5 uppercase tracking-wider text-[11px]">
          Seller Tools
        </h4>
        <ul class="space-y-1.5">
          <li><a href="/gst-calculator" class="hover:text-black transition font-medium">GST &amp; ITC Calculator</a></li>
          <li><a href="/rto-loss-calculator" class="hover:text-black transition font-medium">RTO Loss Calculator</a></li>
          <li><a href="/cod-profit-calculator" class="hover:text-black transition font-medium">COD Profit Calculator</a></li>
          <li><a href="/prepaid-vs-cod" class="hover:text-black transition font-medium">Prepaid vs COD Simulator</a></li>
          <li><a href="/#reverse-solver" class="hover:text-black transition">Target Price Solver</a></li>
          <li><a href="/#faq" class="hover:text-black transition">Seller FAQ</a></li>
        </ul>
      </div>

    </div>

    <div class="border-t border-neutral-100 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-neutral-400 text-[11px]">
      <div>
        &copy; 2026 freesellerprofitcalculator.com &bull; Free Indian marketplace seller tool.
      </div>
      <div class="flex items-center gap-4">
        <a href="#calculator" class="hover:text-neutral-600 transition">Back to Top &uarr;</a>
      </div>
    </div>

  </div>
</footer>
