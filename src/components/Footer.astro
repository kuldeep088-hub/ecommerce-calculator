---
// src/components/Footer.astro
---

<footer class="bg-white border-t border-neutral-200 py-10 text-xs text-neutral-500">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      
      <!-- Brand & Description -->
      <div class="space-y-2">
        <div class="flex items-center gap-2">
          <div class="w-6 h-6 rounded-md bg-emerald-600 flex items-center justify-center text-white font-bold text-xs">
            ₹
          </div>
          <span class="font-semibold text-sm text-neutral-900">Seller Profit Calculator</span>
        </div>
        <p class="text-neutral-500 leading-relaxed text-xs max-w-sm">
          A fast, simple profit &amp; fee calculator for Indian e-commerce sellers on Meesho, Flipkart, and Amazon India.
        </p>
      </div>

      <!-- Marketplace Calculators -->
      <div>
        <h4 class="font-semibold text-neutral-900 mb-2.5 uppercase tracking-wider text-[11px]">
          Platforms
        </h4>
        <ul class="space-y-1.5">
          <li><a href="#calculator" class="hover:text-black transition">Meesho Profit Calculator (0% Commission)</a></li>
          <li><a href="#calculator" class="hover:text-black transition">Flipkart Fee Calculator (2026 Slabs)</a></li>
          <li><a href="#calculator" class="hover:text-black transition">Amazon Easy Ship Fee Calculator</a></li>
          <li><a href="#calculator" class="hover:text-black transition">Snapdeal Fee Calculator</a></li>
        </ul>
      </div>

      <!-- Seller Tools -->
      <div>
        <h4 class="font-semibold text-neutral-900 mb-2.5 uppercase tracking-wider text-[11px]">
          Tools &amp; Guides
        </h4>
        <ul class="space-y-1.5">
          <li><a href="#comparison" class="hover:text-black transition">Platform Comparison Matrix</a></li>
          <li><a href="#reverse-solver" class="hover:text-black transition">Target Price Solver</a></li>
          <li><a href="#fee-guide" class="hover:text-black transition">Marketplace Fee Rates Guide</a></li>
          <li><a href="#faq" class="hover:text-black transition">Seller FAQ</a></li>
        </ul>
      </div>

    </div>

    <div class="border-t border-neutral-100 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-neutral-400 text-[11px]">
      <div>
        &copy; 2026 freesellerprofitcalculator.com &bull; Free Indian marketplace seller tool.
      </div>
      <div class="flex items-center gap-4">
        <a href="#calculator" class="hover:text-neutral-600 transition">Back to Top &uarr;</a>
      </div>
    </div>

  </div>
</footer>
