---
import { languages, type SupportedLanguage } from '../i18n/ui';
import { getLangFromUrl } from '../i18n/utils';

interface Props {
  currentLang?: SupportedLanguage;
}

const langFromUrl = getLangFromUrl(Astro.url);
const currentLang = Astro.props.currentLang || langFromUrl;
---

<div class="relative inline-flex items-center">
  <label for="languageSelect" class="sr-only">Select Language</label>
  <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-2.5 text-neutral-400 dark:text-neutral-500">
    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
    </svg>
  </div>
  <select
    id="languageSelect"
    class="pl-7 pr-6 py-1.5 bg-white/80 dark:bg-[#111111] hover:bg-neutral-100 dark:hover:bg-neutral-800 border border-neutral-200 dark:border-neutral-800 rounded-full text-xs font-mono font-medium text-neutral-700 dark:text-neutral-300 transition cursor-pointer outline-none appearance-none shadow-2xs"
  >
    {Object.entries(languages).map(([code, name]) => (
      <option value={code === "en" ? "/" : `/${code}/`} selected={code === currentLang} class="bg-white dark:bg-[#111111] text-neutral-900 dark:text-neutral-100">
        {name} ({code.toUpperCase()})
      </option>
    ))}
  </select>
  <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-2 text-neutral-400 dark:text-neutral-500">
    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
    </svg>
  </div>
</div>

<script is:inline>
(function() {
  function initLangPicker() {
    var select = document.getElementById('languageSelect');
    if (select) {
      select.addEventListener('change', function(e) {
        window.location.href = e.target.value;
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLangPicker);
  } else {
    initLangPicker();
  }
})();
</script>
