---
import { CATEGORIES } from '../data/categories';
import { MARKETPLACES } from '../data/marketplaces';
import { useTranslations } from '../i18n/utils';
import type { SupportedLanguage } from '../i18n/ui';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<section id="calculator" class="pt-5 sm:pt-8 pb-16 lg:pb-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Clean, Welcoming Hero Header -->
    <div class="text-center max-w-2xl mx-auto mb-6 sm:mb-8">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/40 mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        Simple, Free &amp; Updated for 2026
      </span>
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-semibold tracking-[-0.03em] text-neutral-900 dark:text-white leading-tight">
        {t("hero.title")}
      </h1>
      <p class="mt-2 text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 max-w-lg mx-auto leading-relaxed">
        {t("hero.subtitle")}
      </p>
    </div>

    <!-- Marketplace Selection (Step 1) -->
    <div class="flex flex-col items-center justify-center mb-6 sm:mb-8">
      <div class="inline-flex p-1.5 rounded-2xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-white/[0.08] shadow-xs max-w-full overflow-x-auto no-scrollbar scroll-smooth" id="marketplaceTabs">
        <button
          type="button"
          data-mp="meesho"
          class="mp-tab shrink-0 px-4 py-2 min-h-[40px] rounded-xl text-xs sm:text-sm font-medium transition-all flex items-center gap-2 bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 shadow-sm"
        >
          <span class="w-2.5 h-2.5 rounded-full bg-pink-500"></span>
          <span>Meesho</span>
          <span class="text-[10px] font-mono opacity-80 font-normal">0% Comm</span>
        </button>

        <button
          type="button"
          data-mp="flipkart"
          class="mp-tab shrink-0 px-4 py-2 min-h-[40px] rounded-xl text-xs sm:text-sm font-medium transition-all flex items-center gap-2 text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white"
        >
          <span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span>
          <span>Flipkart</span>
          <span class="text-[10px] font-mono text-neutral-400 dark:text-neutral-500 font-normal">4-16%</span>
        </button>

        <button
          type="button"
          data-mp="amazon"
          class="mp-tab shrink-0 px-4 py-2 min-h-[40px] rounded-xl text-xs sm:text-sm font-medium transition-all flex items-center gap-2 text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white"
        >
          <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
          <span>Amazon India</span>
          <span class="text-[10px] font-mono text-neutral-400 dark:text-neutral-500 font-normal">5-15%</span>
        </button>

        <button
          type="button"
          data-mp="snapdeal"
          class="mp-tab shrink-0 px-4 py-2 min-h-[40px] rounded-xl text-xs sm:text-sm font-medium transition-all flex items-center gap-2 text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white"
        >
          <span class="w-2.5 h-2.5 rounded-full bg-red-500"></span>
          <span>Snapdeal</span>
        </button>
      </div>
      <p class="mt-2.5 text-xs text-neutral-500 dark:text-neutral-400 text-center font-mono" id="calcCardSubtitle">
        Zero referral commission model with weight-slab courier rates.
      </p>
    </div>

    <!-- Main Two-Column Layout: Inputs on Left, Results Dashboard on Right -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start">
      
      <!-- LEFT COLUMN: Inputs Card (5 Cols on LG) -->
      <div class="lg:col-span-5 card-ver p-5 sm:p-6 bg-white dark:bg-[#0b0b0b] border border-neutral-200 dark:border-white/[0.08] shadow-sm">
        
        <div class="flex items-center justify-between border-b border-neutral-100 dark:border-white/[0.06] pb-3 mb-5">
          <div class="flex items-center gap-2">
            <span class="w-6 h-6 rounded-full bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 text-xs font-bold flex items-center justify-center shrink-0">1</span>
            <h2 class="text-sm font-semibold text-neutral-900 dark:text-white" id="calcCardTitle">
              Meesho Profit Inputs
            </h2>
          </div>
          <button type="button" id="resetBtn" class="text-xs text-neutral-400 hover:text-neutral-700 dark:hover:text-neutral-200 transition font-mono flex items-center gap-1.5 py-1 px-2 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800 cursor-pointer">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
            <span>Reset</span>
          </button>
        </div>

        <form id="calcForm" class="space-y-4" onsubmit="return false;">
          
          <!-- 1. SELLING PRICE (HERO INPUT) -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="inputSellingPrice" class="text-xs font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300 flex items-center gap-1.5">
                Selling Price (MRP)
                <span class="text-rose-500">*</span>
              </label>
              <span class="text-[11px] text-neutral-400 font-mono">Price on customer app</span>
            </div>
            <div class="relative rounded-xl border border-neutral-300 dark:border-white/[0.12] bg-neutral-50/60 dark:bg-neutral-900/40 focus-within:border-neutral-900 dark:focus-within:border-white focus-within:bg-white dark:focus-within:bg-black focus-within:ring-2 focus-within:ring-neutral-900/5 dark:focus-within:ring-white/10 transition-all">
              <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-neutral-500 font-bold text-lg">
                ₹
              </div>
              <input
                type="text"
                id="inputSellingPrice"
                inputmode="decimal"
                value="599"
                placeholder="599"
                class="w-full pl-9 pr-4 py-3 bg-transparent rounded-xl text-lg sm:text-xl font-mono font-bold text-neutral-900 dark:text-white outline-none"
              />
            </div>
            <p class="text-[11px] text-neutral-500 dark:text-neutral-400 mt-1">Paste or type any format (e.g. <span class="font-mono">₹599.00</span> or <span class="font-mono">1,250</span>).</p>
          </div>

          <!-- 2. COST OF GOODS SOLD (COGS) -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="inputCogs" class="text-xs font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300">
                Product Cost (COGS)
              </label>
              <span class="text-[11px] text-neutral-400 font-mono">Purchase / Mfg cost</span>
            </div>
            <div class="relative rounded-xl border border-neutral-300 dark:border-white/[0.12] bg-white dark:bg-neutral-900/50 focus-within:border-neutral-900 dark:focus-within:border-white focus-within:ring-2 focus-within:ring-neutral-900/5 dark:focus-within:ring-white/10 transition-all">
              <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-neutral-500 font-semibold text-base">
                ₹
              </div>
              <input
                type="text"
                id="inputCogs"
                inputmode="decimal"
                value="220"
                placeholder="220"
                class="w-full pl-9 pr-4 py-2.5 bg-transparent rounded-xl text-base font-mono font-semibold text-neutral-900 dark:text-white outline-none"
              />
            </div>
            <p class="text-[11px] text-neutral-500 dark:text-neutral-400 mt-1">What you paid to make or buy this product.</p>
          </div>

          <!-- 3. PRODUCT CATEGORY -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="selectCategory" class="text-xs font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300">
                Product Category
              </label>
              <span class="text-[11px] text-neutral-400 font-mono">Sets commission &amp; GST</span>
            </div>
            <select
              id="selectCategory"
              class="w-full px-3.5 py-2.5 bg-white dark:bg-neutral-900/50 border border-neutral-300 dark:border-white/[0.12] focus:border-neutral-900 dark:focus:border-white focus:ring-2 focus:ring-neutral-900/5 dark:focus:ring-white/10 rounded-xl text-xs sm:text-sm text-neutral-800 dark:text-neutral-200 transition outline-none cursor-pointer font-medium"
            >
              {CATEGORIES.map((cat) => (
                <option value={cat.id} class="bg-white dark:bg-[#141414] text-neutral-900 dark:text-neutral-100">{cat.name}</option>
              ))}
            </select>
          </div>

          <!-- OPTIONAL ADVANCED SETTINGS ACCORDION (COLLAPSIBLE) -->
          <div class="border border-neutral-200 dark:border-white/[0.08] rounded-xl overflow-hidden bg-neutral-50/40 dark:bg-neutral-900/20 pt-1">
            <button
              type="button"
              id="advancedSettingsToggleBtn"
              class="w-full px-3.5 py-2.5 flex items-center justify-between text-left text-xs font-medium text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100/60 dark:hover:bg-white/[0.03] transition cursor-pointer"
            >
              <span class="flex items-center gap-2">
                <svg class="w-4 h-4 text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                <span class="font-medium text-neutral-800 dark:text-neutral-200">More Settings (Optional)</span>
              </span>
              <span class="text-[11px] font-mono text-neutral-500 flex items-center gap-1.5">
                <span class="bg-neutral-200/80 dark:bg-neutral-800 px-1.5 py-0.5 rounded text-[10px]">Weight, GST &amp; Returns</span>
                <svg id="advancedArrowIcon" class="w-3.5 h-3.5 text-neutral-400 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </span>
            </button>

            <!-- Collapsible Panel: Hidden by default for pristine simplicity -->
            <div id="advancedSettingsPanel" class="p-3.5 border-t border-neutral-200 dark:border-white/[0.08] bg-white dark:bg-neutral-900/60 space-y-3.5 hidden">
              
              <!-- Weight & Distance -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <div class="flex items-center justify-between mb-1">
                    <label for="inputWeight" class="text-[11px] font-medium uppercase tracking-wider text-neutral-600 dark:text-neutral-400">
                      Courier Weight
                    </label>
                    <span id="weightDisplay" class="text-[11px] font-mono text-neutral-500">500g</span>
                  </div>
                  <input
                    type="number"
                    id="inputWeight"
                    value="500"
                    min="50"
                    step="50"
                    class="w-full px-3 py-2 bg-neutral-50/50 dark:bg-neutral-800/50 border border-neutral-200 dark:border-white/[0.08] rounded-xl text-xs sm:text-sm font-mono text-neutral-900 dark:text-white outline-none"
                  />
                </div>

                <div>
                  <label for="selectShippingZone" class="block text-[11px] font-medium uppercase tracking-wider text-neutral-600 dark:text-neutral-400 mb-1">
                    Delivery Distance
                  </label>
                  <select
                    id="selectShippingZone"
                    class="w-full px-3 py-2 bg-neutral-50/50 dark:bg-neutral-800/50 border border-neutral-200 dark:border-white/[0.08] rounded-xl text-xs sm:text-sm text-neutral-800 dark:text-neutral-200 outline-none cursor-pointer"
                  >
                    <option value="local">Local (City)</option>
                    <option value="regional">Regional (Zone)</option>
                    <option value="national" selected>National (Inter-State)</option>
                  </select>
                </div>
              </div>

              <!-- Product GST & Packaging -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label for="inputProductGst" class="block text-[11px] font-medium uppercase tracking-wider text-neutral-600 dark:text-neutral-400 mb-1">
                    Product GST Rate
                  </label>
                  <select
                    id="inputProductGst"
                    class="w-full px-3 py-2 bg-neutral-50/50 dark:bg-neutral-800/50 border border-neutral-200 dark:border-white/[0.08] rounded-xl text-xs sm:text-sm font-mono text-neutral-800 dark:text-neutral-200 outline-none cursor-pointer"
                  >
                    <option value="0">0% (Books / Exempt)</option>
                    <option value="3">3% (Jewellery)</option>
                    <option value="5">5% (Grocery / &lt;1k)</option>
                    <option value="12" selected>12% (Apparel / Shoes)</option>
                    <option value="18">18% (Electronics / Standard)</option>
                    <option value="28">28% (Luxury)</option>
                  </select>
                </div>

                <div>
                  <label for="inputPackagingCost" class="block text-[11px] font-medium uppercase tracking-wider text-neutral-600 dark:text-neutral-400 mb-1">
                    Packaging Material (₹)
                  </label>
                  <input
                    type="number"
                    id="inputPackagingCost"
                    value="15"
                    min="0"
                    class="w-full px-3 py-2 bg-neutral-50/50 dark:bg-neutral-800/50 border border-neutral-200 dark:border-white/[0.08] rounded-xl text-xs sm:text-sm font-mono text-neutral-900 dark:text-white outline-none"
                  />
                </div>
              </div>

              <!-- Ad Spend (CAC) -->
              <div>
                <label for="inputAdSpend" class="block text-[11px] font-medium uppercase tracking-wider text-neutral-600 dark:text-neutral-400 mb-1">
                  Ad Spend / CAC Per Order (Optional ₹)
                </label>
                <input
                  type="number"
                  id="inputAdSpend"
                  value="0"
                  min="0"
                  placeholder="0"
                  class="w-full px-3 py-2 bg-neutral-50/50 dark:bg-neutral-800/50 border border-neutral-200 dark:border-white/[0.08] rounded-xl text-xs sm:text-sm font-mono text-neutral-900 dark:text-white outline-none"
                />
              </div>

              <!-- RTO & Return Simulator -->
              <div class="pt-2 border-t border-neutral-200/60 dark:border-white/[0.06]">
                <div class="flex items-center justify-between mb-2">
                  <span class="text-xs font-semibold text-neutral-800 dark:text-neutral-200">Return &amp; RTO Simulator</span>
                  <span class="text-[10px] text-neutral-500 font-mono">Indian COD orders</span>
                </div>
                
                <div class="grid grid-cols-2 gap-3 mb-2.5">
                  <div>
                    <div class="flex justify-between items-center mb-1">
                      <label for="inputRtoRate" class="text-[10px] font-medium text-neutral-600 dark:text-neutral-400">RTO % (Undelivered)</label>
                      <span id="rtoRateDisplay" class="text-[10px] font-mono font-semibold text-neutral-800 dark:text-neutral-200">18%</span>
                    </div>
                    <input
                      type="range"
                      id="inputRtoRate"
                      min="0"
                      max="50"
                      value="18"
                      class="w-full accent-neutral-900 dark:accent-neutral-200 cursor-pointer h-1.5 bg-neutral-200 dark:bg-neutral-800 rounded-lg appearance-none"
                    />
                  </div>

                  <div>
                    <div class="flex justify-between items-center mb-1">
                      <label for="inputCustomerReturnRate" class="text-[10px] font-medium text-neutral-600 dark:text-neutral-400">Customer Return %</label>
                      <span id="customerReturnRateDisplay" class="text-[10px] font-mono font-semibold text-neutral-800 dark:text-neutral-200">10%</span>
                    </div>
                    <input
                      type="range"
                      id="inputCustomerReturnRate"
                      min="0"
                      max="40"
                      value="10"
                      class="w-full accent-neutral-900 dark:accent-neutral-200 cursor-pointer h-1.5 bg-neutral-200 dark:bg-neutral-800 rounded-lg appearance-none"
                    />
                  </div>
                </div>

                <div>
                  <label for="inputReturnReverseCost" class="block text-[10px] font-medium text-neutral-600 dark:text-neutral-400 mb-1">
                    Reverse Courier Penalty (₹ for buyer returns)
                  </label>
                  <input
                    type="number"
                    id="inputReturnReverseCost"
                    value="130"
                    class="w-full px-2.5 py-1.5 bg-neutral-50/50 dark:bg-neutral-800/50 border border-neutral-200 dark:border-white/[0.08] rounded-lg text-xs font-mono text-neutral-900 dark:text-white"
                  />
                </div>
              </div>

              <!-- Custom Overrides -->
              <div class="pt-2 border-t border-neutral-200/60 dark:border-white/[0.06]">
                <span class="text-xs font-semibold text-neutral-800 dark:text-neutral-200 block mb-2">Custom Fee Overrides</span>
                <div class="grid grid-cols-3 gap-2">
                  <div>
                    <label for="customCommInput" class="block text-[10px] font-medium text-neutral-500 mb-1">Commission %</label>
                    <input type="number" id="customCommInput" placeholder="Auto" class="w-full px-2 py-1.5 bg-neutral-50/50 dark:bg-neutral-800/50 border border-neutral-200 dark:border-white/[0.08] text-neutral-900 dark:text-white rounded-lg text-xs font-mono" />
                  </div>
                  <div>
                    <label for="customFixedFeeInput" class="block text-[10px] font-medium text-neutral-500 mb-1">Fixed Fee ₹</label>
                    <input type="number" id="customFixedFeeInput" placeholder="Auto" class="w-full px-2 py-1.5 bg-neutral-50/50 dark:bg-neutral-800/50 border border-neutral-200 dark:border-white/[0.08] text-neutral-900 dark:text-white rounded-lg text-xs font-mono" />
                  </div>
                  <div>
                    <label for="customShippingInput" class="block text-[10px] font-medium text-neutral-500 mb-1">Shipping ₹</label>
                    <input type="number" id="customShippingInput" placeholder="Auto" class="w-full px-2 py-1.5 bg-neutral-50/50 dark:bg-neutral-800/50 border border-neutral-200 dark:border-white/[0.08] text-neutral-900 dark:text-white rounded-lg text-xs font-mono" />
                  </div>
                </div>
                <p class="text-[10px] text-neutral-400 mt-1">Leave empty to use official 2026 platform slabs automatically.</p>
              </div>

            </div>
          </div>

        </form>
      </div>

      <!-- RIGHT COLUMN: Results Dashboard (7 Cols on LG) -->
      <div id="resultsDashboard" class="lg:col-span-7 space-y-4 sm:space-y-5 scroll-mt-20">
        
        <!-- 1. BIG HERO TAKE-HOME PROFIT CARD -->
        <div class="p-5 sm:p-6 rounded-2xl bg-emerald-50/70 dark:bg-emerald-950/20 border-2 border-emerald-500/30 dark:border-emerald-500/40 shadow-sm relative overflow-hidden">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold uppercase tracking-wider text-emerald-800 dark:text-emerald-300">
              Your Real In-Hand Profit
            </span>
            <span id="blendedMarginBadge" class="text-xs font-mono font-bold px-2.5 py-1 rounded-full bg-emerald-500/15 text-emerald-700 dark:text-emerald-300 border border-emerald-500/25">
              +24.5% margin
            </span>
          </div>
          
          <div class="mt-3 flex items-baseline gap-2">
            <span id="blendedProfitValue" class="text-3xl sm:text-4xl lg:text-5xl font-mono font-extrabold tracking-tight text-emerald-700 dark:text-emerald-400">
              ₹147.20
            </span>
            <span class="text-xs font-medium text-emerald-600/80 dark:text-emerald-400/70">per dispatched order</span>
          </div>

          <p class="text-xs text-neutral-600 dark:text-neutral-400 mt-2 flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span>What actually lands in your pocket after courier, marketplace fees, taxes &amp; return losses.</span>
          </p>

          <!-- 2 Secondary Sub-Stats -->
          <div class="grid grid-cols-2 gap-3 mt-4 pt-4 border-t border-emerald-500/20">
            <div>
              <span class="text-[11px] font-mono text-neutral-500 dark:text-neutral-400 uppercase tracking-wider block">Bank Settlement</span>
              <span id="bankSettlementValue" class="text-base sm:text-xl font-mono font-bold text-neutral-900 dark:text-white mt-0.5 block">
                ₹482.00
              </span>
              <span class="text-[10px] text-neutral-500">Deposited to bank account</span>
            </div>
            <div>
              <div class="flex items-center gap-1.5">
                <span class="text-[11px] font-mono text-neutral-500 dark:text-neutral-400 uppercase tracking-wider block">Delivered Profit</span>
                <span id="deliveredMarginBadge" class="text-[10px] font-mono font-medium px-1.5 py-0.2 rounded bg-neutral-200/60 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400">31.2%</span>
              </div>
              <span id="deliveredProfitValue" class="text-base sm:text-xl font-mono font-bold text-neutral-800 dark:text-neutral-200 mt-0.5 block">
                ₹187.00
              </span>
              <span class="text-[10px] text-neutral-500">If buyer keeps with no return</span>
            </div>
          </div>
        </div>

        <!-- 2. BEGINNER-FRIENDLY "WHERE YOUR MONEY GOES" SUMMARY -->
        <div class="card-ver p-4 sm:p-5 bg-white dark:bg-[#0b0b0b] border border-neutral-200 dark:border-white/[0.08] shadow-sm">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-xs font-semibold text-neutral-900 dark:text-white uppercase tracking-wider flex items-center gap-1.5">
              <span>Quick Money Summary</span>
              <span id="activeMpLabel" class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 font-normal">Meesho</span>
            </h3>
            <span class="text-[11px] text-neutral-400 font-mono">Simple Breakdown</span>
          </div>

          <div class="space-y-2 text-xs sm:text-sm">
            <div class="flex items-center justify-between py-1.5 px-2 rounded-lg bg-neutral-50/70 dark:bg-neutral-900/30">
              <span class="text-neutral-700 dark:text-neutral-300 font-medium">Customer Pays</span>
              <span id="summaryCustomerPays" class="font-mono font-bold text-neutral-900 dark:text-white">₹599.00</span>
