---
import { CATEGORIES } from '../data/categories';
import { MARKETPLACES } from '../data/marketplaces';

interface Props {
  initialMarketplace?: 'meesho' | 'flipkart' | 'amazon' | 'snapdeal' | 'myntra' | 'shopsy' | 'blinkit' | 'zepto';
  title?: string;
  subtitle?: string;
}

const {
  initialMarketplace = 'meesho',
  title = "Seller Profit Calculator",
  subtitle = "Calculate your exact in-hand profit and bank payout for Indian marketplaces."
} = Astro.props;
---

<section id="calculator" data-initial-mp={initialMarketplace} class="pt-6 sm:pt-10 pb-14 sm:pb-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <!-- Clean, Simple Header -->
    <div class="text-center max-w-xl mx-auto mb-6 sm:mb-8">
      <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-neutral-900">
        {title}
      </h1>
      <p class="mt-1.5 text-xs sm:text-sm text-neutral-500">
        {subtitle}
      </p>
    </div>

    <!-- Marketplace Tabs / Dedicated Page Links -->
    <div class="w-full flex flex-col items-start sm:items-center justify-center mb-6 sm:mb-8 overflow-hidden">
      <div class="w-full sm:w-auto flex p-1 rounded-xl bg-neutral-100 border border-neutral-200 overflow-x-auto touch-scroll no-scrollbar" id="marketplaceTabs">
        <a
          href="/meesho-profit-calculator"
          data-mp="meesho"
          class={`mp-tab whitespace-nowrap px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-medium transition-all ${
            initialMarketplace === 'meesho'
              ? 'bg-white text-neutral-900 shadow-xs font-semibold'
              : 'text-neutral-600 hover:text-neutral-900'
          }`}
        >
          Meesho
        </a>
        <a
          href="/flipkart-profit-calculator"
          data-mp="flipkart"
          class={`mp-tab whitespace-nowrap px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-medium transition-all ${
            initialMarketplace === 'flipkart'
              ? 'bg-white text-neutral-900 shadow-xs font-semibold'
              : 'text-neutral-600 hover:text-neutral-900'
          }`}
        >
          Flipkart
        </a>
        <a
          href="/amazon-profit-calculator"
          data-mp="amazon"
          class={`mp-tab whitespace-nowrap px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-medium transition-all ${
            initialMarketplace === 'amazon'
              ? 'bg-white text-neutral-900 shadow-xs font-semibold'
              : 'text-neutral-600 hover:text-neutral-900'
          }`}
        >
          Amazon India
        </a>
        <a
          href="/amazon-fba-calculator"
          data-mp="fba"
          class={`mp-tab whitespace-nowrap px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-medium transition-all ${
            initialMarketplace === 'fba'
              ? 'bg-white text-neutral-900 shadow-xs font-semibold'
              : 'text-neutral-600 hover:text-neutral-900'
          }`}
        >
          Amazon FBA
        </a>
      </div>
      <p class="mt-2 text-xs text-neutral-500 text-center" id="calcCardSubtitle">
        Zero referral commission model with weight-slab courier rates.
      </p>
    </div>

    <!-- Main Two-Column Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      
      <!-- LEFT COLUMN: Inputs (5 Cols) -->
      <div class="lg:col-span-5 bg-white border border-neutral-200 rounded-2xl p-4 sm:p-6 shadow-xs">
        
        <div class="flex items-center justify-between border-b border-neutral-100 pb-3 mb-4">
          <div>
            <h2 class="text-sm sm:text-base font-semibold text-neutral-900" id="calcCardTitle">
              Product Details
            </h2>
            <p class="text-[11px] text-neutral-400">Enter your selling price &amp; product cost</p>
          </div>
          <button type="button" id="resetBtn" class="text-xs font-medium text-neutral-500 hover:text-neutral-900 px-2 py-1 rounded-md hover:bg-neutral-100 transition min-h-[32px] inline-flex items-center">
            Reset
          </button>
        </div>

        <form id="calcForm" class="space-y-4" onsubmit="return false;">
          
          <!-- 1. Selling Price -->
          <div>
            <div class="flex items-center justify-between mb-1">
              <label for="inputSellingPrice" class="block text-xs sm:text-sm font-medium text-neutral-800">
                Selling Price (Customer MRP)
              </label>
              <span class="text-[11px] text-neutral-400 font-mono">Listed Price</span>
            </div>
            <div class="relative rounded-xl border border-neutral-300 bg-neutral-50/40 focus-within:border-neutral-900 focus-within:bg-white transition-all shadow-2xs">
              <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-neutral-500 font-bold text-base">
                ₹
              </span>
              <input
                type="text"
                id="inputSellingPrice"
                inputmode="decimal"
                value="599"
                placeholder="599"
                class="w-full pl-8 pr-4 py-3 bg-transparent rounded-xl text-base sm:text-lg font-mono font-semibold text-neutral-900 outline-none min-h-[46px]"
              />
            </div>
            <span class="text-[11px] text-neutral-500 mt-1 block">The price listed on the app that buyers pay.</span>
          </div>

          <!-- 2. Cost of Goods Sold -->
          <div>
            <div class="flex items-center justify-between mb-1">
              <label for="inputCogs" class="block text-xs sm:text-sm font-medium text-neutral-800">
                Product Cost (Purchase / Making)
              </label>
              <span class="text-[11px] text-neutral-400 font-mono">COGS</span>
            </div>
            <div class="relative rounded-xl border border-neutral-300 bg-white focus-within:border-neutral-900 transition-all shadow-2xs">
              <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-neutral-500 font-bold text-base">
                ₹
              </span>
              <input
                type="text"
                id="inputCogs"
                inputmode="decimal"
                value="220"
                placeholder="220"
                class="w-full pl-8 pr-4 py-3 bg-transparent rounded-xl text-base sm:text-lg font-mono font-semibold text-neutral-900 outline-none min-h-[46px]"
              />
            </div>
            <span class="text-[11px] text-neutral-500 mt-1 block">What you paid to buy or manufacture this item.</span>
          </div>

          <!-- 3. Category -->
          <div>
            <label for="selectCategory" class="block text-xs sm:text-sm font-medium text-neutral-800 mb-1">
              Product Category
            </label>
            <div class="relative">
              <select
                id="selectCategory"
                class="w-full px-3.5 py-3 bg-white border border-neutral-300 focus:border-neutral-900 rounded-xl text-base sm:text-sm text-neutral-800 outline-none cursor-pointer min-h-[46px] appearance-none pr-8"
              >
                {CATEGORIES.map((cat) => (
                  <option value={cat.id}>{cat.name}</option>
                ))}
              </select>
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-neutral-500">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </div>
            </div>
          </div>

          <!-- Collapsible: Advanced Settings -->
          <div class="border border-neutral-200 rounded-xl overflow-hidden pt-0.5">
            <button
              type="button"
              id="advancedSettingsToggleBtn"
              class="w-full px-4 py-3 flex items-center justify-between text-left text-xs sm:text-sm font-medium text-neutral-700 hover:bg-neutral-50 transition cursor-pointer min-h-[44px]"
            >
              <span class="flex items-center gap-1.5">
                <span>Additional Options</span>
                <span class="text-[11px] text-neutral-400 font-normal">(Weight, GST, Returns)</span>
              </span>
              <span id="advancedArrowText" class="text-xs text-neutral-500 font-mono font-medium">+ Expand</span>
            </button>

            <div id="advancedSettingsPanel" class="p-3.5 sm:p-4 border-t border-neutral-200 bg-neutral-50/50 space-y-3.5 hidden">
              
              <!-- Weight & Zone -->
              <div class="grid grid-cols-2 gap-2.5">
                <div>
                  <div class="flex justify-between text-xs text-neutral-600 mb-1">
                    <span>Weight</span>
                    <span id="weightDisplay" class="font-mono font-semibold">500g</span>
                  </div>
                  <input
                    type="number"
                    id="inputWeight"
                    value="500"
                    min="50"
                    step="50"
                    class="w-full px-3 py-2 bg-white border border-neutral-300 rounded-lg text-base sm:text-xs font-mono text-neutral-900 min-h-[40px] outline-none focus:border-neutral-900"
                  />
                </div>

                <div>
                  <label for="selectShippingZone" class="block text-xs text-neutral-600 mb-1">Distance</label>
                  <select
                    id="selectShippingZone"
                    class="w-full px-3 py-2 bg-white border border-neutral-300 rounded-lg text-base sm:text-xs text-neutral-800 min-h-[40px] outline-none focus:border-neutral-900"
                  >
                    <option value="local">Local</option>
                    <option value="regional">Regional</option>
                    <option value="national" selected>National</option>
                  </select>
                </div>
              </div>

              <!-- GST Rate & Packaging -->
              <div class="grid grid-cols-2 gap-2.5">
                <div>
                  <label for="inputProductGst" class="block text-xs text-neutral-600 mb-1">Product GST</label>
                  <select
                    id="inputProductGst"
                    class="w-full px-3 py-2 bg-white border border-neutral-300 rounded-lg text-base sm:text-xs font-mono text-neutral-800 min-h-[40px] outline-none focus:border-neutral-900"
                  >
                    <option value="0">0%</option>
                    <option value="3">3%</option>
                    <option value="5">5%</option>
                    <option value="12" selected>12%</option>
                    <option value="18">18%</option>
                    <option value="28">28%</option>
                  </select>
                </div>

                <div>
                  <label for="inputPackagingCost" class="block text-xs text-neutral-600 mb-1">Packaging (₹)</label>
                  <input
                    type="number"
                    id="inputPackagingCost"
                    value="15"
                    min="0"
                    class="w-full px-3 py-2 bg-white border border-neutral-300 rounded-lg text-base sm:text-xs font-mono text-neutral-900 min-h-[40px] outline-none focus:border-neutral-900"
                  />
                </div>
              </div>

              <!-- Ad Spend -->
              <div>
                <label for="inputAdSpend" class="block text-xs text-neutral-600 mb-1">Ad Spend Per Unit (₹, optional)</label>
                <input
                  type="number"
                  id="inputAdSpend"
                  value="0"
                  min="0"
                  class="w-full px-3 py-2 bg-white border border-neutral-300 rounded-lg text-base sm:text-xs font-mono text-neutral-900 min-h-[40px] outline-none focus:border-neutral-900"
                />
              </div>

              <!-- Returns -->
              <div class="pt-2 border-t border-neutral-200 space-y-2">
                <span class="text-xs font-semibold text-neutral-700 block">Returns &amp; RTO Rates</span>
                <div class="grid grid-cols-2 gap-2.5">
                  <div>
                    <div class="flex justify-between text-[11px] text-neutral-500 mb-1">
                      <span>RTO %</span>
                      <span id="rtoRateDisplay" class="font-mono font-medium">18%</span>
                    </div>
                    <input
                      type="range"
                      id="inputRtoRate"
                      min="0"
                      max="50"
                      value="18"
                      class="w-full accent-neutral-900 cursor-pointer h-2 bg-neutral-200 rounded-lg appearance-none py-1"
                    />
                  </div>
                  <div>
                    <div class="flex justify-between text-[11px] text-neutral-500 mb-1">
                      <span>Customer Return %</span>
                      <span id="customerReturnRateDisplay" class="font-mono font-medium">10%</span>
                    </div>
                    <input
                      type="range"
                      id="inputCustomerReturnRate"
                      min="0"
                      max="40"
                      value="10"
                      class="w-full accent-neutral-900 cursor-pointer h-2 bg-neutral-200 rounded-lg appearance-none py-1"
                    />
                  </div>
                </div>

                <div>
                  <label for="inputReturnReverseCost" class="block text-[11px] text-neutral-500 mb-1">Reverse Courier Charge per Return (₹)</label>
                  <input
                    type="number"
                    id="inputReturnReverseCost"
                    value="130"
                    class="w-full px-3 py-2 bg-white border border-neutral-300 rounded-lg text-base sm:text-xs font-mono text-neutral-900 min-h-[40px] outline-none focus:border-neutral-900"
                  />
                </div>
              </div>

              <!-- Overrides -->
              <div class="pt-2 border-t border-neutral-200">
                <span class="text-xs font-semibold text-neutral-700 block mb-1.5">Custom Fee Overrides (Optional)</span>
                <div class="grid grid-cols-3 gap-1.5">
                  <input type="number" id="customCommInput" placeholder="Comm %" class="w-full px-2.5 py-2 bg-white border border-neutral-300 text-base sm:text-xs font-mono rounded-lg min-h-[38px] outline-none focus:border-neutral-900" />
                  <input type="number" id="customFixedFeeInput" placeholder="Fixed ₹" class="w-full px-2.5 py-2 bg-white border border-neutral-300 text-base sm:text-xs font-mono rounded-lg min-h-[38px] outline-none focus:border-neutral-900" />
                  <input type="number" id="customShippingInput" placeholder="Ship ₹" class="w-full px-2.5 py-2 bg-white border border-neutral-300 text-base sm:text-xs font-mono rounded-lg min-h-[38px] outline-none focus:border-neutral-900" />
                </div>
              </div>

            </div>
          </div>

        </form>
      </div>

      <!-- RIGHT COLUMN: Results (7 Cols) -->
      <div id="resultsDashboard" class="lg:col-span-7 space-y-4">
        
        <!-- 1. Hero Take-Home Profit Card -->
        <div class="p-5 sm:p-6 rounded-2xl bg-white border-2 border-emerald-500/40 shadow-xs">
          <div class="flex items-center justify-between">
            <span class="text-xs font-medium uppercase tracking-wider text-emerald-800">
              Net In-Hand Profit
            </span>
            <span id="blendedMarginBadge" class="text-xs font-mono font-bold px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-700 border border-emerald-200">
              +24.5% margin
            </span>
          </div>
          
          <div class="mt-2.5 flex items-baseline gap-2">
            <span id="blendedProfitValue" class="text-3xl sm:text-4xl font-mono font-bold tracking-tight text-emerald-600">
              ₹147.20
            </span>
            <span class="text-xs text-neutral-400">take-home per order</span>
          </div>

          <div class="mt-4 pt-3 border-t border-neutral-100 flex flex-col sm:flex-row sm:items-center justify-between gap-1.5 sm:gap-0 text-xs text-neutral-600">
            <span>Bank Settlement: <strong id="bankSettlementValue" class="font-mono text-neutral-900 font-semibold">₹482.00</strong></span>
            <span>Delivered Profit: <strong id="deliveredProfitValue" class="font-mono text-neutral-900 font-semibold">₹187.00</strong> <span id="deliveredMarginBadge" class="text-[10px] text-neutral-400">(31.2%)</span></span>
          </div>
        </div>

        <!-- 2. Simple Receipt-Style Money Summary -->
        <div class="bg-white border border-neutral-200 rounded-2xl p-4 sm:p-5 shadow-xs">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-neutral-700 mb-3" id="activeMpLabel">
            Meesho Summary
          </h3>

          <div class="space-y-2 text-xs sm:text-[13px]">
            <div class="flex items-center justify-between py-1">
              <span class="text-neutral-600">Customer Pays</span>
              <span id="summaryCustomerPays" class="font-mono font-semibold text-neutral-900">₹599.00</span>
            </div>
            <div class="flex items-center justify-between py-1">
              <span class="text-neutral-600">Marketplace &amp; Courier Fees</span>
              <span id="summaryFees" class="font-mono text-rose-600">- ₹63.70</span>
            </div>
            <div class="flex items-center justify-between py-1">
              <span class="text-neutral-600">Product Cost</span>
              <span id="summaryCogs" class="font-mono text-neutral-700">- ₹220.00</span>
            </div>
            <div class="flex items-center justify-between py-1">
              <span class="text-neutral-600">Returns &amp; Reserve</span>
              <span id="summaryReturn" class="font-mono text-neutral-700">- ₹54.80</span>
            </div>
            <div class="flex items-center justify-between pt-2.5 border-t border-neutral-200 font-bold">
              <span class="text-neutral-900">Your Take-Home Profit</span>
              <span id="summaryProfit" class="font-mono text-base text-emerald-600">₹147.20</span>
            </div>
          </div>
        </div>

        <!-- 3. Collapsible Line-by-Line Breakdown -->
        <div class="border border-neutral-200 rounded-xl overflow-hidden bg-white">
          <button
            type="button"
            id="detailedBreakdownToggleBtn"
            class="w-full px-4 py-2.5 flex items-center justify-between text-left text-xs font-medium text-neutral-600 hover:bg-neutral-50 transition cursor-pointer"
          >
            <span>Detailed Fee &amp; Tax Breakdown</span>
            <span id="detailedArrowText" class="text-[11px] font-mono text-neutral-400">+ Expand</span>
          </button>

          <div id="detailedBreakdownPanel" class="border-t border-neutral-200 hidden">
            <div class="divide-y divide-neutral-100 text-xs">
              
              <div class="px-4 py-2 flex items-center justify-between">
                <span class="text-neutral-600">Selling Price</span>
                <span id="dtSellingPrice" class="font-mono font-medium text-neutral-900">₹599.00</span>
              </div>

              <div class="px-4 py-2 flex items-center justify-between">
                <span class="text-neutral-600">Base Price (Without Tax)</span>
                <span id="dtTaxableValue" class="font-mono text-neutral-600">₹534.82</span>
              </div>

              <div class="px-4 py-2 flex items-center justify-between">
                <span class="text-neutral-600">Product GST</span>
                <span id="dtProductGst" class="font-mono text-neutral-500">₹64.18</span>
              </div>

              <div class="px-4 py-2 flex items-center justify-between">
                <span class="text-neutral-600">Marketplace Commission (<span id="dtCommissionRate">0%</span>)</span>
                <span id="dtCommissionFee" class="font-mono text-neutral-800">₹0.00</span>
              </div>

              <div class="px-4 py-2 flex items-center justify-between">
                <span class="text-neutral-600">Fixed Closing Fee</span>
                <span id="dtFixedFee" class="font-mono text-neutral-600">₹0.00</span>
              </div>

              <div class="px-4 py-2 flex items-center justify-between">
                <span class="text-neutral-600">Payment Collection Fee</span>
                <span id="dtCollectionFee" class="font-mono text-neutral-600">₹0.00</span>
              </div>

              <div class="px-4 py-2 flex items-center justify-between">
                <span class="text-neutral-600">Courier Shipping Fee</span>
                <span id="dtShippingFee" class="font-mono text-neutral-800">₹49.00</span>
              </div>

              <div class="px-4 py-2 flex items-center justify-between">
                <span class="text-neutral-600">GST on Fees (18% ITC)</span>
                <span id="dtGstOnFees" class="font-mono text-neutral-600">₹8.82</span>
              </div>

              <div class="px-4 py-2 flex items-center justify-between">
                <span class="text-neutral-600">TCS (0.5%) + TDS (0.1%)</span>
                <span id="dtTcsTds" class="font-mono text-neutral-600">₹3.21</span>
              </div>

              <div class="px-4 py-2 flex items-center justify-between bg-neutral-50/50 font-medium">
                <span class="text-neutral-700">Total Deductions</span>
                <span id="dtTotalDeductions" class="font-mono text-rose-600">₹63.70</span>
              </div>

              <div class="px-4 py-2 flex items-center justify-between font-semibold">
                <span class="text-neutral-900">Bank Settlement</span>
                <span id="dtBankSettlement" class="font-mono text-neutral-900">₹535.30</span>
              </div>

              <div class="px-4 py-2 flex items-center justify-between text-neutral-500">
                <span>Product Cost (COGS)</span>
                <span id="dtCogs" class="font-mono">- ₹220.00</span>
              </div>

              <div class="px-4 py-2 flex items-center justify-between text-neutral-500">
                <span>Packaging &amp; Ads</span>
                <span id="dtPkgAds" class="font-mono">- ₹15.00</span>
              </div>

              <div class="px-4 py-2 flex items-center justify-between text-neutral-500">
                <span>Return &amp; RTO Loss Buffer</span>
                <span id="dtReturnLossBuffer" class="font-mono">- ₹39.80</span>
              </div>

              <div class="px-4 py-2.5 flex items-center justify-between bg-emerald-50 text-emerald-950 border-t border-emerald-200 font-bold">
                <span>True Net In-Hand Profit</span>
                <span id="dtFinalProfit" class="font-mono text-emerald-700 font-extrabold text-sm sm:text-base">₹260.50</span>
              </div>

            </div>
          </div>
        </div>

        <!-- Hidden span elements for legacy script hooks if needed -->
        <span id="dtTaxableGstBadge" class="hidden"></span>
        <span id="dtShippingWeightBadge" class="hidden"></span>

        <!-- 4. Simple Actions -->
        <div class="flex items-center gap-2 pt-1">
          <button
            type="button"
            id="copySummaryBtn"
            class="px-3.5 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold transition cursor-pointer shadow-xs min-h-[36px] inline-flex items-center"
          >
            Copy Summary
          </button>

          <div id="toastMessage" class="hidden text-xs font-mono px-2.5 py-1 rounded-md bg-emerald-700 text-white shadow-xs">
            Copied!
          </div>
        </div>

      </div>

    </div>

  </div>
</section>

<!-- CLIENT SCRIPT FOR INSTANT REACTIVE AUTO-CALCULATION & SMART PASTE -->
<script is:inline>
(function() {
  // Category rates map
  var CATEGORIES_DATA = {
    fashion: { meesho: 0, flipkart: 15.0, amazon: 13.5, snapdeal: 5.0, myntra: 18.0, shopsy: 0, blinkit: 18.0, zepto: 18.0, defaultGst: 12 },
    footwear: { meesho: 0, flipkart: 14.0, amazon: 12.0, snapdeal: 6.0, myntra: 16.0, shopsy: 0, blinkit: 16.0, zepto: 16.0, defaultGst: 12 },
    electronics_accessories: { meesho: 0, flipkart: 12.5, amazon: 14.0, snapdeal: 8.0, myntra: 15.0, shopsy: 5.0, blinkit: 16.0, zepto: 16.0, defaultGst: 18 },
    home_kitchen: { meesho: 0, flipkart: 11.0, amazon: 10.5, snapdeal: 7.0, myntra: 14.0, shopsy: 4.0, blinkit: 18.0, zepto: 18.0, defaultGst: 18 },
    beauty_grooming: { meesho: 0, flipkart: 9.0, amazon: 8.5, snapdeal: 6.0, myntra: 12.0, shopsy: 3.0, blinkit: 20.0, zepto: 20.0, defaultGst: 18 },
    jewellery_fashion: { meesho: 0, flipkart: 16.0, amazon: 15.0, snapdeal: 8.0, myntra: 20.0, shopsy: 5.0, blinkit: 18.0, zepto: 18.0, defaultGst: 3 },
    grocery_fmcg: { meesho: 0, flipkart: 6.5, amazon: 6.0, snapdeal: 4.0, myntra: 8.0, shopsy: 2.0, blinkit: 15.0, zepto: 15.0, defaultGst: 5 },
    toys_baby: { meesho: 0, flipkart: 10.5, amazon: 9.5, snapdeal: 6.0, myntra: 14.0, shopsy: 4.0, blinkit: 18.0, zepto: 18.0, defaultGst: 12 },
    books: { meesho: 0, flipkart: 9.0, amazon: 8.0, snapdeal: 5.0, myntra: 10.0, shopsy: 3.0, blinkit: 15.0, zepto: 15.0, defaultGst: 0 },
    custom: { meesho: 0, flipkart: 10.0, amazon: 10.0, snapdeal: 5.0, myntra: 15.0, shopsy: 5.0, blinkit: 18.0, zepto: 18.0, defaultGst: 18 }
  };

  var calcSection = document.getElementById('calculator');
  var currentMarketplace = (calcSection && calcSection.dataset.initialMp) ? calcSection.dataset.initialMp : 'meesho';

  // Helper functions
  function getAmazonClosingFee(price) {
    if (price <= 250) return 5;
    if (price <= 500) return 10;
    if (price <= 1000) return 25;
    if (price <= 2000) return 35;
    return 50;
  }

  function getFlipkartFixedFee(price) {
    if (price <= 300) return 13;
    if (price <= 500) return 17;
    if (price <= 1000) return 30;
    return 52;
  }

  function getShippingFee(mp, weightGrams, zone) {
    if (mp === 'meesho') {
      if (weightGrams <= 500) return 49;
      if (weightGrams <= 1000) return 85;
      if (weightGrams <= 1500) return 125;
      var extra = Math.ceil((weightGrams - 1500) / 500);
      return 125 + extra * 40;
    }
    if (mp === 'amazon') {
      var base = zone === 'local' ? 44 : zone === 'regional' ? 53 : 74;
      var addl = zone === 'local' ? 25 : zone === 'regional' ? 30 : 36;
      if (weightGrams <= 500) return base;
      var extra = Math.ceil((weightGrams - 500) / 500);
      return base + extra * addl;
    }
    if (mp === 'flipkart') {
      var base = zone === 'local' ? 44 : zone === 'regional' ? 54 : 69;
      var addl = zone === 'local' ? 22 : zone === 'regional' ? 26 : 32;
      if (weightGrams <= 500) return base;
      var extra = Math.ceil((weightGrams - 500) / 500);
      return base + extra * addl;
    }
    if (mp === 'myntra') {
      var base = 50;
      if (weightGrams <= 500) return base;
      return base + Math.ceil((weightGrams - 500) / 500) * 30;
    }
    if (mp === 'shopsy') {
      var base = 45;
      if (weightGrams <= 500) return base;
      return base + Math.ceil((weightGrams - 500) / 500) * 32;
    }
    if (mp === 'blinkit' || mp === 'zepto') {
      return 20;
    }
    return 55 + Math.ceil(Math.max(0, weightGrams - 500) / 500) * 35;
  }

  // Parse cleaned numeric float with validation against negative values
  function parseVal(el) {
    if (!el) return 0;
    var raw = el.value.toString().replace(/[₹,\s]/g, '');
    var val = parseFloat(raw);
    return isNaN(val) ? 0 : Math.max(0, val);
  }

  function formatCurrency(val) {
    return '₹' + (val || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  // Main Calculation Routine
  function calculate() {
    var sp = parseVal(document.getElementById('inputSellingPrice'));
    var cogs = parseVal(document.getElementById('inputCogs'));
    var category = document.getElementById('selectCategory').value;
    var gstRate = parseVal(document.getElementById('inputProductGst'));
    var weight = parseVal(document.getElementById('inputWeight')) || 500;
    var zone = document.getElementById('selectShippingZone').value;
    var pkg = parseVal(document.getElementById('inputPackagingCost'));
    var ads = parseVal(document.getElementById('inputAdSpend'));
    var rtoRate = parseVal(document.getElementById('inputRtoRate')) || 0;
    var returnRate = parseVal(document.getElementById('inputCustomerReturnRate')) || 0;
    var returnReverseCost = parseVal(document.getElementById('inputReturnReverseCost')) || 130;

    // Zero-price clean empty/reset state
    if (sp <= 0) {
      var bpValEl = document.getElementById('blendedProfitValue');
      if (bpValEl) {
        bpValEl.textContent = '₹0.00';
        bpValEl.className = 'text-3xl sm:text-4xl font-mono font-bold tracking-tight text-neutral-400';
      }
      var bpMarginEl = document.getElementById('blendedMarginBadge');
      if (bpMarginEl) {
        bpMarginEl.textContent = '0.0% margin';
        bpMarginEl.className = 'text-xs font-mono font-bold px-2 py-0.5 rounded-md bg-neutral-100 text-neutral-600 border border-neutral-200';
      }
      var bankEl = document.getElementById('bankSettlementValue');
      if (bankEl) bankEl.textContent = '₹0.00';
      var delivValEl = document.getElementById('deliveredProfitValue');
      if (delivValEl) delivValEl.textContent = '₹0.00';
      var sumPays = document.getElementById('summaryCustomerPays');
      if (sumPays) sumPays.textContent = '₹0.00';
      var sumFees = document.getElementById('summaryFees');
      if (sumFees) sumFees.textContent = '₹0.00';
      var sumCogs = document.getElementById('summaryCogs');
      if (sumCogs) sumCogs.textContent = '₹0.00';
      var sumReturn = document.getElementById('summaryReturn');
      if (sumReturn) sumReturn.textContent = '₹0.00';
      var sumProfit = document.getElementById('summaryProfit');
      if (sumProfit) {
        sumProfit.textContent = '₹0.00';
        sumProfit.className = 'font-mono text-base text-neutral-500 font-bold';
      }
      if (window.updateComparisonMatrix) {
        window.updateComparisonMatrix({ sellingPrice: 0, costOfGoods: cogs });
      }
      return;
    }

    // Overrides
    var customComm = document.getElementById('customCommInput').value;
    var customFixed = document.getElementById('customFixedFeeInput').value;
    var customShip = document.getElementById('customShippingInput').value;

    // 1. Taxable Value & Product GST
    var taxable = sp / (1 + gstRate / 100);
    var productGst = sp - taxable;

    // 2. Commission
    var catInfo = CATEGORIES_DATA[category] || CATEGORIES_DATA['fashion'];
    var commRate = customComm !== '' ? parseFloat(customComm) : (catInfo[currentMarketplace] !== undefined ? catInfo[currentMarketplace] : 10);
    var commAmount = taxable * (commRate / 100);

    // 3. Fixed Fee
    var fixedFee = 0;
    if (customFixed !== '') {
      fixedFee = parseFloat(customFixed);
    } else {
      if (currentMarketplace === 'amazon') fixedFee = getAmazonClosingFee(sp);
      else if (currentMarketplace === 'flipkart') fixedFee = getFlipkartFixedFee(sp);
      else if (currentMarketplace === 'meesho') fixedFee = 0;
      else if (currentMarketplace === 'myntra') fixedFee = sp <= 500 ? 15 : sp <= 1000 ? 25 : 40;
      else if (currentMarketplace === 'shopsy') fixedFee = sp <= 300 ? 0 : sp <= 500 ? 5 : 12;
      else if (currentMarketplace === 'blinkit' || currentMarketplace === 'zepto') fixedFee = 15;
      else fixedFee = 10;
    }

    // 4. Collection Fee (2% for Flipkart/Amazon/Myntra, 0 for others)
    var collectionFee = (currentMarketplace === 'flipkart' || currentMarketplace === 'amazon' || currentMarketplace === 'myntra') ? (sp * 0.02) : 0;

    // 5. Shipping
    var shippingFee = customShip !== '' ? parseFloat(customShip) : getShippingFee(currentMarketplace, weight, zone);

    // 6. Subtotal marketplace fees & 18% GST on fees
    var feesExGst = commAmount + fixedFee + collectionFee + shippingFee;
    var gstOnFees = feesExGst * 0.18;

    // 7. TCS & TDS (0.5% TCS + 0.1% TDS = 0.6% on taxable supplies under 2026 rules)
    var tcsTds = taxable * 0.006;

    // 8. Total Marketplace Deduction & Bank Settlement
    var totalDeductions = feesExGst + gstOnFees + tcsTds;
    var bankSettlement = Math.max(0, sp - totalDeductions);

    // 9. Pure Delivered Profit
    var deliveredProfit = taxable - cogs - feesExGst - pkg - ads;
    var deliveredMargin = sp > 0 ? (deliveredProfit / sp) * 100 : 0;

    // 10. RTO & Customer Return Loss Simulator
    var rtoCourierLoss = currentMarketplace === 'meesho' ? 0 : shippingFee;
    var rtoPackagingLoss = pkg + 10;
    var rtoLossPerOrder = rtoCourierLoss + rtoPackagingLoss;

    var custReturnCourierLoss = returnReverseCost;
    var custReturnDamageLoss = pkg + 15 + cogs * 0.05;
    var custReturnLossPerOrder = custReturnCourierLoss + custReturnDamageLoss;

    var deliveredRate = Math.max(0, 100 - rtoRate - returnRate) / 100;
    var rtoFraction = rtoRate / 100;
    var returnFraction = returnRate / 100;

    var returnLossBuffer = (rtoLossPerOrder * rtoFraction) + (custReturnLossPerOrder * returnFraction);
    var blendedProfit = (deliveredProfit * deliveredRate) - returnLossBuffer;
    var blendedMargin = sp > 0 ? (blendedProfit / sp) * 100 : 0;

    // Update Display values
    var weightDispEl = document.getElementById('weightDisplay');
    if (weightDispEl) weightDispEl.textContent = weight + 'g';
    var rtoDispEl = document.getElementById('rtoRateDisplay');
    if (rtoDispEl) rtoDispEl.textContent = rtoRate + '%';
    var retDispEl = document.getElementById('customerReturnRateDisplay');
    if (retDispEl) retDispEl.textContent = returnRate + '%';

    // Hero KPI: Real Take-Home Profit
    var bpValEl = document.getElementById('blendedProfitValue');
    if (bpValEl) {
      bpValEl.textContent = formatCurrency(blendedProfit);
      bpValEl.className = blendedProfit >= 0
        ? 'text-3xl sm:text-4xl font-mono font-bold tracking-tight text-emerald-600'
        : 'text-3xl sm:text-4xl font-mono font-bold tracking-tight text-rose-600';
    }

    var bpMarginEl = document.getElementById('blendedMarginBadge');
    if (bpMarginEl) {
      bpMarginEl.textContent = (blendedMargin >= 0 ? '+' : '') + blendedMargin.toFixed(1) + '% margin';
      bpMarginEl.className = blendedMargin >= 0 
        ? 'text-xs font-mono font-bold px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-700 border border-emerald-200'
        : 'text-xs font-mono font-bold px-2 py-0.5 rounded-md bg-rose-50 text-rose-700 border border-rose-200';
    }

    // Secondary KPIs
    var bankEl = document.getElementById('bankSettlementValue');
    if (bankEl) bankEl.textContent = formatCurrency(bankSettlement);

    var delivValEl = document.getElementById('deliveredProfitValue');
    if (delivValEl) delivValEl.textContent = formatCurrency(deliveredProfit);

    var delivMarginEl = document.getElementById('deliveredMarginBadge');
    if (delivMarginEl) delivMarginEl.textContent = '(' + deliveredMargin.toFixed(1) + '%)';

    // Simple Receipt Summary Card
    var sumSp = document.getElementById('summaryCustomerPays');
    if (sumSp) sumSp.textContent = formatCurrency(sp);

    var sumFees = document.getElementById('summaryFees');
    if (sumFees) sumFees.textContent = '- ' + formatCurrency(totalDeductions);

    var sumCogs = document.getElementById('summaryCogs');
    if (sumCogs) sumCogs.textContent = '- ' + formatCurrency(cogs);

    var sumReturn = document.getElementById('summaryReturn');
    if (sumReturn) sumReturn.textContent = '- ' + formatCurrency(returnLossBuffer + pkg + ads);

    var sumProfit = document.getElementById('summaryProfit');
    if (sumProfit) {
      sumProfit.textContent = formatCurrency(blendedProfit);
      sumProfit.className = blendedProfit >= 0
        ? 'font-mono text-base text-emerald-600 font-bold'
        : 'font-mono text-base text-rose-600 font-bold';
    }

    // Detailed Line-by-Line Table
    var dtSp = document.getElementById('dtSellingPrice');
    if (dtSp) dtSp.textContent = formatCurrency(sp);
    var dtTax = document.getElementById('dtTaxableValue');
    if (dtTax) dtTax.textContent = formatCurrency(taxable);
    var dtGst = document.getElementById('dtProductGst');
    if (dtGst) dtGst.textContent = formatCurrency(productGst);
    var dtCommR = document.getElementById('dtCommissionRate');
    if (dtCommR) dtCommR.textContent = commRate + '%';
    var dtCommF = document.getElementById('dtCommissionFee');
    if (dtCommF) dtCommF.textContent = formatCurrency(commAmount);
    var dtFixed = document.getElementById('dtFixedFee');
    if (dtFixed) dtFixed.textContent = formatCurrency(fixedFee);
    var dtColl = document.getElementById('dtCollectionFee');
    if (dtColl) dtColl.textContent = formatCurrency(collectionFee);
    var dtShip = document.getElementById('dtShippingFee');
    if (dtShip) dtShip.textContent = formatCurrency(shippingFee);
    var dtGstFees = document.getElementById('dtGstOnFees');
    if (dtGstFees) dtGstFees.textContent = formatCurrency(gstOnFees);
    var dtTcs = document.getElementById('dtTcsTds');
    if (dtTcs) dtTcs.textContent = formatCurrency(tcsTds);
    var dtTotDed = document.getElementById('dtTotalDeductions');
    if (dtTotDed) dtTotDed.textContent = formatCurrency(totalDeductions);
    var dtBank = document.getElementById('dtBankSettlement');
    if (dtBank) dtBank.textContent = formatCurrency(bankSettlement);
    var dtCogsEl = document.getElementById('dtCogs');
    if (dtCogsEl) dtCogsEl.textContent = '- ' + formatCurrency(cogs);
    var dtPkgEl = document.getElementById('dtPkgAds');
    if (dtPkgEl) dtPkgEl.textContent = '- ' + formatCurrency(pkg + ads);
    var dtRetEl = document.getElementById('dtReturnLossBuffer');
    if (dtRetEl) dtRetEl.textContent = '- ' + formatCurrency(returnLossBuffer);
    
    var finalProfitEl = document.getElementById('dtFinalProfit');
    if (finalProfitEl) {
      finalProfitEl.textContent = formatCurrency(blendedProfit);
      finalProfitEl.className = blendedProfit >= 0
        ? 'font-mono text-emerald-400 font-bold'
        : 'font-mono text-rose-400 font-bold';
    }

    // Trigger update on Comparison Matrix if present
    if (window.updateComparisonMatrix) {
      window.updateComparisonMatrix({
        sellingPrice: sp,
        costOfGoods: cogs,
        category: category,
        productGstRate: gstRate,
        weightGrams: weight,
        shippingZone: zone,
        packagingCost: pkg,
        adSpend: ads,
        rtoRate: rtoRate,
        customerReturnRate: returnRate,
        customerReturnReverseCost: returnReverseCost
      });
    }
  }

  // Set Marketplace Tab
  function setMarketplace(mp) {
    currentMarketplace = mp;
    document.querySelectorAll('.mp-tab').forEach(function(btn) {
      if (btn.dataset.mp === mp) {
        btn.className = 'mp-tab px-4 py-1.5 rounded-lg text-xs sm:text-sm font-medium transition-all bg-white text-neutral-900 shadow-xs';
      } else {
        btn.className = 'mp-tab px-4 py-1.5 rounded-lg text-xs sm:text-sm font-medium transition-all text-neutral-600 hover:text-neutral-900';
      }
    });

    var mpNames = {
      meesho: 'Meesho',
      flipkart: 'Flipkart',
      amazon: 'Amazon India',
      snapdeal: 'Snapdeal',
      myntra: 'Myntra',
      shopsy: 'Shopsy',
      blinkit: 'Blinkit',
      zepto: 'Zepto'
    };
    var mpSubtitles = {
      meesho: 'Zero referral commission model with weight-slab courier rates.',
      flipkart: 'Category referral commission (4-16%) + Fixed slab fees + Collection fees.',
      amazon: 'Amazon Easy Ship model with dynamic closing fee slabs.',
      snapdeal: 'Value commerce commission structure (0-10%).',
      myntra: 'Fashion & lifestyle referral fee (12-24%) + closing fee slabs.',
      shopsy: 'Value-first platform with 0% budget commission & low fixed fees.',
      blinkit: '10-minute quick commerce platform take-rate (15-25%) & dark store handling.',
      zepto: 'Quick commerce micro-fulfillment margin cut (14-22%) & inwarding.'
    };

    var mpDefaults = {
      meesho: { rto: 20, ret: 10, retCost: 130 },
      flipkart: { rto: 15, ret: 8, retCost: 130 },
      amazon: { rto: 12, ret: 7, retCost: 130 },
      snapdeal: { rto: 22, ret: 9, retCost: 130 },
      myntra: { rto: 10, ret: 25, retCost: 150 },
      shopsy: { rto: 24, ret: 10, retCost: 130 },
      blinkit: { rto: 1, ret: 2, retCost: 30 },
      zepto: { rto: 1, ret: 2, retCost: 30 }
    };

    if (mpDefaults[mp]) {
      var rtoInput = document.getElementById('inputRtoRate');
      var retInput = document.getElementById('inputCustomerReturnRate');
      var retCostInput = document.getElementById('inputReturnReverseCost');
      var rtoDisp = document.getElementById('rtoRateDisplay');
      var retDisp = document.getElementById('customerReturnRateDisplay');
      if (rtoInput) { rtoInput.value = mpDefaults[mp].rto; if (rtoDisp) rtoDisp.textContent = mpDefaults[mp].rto + '%'; }
      if (retInput) { retInput.value = mpDefaults[mp].ret; if (retDisp) retDisp.textContent = mpDefaults[mp].ret + '%'; }
      if (retCostInput) { retCostInput.value = mpDefaults[mp].retCost; }
    }

    var titleEl = document.getElementById('calcCardTitle');
    var subtitleEl = document.getElementById('calcCardSubtitle');
    var badgeEl = document.getElementById('activeMpLabel');

    if (titleEl) titleEl.textContent = (mpNames[mp] || mp) + ' Inputs';
    if (subtitleEl) subtitleEl.textContent = mpSubtitles[mp] || '';
    if (badgeEl) badgeEl.textContent = (mpNames[mp] || mp) + ' Summary';

    calculate();
  }

  // Expose for cross-component synchronization
  window.triggerCalculatorUpdate = calculate;

  // Setup Event Listeners
  function initCalculator() {
    var priceInput = document.getElementById('inputSellingPrice');

    // Smart Paste Listener
    if (priceInput) {
      priceInput.addEventListener('paste', function(e) {
        var pastedText = (e.clipboardData || window.clipboardData).getData('text');
        var cleaned = pastedText.replace(/[₹,\s]/g, '');
        var num = parseFloat(cleaned);
        if (!isNaN(num)) {
          e.preventDefault();
          priceInput.value = num;
          calculate();
        }
      });
    }

    // Attach input listeners
    var inputs = [
      'inputSellingPrice', 'inputCogs', 'selectCategory', 'inputProductGst',
      'inputWeight', 'selectShippingZone', 'inputPackagingCost', 'inputAdSpend',
      'inputRtoRate', 'inputCustomerReturnRate', 'inputReturnReverseCost',
      'customCommInput', 'customFixedFeeInput', 'customShippingInput'
    ];

    inputs.forEach(function(id) {
      var el = document.getElementById(id);
      if (el) {
        el.addEventListener('input', calculate);
        el.addEventListener('change', calculate);
      }
    });

    // Auto-update default GST when Category changes
    var catSelect = document.getElementById('selectCategory');
    if (catSelect) {
      catSelect.addEventListener('change', function() {
        var catId = catSelect.value;
        if (CATEGORIES_DATA[catId]) {
          var gstInput = document.getElementById('inputProductGst');
          if (gstInput) gstInput.value = CATEGORIES_DATA[catId].defaultGst;
        }
        calculate();
      });
    }

    // Tab buttons
    document.querySelectorAll('.mp-tab').forEach(function(btn) {
      btn.addEventListener('click', function() {
        setMarketplace(btn.dataset.mp);
      });
    });

    // Advanced Settings Accordion Toggle
    var advToggle = document.getElementById('advancedSettingsToggleBtn');
    var advPanel = document.getElementById('advancedSettingsPanel');
    var advText = document.getElementById('advancedArrowText');
    if (advToggle && advPanel) {
      advToggle.addEventListener('click', function() {
        var isHidden = advPanel.classList.toggle('hidden');
        if (advText) {
          advText.textContent = isHidden ? '+ Expand' : '− Collapse';
        }
      });
    }

    // Detailed Breakdown Accordion Toggle
    var detToggle = document.getElementById('detailedBreakdownToggleBtn');
    var detPanel = document.getElementById('detailedBreakdownPanel');
    var detText = document.getElementById('detailedArrowText');
    if (detToggle && detPanel) {
      detToggle.addEventListener('click', function() {
        var isHidden = detPanel.classList.toggle('hidden');
        if (detText) {
          detText.textContent = isHidden ? '+ Expand' : '− Collapse';
        }
      });
    }

    // Reset button
    var resetBtn = document.getElementById('resetBtn');
    if (resetBtn) {
      resetBtn.addEventListener('click', function() {
        document.getElementById('inputSellingPrice').value = '599';
        document.getElementById('inputCogs').value = '220';
        document.getElementById('selectCategory').value = 'fashion';
        document.getElementById('inputProductGst').value = '12';
        document.getElementById('inputWeight').value = '500';
        document.getElementById('selectShippingZone').value = 'national';
        document.getElementById('inputPackagingCost').value = '15';
        document.getElementById('inputAdSpend').value = '0';
        document.getElementById('inputRtoRate').value = '18';
        document.getElementById('inputCustomerReturnRate').value = '10';
        document.getElementById('inputReturnReverseCost').value = '130';
        document.getElementById('customCommInput').value = '';
        document.getElementById('customFixedFeeInput').value = '';
        document.getElementById('customShippingInput').value = '';
        calculate();
      });
    }

    // Get Calculation Summary Text
    function getSummaryText() {
      var sp = document.getElementById('inputSellingPrice').value;
      var profit = document.getElementById('blendedProfitValue').textContent.trim();
      var margin = document.getElementById('blendedMarginBadge').textContent.trim();
      var settlement = document.getElementById('bankSettlementValue').textContent.trim();

      return [
        'Seller Profit Calculation (' + currentMarketplace.toUpperCase() + ')',
        '- Selling Price: ₹' + sp,
        '- Bank Settlement: ' + settlement,
        '- Real In-Hand Profit: ' + profit + ' (' + margin + ')',
        '- Calculated on: https://freesellerprofitcalculator.in'
      ].join('\n');
    }

    // Copy Summary Button
    var copyBtn = document.getElementById('copySummaryBtn');
    var toast = document.getElementById('toastMessage');
    if (copyBtn) {
      copyBtn.addEventListener('click', function() {
        var summaryText = getSummaryText();
        navigator.clipboard.writeText(summaryText).then(function() {
          if (toast) {
            toast.classList.remove('hidden');
            setTimeout(function() { toast.classList.add('hidden'); }, 2000);
          }
        });
      });
    }

    // Initial Run for selected marketplace
    setMarketplace(currentMarketplace);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCalculator);
  } else {
    initCalculator();
  }
})();
</script>
