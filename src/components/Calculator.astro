---
import { CATEGORIES } from '../data/categories';
import { MARKETPLACES } from '../data/marketplaces';
import { useTranslations } from '../i18n/utils';
import type { SupportedLanguage } from '../i18n/ui';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<section id="calculator" class="pt-4 sm:pt-6 pb-16 lg:pb-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Hero Header -->
    <div class="text-center max-w-3xl mx-auto mb-5 sm:mb-7">
      <h1 class="text-2xl sm:text-3xl lg:text-[2.25rem] font-semibold tracking-[-0.03em] text-neutral-900 dark:text-white leading-tight">
        {t("hero.title")}
      </h1>
      <p class="mt-1.5 text-xs sm:text-[13px] text-neutral-500 dark:text-neutral-400 max-w-lg mx-auto leading-relaxed">
        {t("hero.subtitle")}
      </p>
    </div>

    <!-- Marketplace Navigation Tabs -->
    <div class="flex items-center justify-center mb-6 sm:mb-8 px-1">
      <div class="inline-flex p-1 rounded-xl bg-neutral-100/80 dark:bg-neutral-900/70 border border-black/[0.04] dark:border-white/[0.06] max-w-full overflow-x-auto no-scrollbar scroll-smooth whitespace-nowrap" id="marketplaceTabs">
        <button
          type="button"
          data-mp="meesho"
          class="mp-tab shrink-0 px-3.5 py-1.5 min-h-[38px] rounded-lg text-xs sm:text-[13px] font-medium transition-all flex items-center gap-2 bg-white dark:bg-neutral-800 text-neutral-900 dark:text-white shadow-2xs border border-black/[0.05] dark:border-white/[0.08]"
        >
          <span class="w-2 h-2 rounded-full bg-pink-500"></span>
          <span>Meesho</span>
          <span class="text-[10px] font-mono text-neutral-400 dark:text-neutral-500 font-normal">0%</span>
        </button>

        <button
          type="button"
          data-mp="flipkart"
          class="mp-tab shrink-0 px-3.5 py-1.5 min-h-[38px] rounded-lg text-xs sm:text-[13px] font-medium transition-all flex items-center gap-2 text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white"
        >
          <span class="w-2 h-2 rounded-full bg-blue-600"></span>
          <span>Flipkart</span>
          <span class="text-[10px] font-mono text-neutral-400 dark:text-neutral-500 font-normal">4-16%</span>
        </button>

        <button
          type="button"
          data-mp="amazon"
          class="mp-tab shrink-0 px-3.5 py-1.5 min-h-[38px] rounded-lg text-xs sm:text-[13px] font-medium transition-all flex items-center gap-2 text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white"
        >
          <span class="w-2 h-2 rounded-full bg-amber-500"></span>
          <span>Amazon</span>
          <span class="text-[10px] font-mono text-neutral-400 dark:text-neutral-500 font-normal">5-15%</span>
        </button>

        <button
          type="button"
          data-mp="snapdeal"
          class="mp-tab shrink-0 px-3.5 py-1.5 min-h-[38px] rounded-lg text-xs sm:text-[13px] font-medium transition-all flex items-center gap-2 text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white"
        >
          <span class="w-2 h-2 rounded-full bg-red-500"></span>
          <span>Snapdeal</span>
        </button>
      </div>
    </div>

    <!-- SIMPLE 3-STEP GUIDE FOR NEW USERS -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-6 sm:mb-8">
      <div class="p-3.5 rounded-xl bg-white dark:bg-[#0b0b0b] border border-black/[0.06] dark:border-white/[0.08] flex items-start gap-3">
        <span class="w-6 h-6 rounded-full bg-neutral-100 dark:bg-neutral-800 text-neutral-800 dark:text-neutral-200 font-mono text-xs font-bold flex items-center justify-center shrink-0">1</span>
        <div>
          <div class="text-xs font-semibold text-neutral-900 dark:text-white">Enter Your Prices</div>
          <div class="text-[11px] text-neutral-500 dark:text-neutral-400 mt-0.5">Input your selling price and what you paid for the product.</div>
        </div>
      </div>
      <div class="p-3.5 rounded-xl bg-white dark:bg-[#0b0b0b] border border-black/[0.06] dark:border-white/[0.08] flex items-start gap-3">
        <span class="w-6 h-6 rounded-full bg-neutral-100 dark:bg-neutral-800 text-neutral-800 dark:text-neutral-200 font-mono text-xs font-bold flex items-center justify-center shrink-0">2</span>
        <div>
          <div class="text-xs font-semibold text-neutral-900 dark:text-white">Pick Platform &amp; Category</div>
          <div class="text-[11px] text-neutral-500 dark:text-neutral-400 mt-0.5">Switch between Meesho, Flipkart, and Amazon with exact 2026 fee slabs.</div>
        </div>
      </div>
      <div class="p-3.5 rounded-xl bg-white dark:bg-[#0b0b0b] border border-black/[0.06] dark:border-white/[0.08] flex items-start gap-3">
        <span class="w-6 h-6 rounded-full bg-neutral-100 dark:bg-neutral-800 text-neutral-800 dark:text-neutral-200 font-mono text-xs font-bold flex items-center justify-center shrink-0">3</span>
        <div>
          <div class="text-xs font-semibold text-neutral-900 dark:text-white">See Real In-Hand Profit</div>
          <div class="text-[11px] text-neutral-500 dark:text-neutral-400 mt-0.5">Get your true take-home earnings after courier, tax, and return losses.</div>
        </div>
      </div>
    </div>

    <!-- Main Two-Column Layout: Inputs on Left, Results Dashboard on Right -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- LEFT COLUMN: Inputs Card (5 Cols on LG) -->
      <div class="lg:col-span-5 card-ver p-4 sm:p-6 bg-white dark:bg-[#0b0b0b] border border-black/[0.06] dark:border-white/[0.08] shadow-[0_2px_12px_-4px_rgba(0,0,0,0.03),0_1px_2px_rgba(0,0,0,0.02)]">
        
        <div class="flex items-center justify-between border-b border-black/[0.05] dark:border-white/[0.06] pb-3.5 mb-5">
          <div>
            <h2 class="text-sm font-semibold text-neutral-900 dark:text-white tracking-tight flex items-center gap-2" id="calcCardTitle">
              Meesho Profit Inputs
            </h2>
            <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5" id="calcCardSubtitle">
              Zero referral commission model with weight-slab courier rates.
            </p>
          </div>
          <button type="button" id="resetBtn" class="text-xs text-neutral-400 hover:text-neutral-800 dark:hover:text-neutral-200 transition font-mono flex items-center gap-1.5 py-1 px-2 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800/60 cursor-pointer">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
            <span>Reset</span>
          </button>
        </div>

        <form id="calcForm" class="space-y-4" onsubmit="return false;">
          
          <!-- SELLING PRICE (HERO INPUT WITH AUTO-PASTE HANDLING) -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="inputSellingPrice" class="text-[11px] font-medium uppercase tracking-wider text-neutral-600 dark:text-neutral-400 flex items-center gap-1.5">
                Selling Price (MRP / Listed)
                <span class="text-rose-500">*</span>
              </label>
              <span class="text-[10px] text-neutral-400 font-mono">Includes GST</span>
            </div>
            <div class="relative rounded-xl border border-black/[0.08] dark:border-white/[0.1] bg-neutral-50/50 dark:bg-neutral-900/40 focus-within:border-black dark:focus-within:border-white focus-within:bg-white dark:focus-within:bg-black focus-within:ring-2 focus-within:ring-black/5 dark:focus-within:ring-white/10 transition-all shadow-2xs">
              <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-neutral-400 dark:text-neutral-500 font-medium text-base">
                ₹
              </div>
              <input
                type="text"
                id="inputSellingPrice"
                inputmode="decimal"
                value="599"
                placeholder="e.g. 599"
                class="w-full pl-8 pr-4 py-2.5 bg-transparent rounded-xl text-base sm:text-lg font-mono font-semibold text-neutral-900 dark:text-white outline-none"
              />
            </div>
            <p class="text-[11px] text-neutral-400 dark:text-neutral-500 mt-1">Accepts any format (e.g. <span class="font-mono">₹599.00</span> or <span class="font-mono">1,250</span>) &mdash; auto calculated.</p>
          </div>

          <!-- COST OF GOODS SOLD (COGS) -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="inputCogs" class="text-[11px] font-medium uppercase tracking-wider text-neutral-600 dark:text-neutral-400">
                Product Cost (COGS)
              </label>
              <span class="text-[10px] text-neutral-400 font-mono">Purchase / Mfg</span>
            </div>
            <div class="relative rounded-xl border border-black/[0.07] dark:border-white/[0.08] bg-white dark:bg-neutral-900/50 focus-within:border-black dark:focus-within:border-white focus-within:ring-1 focus-within:ring-black/5 dark:focus-within:ring-white/10 transition-all">
              <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-neutral-400 font-medium text-sm">
                ₹
              </div>
              <input
                type="text"
                id="inputCogs"
                inputmode="decimal"
                value="220"
                placeholder="220"
                class="w-full pl-8 pr-4 py-2 bg-transparent rounded-xl text-sm font-mono text-neutral-900 dark:text-white outline-none"
              />
            </div>
          </div>

          <!-- PRODUCT CATEGORY & PRODUCT GST -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
            <div>
              <label for="selectCategory" class="block text-[11px] font-medium uppercase tracking-wider text-neutral-600 dark:text-neutral-400 mb-1.5">
                Category
              </label>
              <select
                id="selectCategory"
                class="w-full px-3 py-2 bg-white dark:bg-neutral-900/50 border border-black/[0.07] dark:border-white/[0.08] focus:border-black dark:focus:border-white focus:ring-1 focus:ring-black/5 dark:focus:ring-white/10 rounded-xl text-xs sm:text-sm text-neutral-800 dark:text-neutral-200 transition outline-none cursor-pointer"
              >
                {CATEGORIES.map((cat) => (
                  <option value={cat.id} class="bg-white dark:bg-[#141414] text-neutral-900 dark:text-neutral-100">{cat.name}</option>
                ))}
              </select>
            </div>

            <div>
              <label for="inputProductGst" class="block text-[11px] font-medium uppercase tracking-wider text-neutral-600 dark:text-neutral-400 mb-1.5">
                Product GST Rate
              </label>
              <div class="relative">
                <select
                  id="inputProductGst"
                  class="w-full px-3 py-2 bg-white dark:bg-neutral-900/50 border border-black/[0.07] dark:border-white/[0.08] focus:border-black dark:focus:border-white focus:ring-1 focus:ring-black/5 dark:focus:ring-white/10 rounded-xl text-xs sm:text-sm font-mono text-neutral-800 dark:text-neutral-200 transition outline-none cursor-pointer"
                >
                  <option value="0" class="bg-white dark:bg-[#141414] text-neutral-900 dark:text-neutral-100">0% (Books / Exempt)</option>
                  <option value="3" class="bg-white dark:bg-[#141414] text-neutral-900 dark:text-neutral-100">3% (Jewellery)</option>
                  <option value="5" class="bg-white dark:bg-[#141414] text-neutral-900 dark:text-neutral-100">5% (Grocery / &lt;1k)</option>
                  <option value="12" selected class="bg-white dark:bg-[#141414] text-neutral-900 dark:text-neutral-100">12% (Apparel / Shoes)</option>
                  <option value="18" class="bg-white dark:bg-[#141414] text-neutral-900 dark:text-neutral-100">18% (Electronics / Standard)</option>
                  <option value="28" class="bg-white dark:bg-[#141414] text-neutral-900 dark:text-neutral-100">28% (Luxury)</option>
                </select>
              </div>
            </div>
          </div>

          <!-- SHIPPING WEIGHT & SHIPPING ZONE -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
            <div>
              <div class="flex items-center justify-between mb-1.5">
                <label for="inputWeight" class="text-[11px] font-medium uppercase tracking-wider text-neutral-600 dark:text-neutral-400">
                  Weight (Grams)
                </label>
                <span id="weightDisplay" class="text-[11px] font-mono text-neutral-500">500g</span>
              </div>
              <input
                type="number"
                id="inputWeight"
                value="500"
                min="50"
                step="50"
                class="w-full px-3 py-2 bg-white dark:bg-neutral-900/50 border border-black/[0.07] dark:border-white/[0.08] focus:border-black dark:focus:border-white focus:ring-1 focus:ring-black/5 dark:focus:ring-white/10 rounded-xl text-sm font-mono text-neutral-900 dark:text-white transition outline-none"
              />
            </div>

            <div>
              <label for="selectShippingZone" class="block text-[11px] font-medium uppercase tracking-wider text-neutral-600 dark:text-neutral-400 mb-1.5">
                Delivery Distance
              </label>
              <select
                id="selectShippingZone"
                class="w-full px-3 py-2 bg-white dark:bg-neutral-900/50 border border-black/[0.07] dark:border-white/[0.08] focus:border-black dark:focus:border-white focus:ring-1 focus:ring-black/5 dark:focus:ring-white/10 rounded-xl text-xs sm:text-sm text-neutral-800 dark:text-neutral-200 transition outline-none cursor-pointer"
              >
                <option value="local" class="bg-white dark:bg-[#141414] text-neutral-900 dark:text-neutral-100">Local (City)</option>
                <option value="regional" class="bg-white dark:bg-[#141414] text-neutral-900 dark:text-neutral-100">Regional (Zone)</option>
                <option value="national" selected class="bg-white dark:bg-[#141414] text-neutral-900 dark:text-neutral-100">National (Inter-State)</option>
              </select>
            </div>
          </div>

          <!-- PACKAGING COST & AD SPEND PER UNIT -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
            <div>
              <label for="inputPackagingCost" class="block text-[11px] font-medium uppercase tracking-wider text-neutral-600 dark:text-neutral-400 mb-1.5">
                Packaging Material
              </label>
              <div class="relative rounded-xl border border-black/[0.07] dark:border-white/[0.08] bg-white dark:bg-neutral-900/50 focus-within:border-black dark:focus-within:border-white focus-within:ring-1 focus-within:ring-black/5 dark:focus-within:ring-white/10 transition-all">
                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-neutral-400 font-mono text-xs">
                  ₹
                </div>
                <input
                  type="number"
                  id="inputPackagingCost"
                  value="15"
                  min="0"
                  class="w-full pl-7 pr-3 py-2 bg-transparent rounded-xl text-xs sm:text-sm font-mono text-neutral-900 dark:text-white outline-none"
                />
              </div>
            </div>

            <div>
              <label for="inputAdSpend" class="block text-[11px] font-medium uppercase tracking-wider text-neutral-600 dark:text-neutral-400 mb-1.5">
                Ad Spend / CAC (Optional)
              </label>
              <div class="relative rounded-xl border border-black/[0.07] dark:border-white/[0.08] bg-white dark:bg-neutral-900/50 focus-within:border-black dark:focus-within:border-white focus-within:ring-1 focus-within:ring-black/5 dark:focus-within:ring-white/10 transition-all">
                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-neutral-400 font-mono text-xs">
                  ₹
                </div>
                <input
                  type="number"
                  id="inputAdSpend"
                  value="0"
                  min="0"
                  placeholder="0"
                  class="w-full pl-7 pr-3 py-2 bg-transparent rounded-xl text-xs sm:text-sm font-mono text-neutral-900 dark:text-white outline-none"
                />
              </div>
            </div>
          </div>

          <!-- ADVANCED ACCORDION 1: RTO & CUSTOMER RETURN LOSS SIMULATOR -->
          <div class="border border-black/[0.06] dark:border-white/[0.07] rounded-xl overflow-hidden bg-transparent">
            <button
              type="button"
              id="returnToggleBtn"
              class="w-full px-3.5 py-2.5 flex items-center justify-between text-left text-xs font-medium text-neutral-700 dark:text-neutral-300 hover:bg-black/[0.02] dark:hover:bg-white/[0.03] transition cursor-pointer"
            >
              <span class="flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-neutral-400 dark:text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                <span>RTO &amp; Customer Return Simulator</span>
              </span>
              <span class="text-[11px] font-mono text-neutral-400 dark:text-neutral-500 flex items-center gap-1">
                <span>Configure</span>
                <svg class="w-3 h-3 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </span>
            </button>

            <div id="returnSettingsPanel" class="p-3.5 border-t border-black/[0.05] dark:border-white/[0.06] bg-neutral-50/50 dark:bg-neutral-900/30 space-y-3 hidden">
              <p class="text-[11px] text-neutral-500 dark:text-neutral-400 leading-normal">
                Models unrecoverable forward &amp; reverse courier charges on COD returns into your blended profit.
              </p>

              <div class="grid grid-cols-2 gap-3">
                <div>
                  <div class="flex justify-between items-center mb-1">
                    <label for="inputRtoRate" class="text-[10px] font-medium text-neutral-600 dark:text-neutral-400">RTO %</label>
                    <span id="rtoRateDisplay" class="text-[10px] font-mono font-semibold text-neutral-800 dark:text-neutral-200">18%</span>
                  </div>
                  <input
                    type="range"
                    id="inputRtoRate"
                    min="0"
                    max="50"
                    value="18"
                    class="w-full accent-neutral-900 dark:accent-neutral-200 cursor-pointer h-1.5 bg-neutral-200 dark:bg-neutral-800 rounded-lg appearance-none"
                  />
                  <span class="text-[9px] text-neutral-400">Undelivered</span>
                </div>

                <div>
                  <div class="flex justify-between items-center mb-1">
                    <label for="inputCustomerReturnRate" class="text-[10px] font-medium text-neutral-600 dark:text-neutral-400">Cust. Return %</label>
                    <span id="customerReturnRateDisplay" class="text-[10px] font-mono font-semibold text-neutral-800 dark:text-neutral-200">10%</span>
                  </div>
                  <input
                    type="range"
                    id="inputCustomerReturnRate"
                    min="0"
                    max="40"
                    value="10"
                    class="w-full accent-neutral-900 dark:accent-neutral-200 cursor-pointer h-1.5 bg-neutral-200 dark:bg-neutral-800 rounded-lg appearance-none"
                  />
                  <span class="text-[9px] text-neutral-400">Buyer returned</span>
                </div>
              </div>

              <div>
                <label for="inputReturnReverseCost" class="block text-[10px] font-medium text-neutral-600 dark:text-neutral-400 mb-1">
                  Return Penalty (₹ reverse courier)
                </label>
                <input
                  type="number"
                  id="inputReturnReverseCost"
                  value="130"
                  class="w-full px-2.5 py-1.5 bg-white dark:bg-neutral-900/60 border border-black/[0.07] dark:border-white/[0.08] rounded-lg text-xs font-mono text-neutral-900 dark:text-white"
                />
              </div>
            </div>
          </div>

          <!-- ADVANCED ACCORDION 2: CUSTOM FEE OVERRIDES -->
          <div class="border border-black/[0.06] dark:border-white/[0.07] rounded-xl overflow-hidden bg-transparent">
            <button
              type="button"
              id="feeOverridesToggleBtn"
              class="w-full px-3.5 py-2.5 flex items-center justify-between text-left text-xs font-medium text-neutral-700 dark:text-neutral-300 hover:bg-black/[0.02] dark:hover:bg-white/[0.03] transition cursor-pointer"
            >
              <span class="flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-neutral-400 dark:text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path></svg>
                <span>Custom Fee Overrides</span>
              </span>
              <span class="text-neutral-400 dark:text-neutral-500 text-[11px] font-mono">+ Customize</span>
            </button>

            <div id="feeOverridesPanel" class="p-3.5 border-t border-black/[0.05] dark:border-white/[0.06] bg-neutral-50/50 dark:bg-neutral-900/30 space-y-2.5 hidden">
              <div class="grid grid-cols-3 gap-2">
                <div>
                  <label for="customCommInput" class="block text-[10px] font-medium text-neutral-500 dark:text-neutral-400 mb-1">Commission %</label>
                  <input type="number" id="customCommInput" placeholder="Auto" class="w-full px-2 py-1.5 bg-white dark:bg-neutral-900/60 border border-black/[0.07] dark:border-white/[0.08] text-neutral-900 dark:text-white rounded-lg text-xs font-mono" />
                </div>
                <div>
                  <label for="customFixedFeeInput" class="block text-[10px] font-medium text-neutral-500 dark:text-neutral-400 mb-1">Fixed Fee ₹</label>
                  <input type="number" id="customFixedFeeInput" placeholder="Auto" class="w-full px-2 py-1.5 bg-white dark:bg-neutral-900/60 border border-black/[0.07] dark:border-white/[0.08] text-neutral-900 dark:text-white rounded-lg text-xs font-mono" />
                </div>
                <div>
                  <label for="customShippingInput" class="block text-[10px] font-medium text-neutral-500 dark:text-neutral-400 mb-1">Shipping ₹</label>
                  <input type="number" id="customShippingInput" placeholder="Auto" class="w-full px-2 py-1.5 bg-white dark:bg-neutral-900/60 border border-black/[0.07] dark:border-white/[0.08] text-neutral-900 dark:text-white rounded-lg text-xs font-mono" />
                </div>
              </div>
              <p class="text-[10px] text-neutral-400">Leave blank to use standard 2026 marketplace slab rates automatically.</p>
            </div>
          </div>

        </form>
      </div>

      <!-- RIGHT COLUMN: Results Dashboard (7 Cols on LG) -->
      <div id="resultsDashboard" class="lg:col-span-7 space-y-4 sm:space-y-5 scroll-mt-20">
        
        <!-- TOP SUMMARY KPI CARDS -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 sm:gap-3.5">
          
          <!-- KPI 1: BLENDED NET PROFIT (HERO NUMBER) -->
