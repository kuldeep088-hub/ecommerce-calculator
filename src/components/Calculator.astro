---
import { CATEGORIES } from '../data/categories';
import { MARKETPLACES } from '../data/marketplaces';
import { useTranslations } from '../i18n/utils';
import type { SupportedLanguage } from '../i18n/ui';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<section id="calculator" class="pt-8 pb-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Hero Header -->
    <div class="text-center max-w-3xl mx-auto mb-10">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tight text-[#171717] dark:text-white leading-[1.15]">
        {t("hero.title")}
      </h1>
      <p class="mt-4 text-base sm:text-lg text-[#737373] dark:text-neutral-400 max-w-2xl mx-auto">
        {t("hero.subtitle")}
      </p>

      <!-- Quick Preset Chips -->
      <div class="flex flex-wrap items-center justify-center gap-2 mt-6">
        <span class="text-xs text-neutral-400 font-mono">{t("hero.presets")}</span>
        <button type="button" class="preset-btn px-2.5 py-1 text-xs rounded-full bg-white dark:bg-[#111111] border border-[#ebebeb] dark:border-[#262626] hover:border-neutral-400 dark:hover:border-neutral-600 text-neutral-700 dark:text-neutral-300 transition" data-price="499" data-cogs="180" data-cat="fashion" data-wt="350">
          {t("hero.tshirt")}
        </button>
        <button type="button" class="preset-btn px-2.5 py-1 text-xs rounded-full bg-white dark:bg-[#111111] border border-[#ebebeb] dark:border-[#262626] hover:border-neutral-400 dark:hover:border-neutral-600 text-neutral-700 dark:text-neutral-300 transition" data-price="299" data-cogs="80" data-cat="electronics_accessories" data-wt="150">
          {t("hero.case")}
        </button>
        <button type="button" class="preset-btn px-2.5 py-1 text-xs rounded-full bg-white dark:bg-[#111111] border border-[#ebebeb] dark:border-[#262626] hover:border-neutral-400 dark:hover:border-neutral-600 text-neutral-700 dark:text-neutral-300 transition" data-price="899" data-cogs="340" data-cat="home_kitchen" data-wt="650">
          {t("hero.kitchen")}
        </button>
        <button type="button" class="preset-btn px-2.5 py-1 text-xs rounded-full bg-white dark:bg-[#111111] border border-[#ebebeb] dark:border-[#262626] hover:border-neutral-400 dark:hover:border-neutral-600 text-neutral-700 dark:text-neutral-300 transition" data-price="1499" data-cogs="600" data-cat="footwear" data-wt="850">
          {t("hero.shoes")}
        </button>
      </div>
    </div>

    <!-- Marketplace Navigation Tabs -->
    <div class="flex items-center justify-center mb-8">
      <div class="inline-flex p-1.5 rounded-2xl bg-neutral-100 dark:bg-[#111111] border border-neutral-200 dark:border-neutral-800 max-w-full overflow-x-auto" id="marketplaceTabs">
        <button
          type="button"
          data-mp="meesho"
          class="mp-tab px-4 py-2.5 rounded-xl text-xs sm:text-sm font-medium transition-all flex items-center gap-2 bg-white dark:bg-[#1f1f1f] text-[#171717] dark:text-white shadow-sm border border-neutral-200/60 dark:border-neutral-700"
        >
          <span class="w-2.5 h-2.5 rounded-full bg-pink-500"></span>
          <span>Meesho</span>
          <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-pink-50 dark:bg-pink-950/60 text-pink-700 dark:text-pink-300 border border-pink-200 dark:border-pink-900/50">0% Fee</span>
        </button>

        <button
          type="button"
          data-mp="flipkart"
          class="mp-tab px-4 py-2.5 rounded-xl text-xs sm:text-sm font-medium transition-all flex items-center gap-2 text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white"
        >
          <span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span>
          <span>Flipkart</span>
          <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-900/50">4-16%</span>
        </button>

        <button
          type="button"
          data-mp="amazon"
          class="mp-tab px-4 py-2.5 rounded-xl text-xs sm:text-sm font-medium transition-all flex items-center gap-2 text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white"
        >
          <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
          <span>Amazon</span>
          <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-amber-50 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-900/50">5-15%</span>
        </button>

        <button
          type="button"
          data-mp="snapdeal"
          class="mp-tab px-4 py-2.5 rounded-xl text-xs sm:text-sm font-medium transition-all flex items-center gap-2 text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white"
        >
          <span class="w-2.5 h-2.5 rounded-full bg-red-500"></span>
          <span>Snapdeal</span>
        </button>
      </div>
    </div>

    <!-- Main Two-Column Layout: Inputs on Left, Results Dashboard on Right -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- LEFT COLUMN: Inputs Card (5 Cols on LG) -->
      <div class="lg:col-span-5 bg-white dark:bg-[#0a0a0a] border border-[#ebebeb] dark:border-[#262626] rounded-2xl p-6 sm:p-7 shadow-xs">
        
        <div class="flex items-center justify-between border-b border-neutral-100 dark:border-neutral-800 pb-4 mb-6">
          <div>
            <h2 class="text-base font-semibold text-[#171717] dark:text-white flex items-center gap-2" id="calcCardTitle">
              Meesho Profit Inputs
            </h2>
            <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5" id="calcCardSubtitle">
              Zero referral commission model with weight-slab courier rates.
            </p>
          </div>
          <button type="button" id="resetBtn" class="text-xs text-neutral-400 hover:text-neutral-800 dark:hover:text-neutral-200 transition font-mono flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
            Reset
          </button>
        </div>

        <form id="calcForm" class="space-y-5" onsubmit="return false;">
          
          <!-- SELLING PRICE (HERO INPUT WITH AUTO-PASTE HANDLING) -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="inputSellingPrice" class="text-xs font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300 flex items-center gap-1.5">
                Selling Price (MRP / Listed Price)
                <span class="text-rose-500">*</span>
              </label>
              <span class="text-[11px] text-neutral-400 dark:text-neutral-500 font-mono">Includes Product GST</span>
            </div>
            <div class="relative">
              <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-neutral-400 dark:text-neutral-500 font-semibold text-base">
                ₹
              </div>
              <input
                type="text"
                id="inputSellingPrice"
                inputmode="decimal"
                value="599"
                placeholder="e.g. 599"
                class="w-full pl-8 pr-4 py-3 bg-neutral-50/70 dark:bg-[#141414] border border-neutral-200 dark:border-neutral-800 focus:bg-white dark:focus:bg-[#1a1a1a] focus:border-[#171717] dark:focus:border-white focus:ring-1 focus:ring-[#171717] dark:focus:ring-white rounded-xl text-lg font-mono font-semibold text-neutral-900 dark:text-white transition outline-none"
              />
            </div>
            <p class="text-[11px] text-neutral-500 dark:text-neutral-400 mt-1">Paste any price format (e.g. <span class="font-mono">₹599.00</span> or <span class="font-mono">1,250</span>) &mdash; calculated instantly.</p>
          </div>

          <!-- COST OF GOODS SOLD (COGS) -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="inputCogs" class="text-xs font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300">
                Product Cost (COGS)
              </label>
              <span class="text-[11px] text-neutral-400 dark:text-neutral-500 font-mono">Purchase / Manufacturing</span>
            </div>
            <div class="relative">
              <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-neutral-400 dark:text-neutral-500 font-semibold text-sm">
                ₹
              </div>
              <input
                type="text"
                id="inputCogs"
                inputmode="decimal"
                value="220"
                placeholder="220"
                class="w-full pl-8 pr-4 py-2.5 bg-neutral-50/70 dark:bg-[#141414] border border-neutral-200 dark:border-neutral-800 focus:bg-white dark:focus:bg-[#1a1a1a] focus:border-[#171717] dark:focus:border-white focus:ring-1 focus:ring-[#171717] dark:focus:ring-white rounded-xl text-sm font-mono text-neutral-900 dark:text-white transition outline-none"
              />
            </div>
          </div>

          <!-- PRODUCT CATEGORY & PRODUCT GST -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="selectCategory" class="block text-xs font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300 mb-1.5">
                Category
              </label>
              <select
                id="selectCategory"
                class="w-full px-3 py-2.5 bg-neutral-50/70 dark:bg-[#141414] border border-neutral-200 dark:border-neutral-800 focus:bg-white dark:focus:bg-[#1a1a1a] focus:border-[#171717] dark:focus:border-white focus:ring-1 focus:ring-[#171717] dark:focus:ring-white rounded-xl text-xs sm:text-sm text-neutral-800 dark:text-neutral-200 transition outline-none"
              >
                {CATEGORIES.map((cat) => (
                  <option value={cat.id} class="bg-white dark:bg-[#141414] text-neutral-900 dark:text-neutral-100">{cat.name}</option>
                ))}
              </select>
            </div>

            <div>
              <label for="inputProductGst" class="block text-xs font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300 mb-1.5">
                Product GST Rate
              </label>
              <div class="relative">
                <select
                  id="inputProductGst"
                  class="w-full px-3 py-2.5 bg-neutral-50/70 dark:bg-[#141414] border border-neutral-200 dark:border-neutral-800 focus:bg-white dark:focus:bg-[#1a1a1a] focus:border-[#171717] dark:focus:border-white focus:ring-1 focus:ring-[#171717] dark:focus:ring-white rounded-xl text-xs sm:text-sm font-mono text-neutral-800 dark:text-neutral-200 transition outline-none"
                >
                  <option value="0" class="bg-white dark:bg-[#141414] text-neutral-900 dark:text-neutral-100">0% (Books / Exempt)</option>
                  <option value="3" class="bg-white dark:bg-[#141414] text-neutral-900 dark:text-neutral-100">3% (Jewellery)</option>
                  <option value="5" class="bg-white dark:bg-[#141414] text-neutral-900 dark:text-neutral-100">5% (Grocery / Apparel &lt; 1k)</option>
                  <option value="12" selected class="bg-white dark:bg-[#141414] text-neutral-900 dark:text-neutral-100">12% (Apparel / Footwear)</option>
                  <option value="18" class="bg-white dark:bg-[#141414] text-neutral-900 dark:text-neutral-100">18% (Electronics / Home / Standard)</option>
                  <option value="28" class="bg-white dark:bg-[#141414] text-neutral-900 dark:text-neutral-100">28% (Luxury items)</option>
                </select>
              </div>
            </div>
          </div>

          <!-- SHIPPING WEIGHT & SHIPPING ZONE -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <div class="flex items-center justify-between mb-1.5">
                <label for="inputWeight" class="text-xs font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300">
                  Weight (Grams)
                </label>
                <span id="weightDisplay" class="text-xs font-mono font-medium text-neutral-600 dark:text-neutral-400">500g</span>
              </div>
              <input
                type="number"
                id="inputWeight"
                value="500"
                min="50"
                step="50"
                class="w-full px-3 py-2 bg-neutral-50/70 dark:bg-[#141414] border border-neutral-200 dark:border-neutral-800 focus:bg-white dark:focus:bg-[#1a1a1a] focus:border-[#171717] dark:focus:border-white focus:ring-1 focus:ring-[#171717] dark:focus:ring-white rounded-xl text-sm font-mono text-neutral-900 dark:text-white transition outline-none"
              />
            </div>

            <div>
              <label for="selectShippingZone" class="block text-xs font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300 mb-1.5">
                Delivery Distance
              </label>
              <select
                id="selectShippingZone"
                class="w-full px-3 py-2 bg-neutral-50/70 dark:bg-[#141414] border border-neutral-200 dark:border-neutral-800 focus:bg-white dark:focus:bg-[#1a1a1a] focus:border-[#171717] dark:focus:border-white focus:ring-1 focus:ring-[#171717] dark:focus:ring-white rounded-xl text-xs sm:text-sm text-neutral-800 dark:text-neutral-200 transition outline-none"
              >
                <option value="local" class="bg-white dark:bg-[#141414] text-neutral-900 dark:text-neutral-100">Local (Within City)</option>
                <option value="regional" class="bg-white dark:bg-[#141414] text-neutral-900 dark:text-neutral-100">Regional (Within Zone)</option>
                <option value="national" selected class="bg-white dark:bg-[#141414] text-neutral-900 dark:text-neutral-100">National (Inter-State Average)</option>
              </select>
            </div>
          </div>

          <!-- PACKAGING COST & AD SPEND PER UNIT -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="inputPackagingCost" class="block text-xs font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300 mb-1.5">
                Packaging Material
              </label>
              <div class="relative">
                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-neutral-400 dark:text-neutral-500 font-mono text-xs">
                  ₹
                </div>
                <input
                  type="number"
                  id="inputPackagingCost"
                  value="15"
                  min="0"
                  class="w-full pl-7 pr-3 py-2 bg-neutral-50/70 dark:bg-[#141414] border border-neutral-200 dark:border-neutral-800 focus:bg-white dark:focus:bg-[#1a1a1a] focus:border-[#171717] dark:focus:border-white rounded-xl text-xs sm:text-sm font-mono text-neutral-900 dark:text-white transition outline-none"
                />
              </div>
            </div>

            <div>
              <label for="inputAdSpend" class="block text-xs font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300 mb-1.5">
                Ad Spend / CAC (Optional)
              </label>
              <div class="relative">
                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-neutral-400 dark:text-neutral-500 font-mono text-xs">
                  ₹
                </div>
                <input
                  type="number"
                  id="inputAdSpend"
                  value="0"
                  min="0"
                  placeholder="0"
                  class="w-full pl-7 pr-3 py-2 bg-neutral-50/70 dark:bg-[#141414] border border-neutral-200 dark:border-neutral-800 focus:bg-white dark:focus:bg-[#1a1a1a] focus:border-[#171717] dark:focus:border-white rounded-xl text-xs sm:text-sm font-mono text-neutral-900 dark:text-white transition outline-none"
                />
              </div>
            </div>
          </div>

          <!-- ADVANCED ACCORDION 1: RTO & CUSTOMER RETURN LOSS SIMULATOR -->
          <div class="border border-neutral-200 dark:border-neutral-800 rounded-xl overflow-hidden bg-neutral-50/50 dark:bg-[#111111]/50">
            <button
              type="button"
              id="returnToggleBtn"
              class="w-full px-4 py-3 flex items-center justify-between text-left text-xs font-semibold uppercase tracking-wider text-neutral-800 dark:text-neutral-200 hover:bg-neutral-100/70 dark:hover:bg-neutral-800/70 transition"
            >
              <span class="flex items-center gap-1.5 text-neutral-900 dark:text-white">
                <svg class="w-4 h-4 text-amber-600 dark:text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                RTO &amp; Customer Return Loss Simulator
              </span>
              <span class="text-[11px] font-mono text-amber-700 dark:text-amber-400 bg-amber-100/60 dark:bg-amber-950/60 px-2 py-0.5 rounded border border-amber-200/50 dark:border-amber-800/40">
                Crucial for India
              </span>
            </button>

            <div id="returnSettingsPanel" class="p-4 border-t border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0f0f0f] space-y-4">
              <p class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed">
                Indian e-commerce sees 15%&ndash;30% return rates on COD orders. Competitor calculators ignore this and show misleading high profits. Model your real blended loss below:
              </p>

              <div class="grid grid-cols-2 gap-3">
                <div>
                  <div class="flex justify-between items-center mb-1">
                    <label for="inputRtoRate" class="text-[11px] font-medium text-neutral-700 dark:text-neutral-300">Expected RTO %</label>
                    <span id="rtoRateDisplay" class="text-[11px] font-mono font-semibold text-neutral-800 dark:text-neutral-200">18%</span>
                  </div>
                  <input
                    type="range"
                    id="inputRtoRate"
                    min="0"
                    max="50"
                    value="18"
                    class="w-full accent-[#171717] dark:accent-neutral-200 cursor-pointer"
                  />
                  <span class="text-[10px] text-neutral-400 dark:text-neutral-500">Undelivered courier return</span>
                </div>

                <div>
                  <div class="flex justify-between items-center mb-1">
                    <label for="inputCustomerReturnRate" class="text-[11px] font-medium text-neutral-700 dark:text-neutral-300">Customer Return %</label>
                    <span id="customerReturnRateDisplay" class="text-[11px] font-mono font-semibold text-neutral-800 dark:text-neutral-200">10%</span>
                  </div>
                  <input
                    type="range"
                    id="inputCustomerReturnRate"
                    min="0"
                    max="40"
                    value="10"
                    class="w-full accent-[#171717] dark:accent-neutral-200 cursor-pointer"
                  />
                  <span class="text-[10px] text-neutral-400 dark:text-neutral-500">Delivered &amp; returned by buyer</span>
                </div>
              </div>

              <div>
                <label for="inputReturnReverseCost" class="block text-[11px] font-medium text-neutral-700 dark:text-neutral-300 mb-1">
                  Customer Return Courier Penalty (₹)
                </label>
                <input
                  type="number"
                  id="inputReturnReverseCost"
                  value="130"
                  class="w-full px-3 py-1.5 bg-neutral-50 dark:bg-[#141414] border border-neutral-200 dark:border-neutral-800 rounded-lg text-xs font-mono text-neutral-900 dark:text-white"
                />
                <span class="text-[10px] text-neutral-400 dark:text-neutral-500">Reverse courier charges billed to seller upon customer return</span>
              </div>
            </div>
          </div>

          <!-- ADVANCED ACCORDION 2: CUSTOM FEE OVERRIDES -->
          <div class="border border-neutral-200 dark:border-neutral-800 rounded-xl overflow-hidden bg-neutral-50/50 dark:bg-[#111111]/50">
            <button
              type="button"
              id="feeOverridesToggleBtn"
              class="w-full px-4 py-3 flex items-center justify-between text-left text-xs font-semibold uppercase tracking-wider text-neutral-800 dark:text-neutral-200 hover:bg-neutral-100/70 dark:hover:bg-neutral-800/70 transition"
            >
              <span>Custom Fee Overrides (Optional)</span>
              <span class="text-neutral-400 dark:text-neutral-500 text-xs font-mono">+ Customize</span>
            </button>

            <div id="feeOverridesPanel" class="p-4 border-t border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#0f0f0f] space-y-3 hidden">
              <div class="grid grid-cols-3 gap-2">
                <div>
                  <label for="customCommInput" class="block text-[10px] font-medium text-neutral-600 dark:text-neutral-400 mb-1">Commission %</label>
                  <input type="number" id="customCommInput" placeholder="Auto" class="w-full px-2 py-1.5 bg-white dark:bg-[#141414] border border-neutral-200 dark:border-neutral-800 text-neutral-900 dark:text-white rounded text-xs font-mono" />
                </div>
                <div>
                  <label for="customFixedFeeInput" class="block text-[10px] font-medium text-neutral-600 dark:text-neutral-400 mb-1">Fixed Fee ₹</label>
                  <input type="number" id="customFixedFeeInput" placeholder="Auto" class="w-full px-2 py-1.5 bg-white dark:bg-[#141414] border border-neutral-200 dark:border-neutral-800 text-neutral-900 dark:text-white rounded text-xs font-mono" />
                </div>
                <div>
                  <label for="customShippingInput" class="block text-[10px] font-medium text-neutral-600 dark:text-neutral-400 mb-1">Shipping ₹</label>
                  <input type="number" id="customShippingInput" placeholder="Auto" class="w-full px-2 py-1.5 bg-white dark:bg-[#141414] border border-neutral-200 dark:border-neutral-800 text-neutral-900 dark:text-white rounded text-xs font-mono" />
                </div>
              </div>
              <p class="text-[10px] text-neutral-400 dark:text-neutral-500">Leave blank to use standard 2026 marketplace slab rates automatically.</p>
            </div>
          </div>

        </form>
      </div>

      <!-- RIGHT COLUMN: Results Dashboard (7 Cols on LG) -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- TOP SUMMARY KPI CARDS -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          
          <!-- KPI 1: BLENDED NET PROFIT (HERO NUMBER) -->
          <div class="card-ver p-5 relative overflow-hidden bg-white dark:bg-[#0a0a0a] border-2 border-neutral-900 dark:border-neutral-700 shadow-sm">
            <div class="flex items-center justify-between">
              <span class="text-[11px] font-mono uppercase tracking-wider text-neutral-500 dark:text-neutral-400 font-semibold">
                Real In-Hand Profit
              </span>
              <span id="blendedMarginBadge" class="text-[11px] font-mono font-bold px-2 py-0.5 rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/50">
                +24.5%
              </span>
            </div>
            <div class="mt-3 flex items-baseline gap-1.5">
              <span id="blendedProfitValue" class="text-3xl sm:text-4xl font-mono font-bold tracking-tight text-emerald-600 dark:text-emerald-400">
                ₹147.20
              </span>
            </div>
            <p class="text-[11px] text-neutral-500 dark:text-neutral-400 mt-2 flex items-center gap-1">
              <svg class="w-3.5 h-3.5 text-neutral-400 dark:text-neutral-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              Blended profit per dispatched order (with RTO)
