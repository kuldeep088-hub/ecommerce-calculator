<!-- CLIENT SCRIPT FOR INSTANT REACTIVE AUTO-CALCULATION & SMART PASTE -->
<script is:inline>
(function() {
  // Category rates map
  var CATEGORIES_DATA = {
    fashion: { meesho: 0, flipkart: 15.0, amazon: 13.5, snapdeal: 5.0, defaultGst: 12 },
    footwear: { meesho: 0, flipkart: 14.0, amazon: 12.0, snapdeal: 6.0, defaultGst: 12 },
    electronics_accessories: { meesho: 0, flipkart: 12.5, amazon: 14.0, snapdeal: 8.0, defaultGst: 18 },
    home_kitchen: { meesho: 0, flipkart: 11.0, amazon: 10.5, snapdeal: 7.0, defaultGst: 18 },
    beauty_grooming: { meesho: 0, flipkart: 9.0, amazon: 8.5, snapdeal: 6.0, defaultGst: 18 },
    jewellery_fashion: { meesho: 0, flipkart: 16.0, amazon: 15.0, snapdeal: 8.0, defaultGst: 3 },
    grocery_fmcg: { meesho: 0, flipkart: 6.5, amazon: 6.0, snapdeal: 4.0, defaultGst: 5 },
    toys_baby: { meesho: 0, flipkart: 10.5, amazon: 9.5, snapdeal: 6.0, defaultGst: 12 },
    books: { meesho: 0, flipkart: 9.0, amazon: 8.0, snapdeal: 5.0, defaultGst: 0 },
    custom: { meesho: 0, flipkart: 10.0, amazon: 10.0, snapdeal: 5.0, defaultGst: 18 }
  };

  var currentMarketplace = 'meesho';

  // Helper functions
  function getAmazonClosingFee(price) {
    if (price <= 250) return 5;
    if (price <= 500) return 10;
    if (price <= 1000) return 25;
    if (price <= 2000) return 35;
    return 50;
  }

  function getFlipkartFixedFee(price) {
    if (price <= 300) return 13;
    if (price <= 500) return 17;
    if (price <= 1000) return 30;
    return 52;
  }

  function getShippingFee(mp, weightGrams, zone) {
    if (mp === 'meesho') {
      if (weightGrams <= 500) return 49;
      if (weightGrams <= 1000) return 85;
      if (weightGrams <= 1500) return 125;
      var extra = Math.ceil((weightGrams - 1500) / 500);
      return 125 + extra * 40;
    }
    if (mp === 'amazon') {
      var base = zone === 'local' ? 44 : zone === 'regional' ? 53 : 74;
      var addl = zone === 'local' ? 25 : zone === 'regional' ? 30 : 36;
      if (weightGrams <= 500) return base;
      var extra = Math.ceil((weightGrams - 500) / 500);
      return base + extra * addl;
    }
    if (mp === 'flipkart') {
      var base = zone === 'local' ? 44 : zone === 'regional' ? 54 : 69;
      var addl = zone === 'local' ? 22 : zone === 'regional' ? 26 : 32;
      if (weightGrams <= 500) return base;
      var extra = Math.ceil((weightGrams - 500) / 500);
      return base + extra * addl;
    }
    return 55 + Math.ceil(Math.max(0, weightGrams - 500) / 500) * 35;
  }

  // Parse cleaned numeric float
  function parseVal(el) {
    if (!el) return 0;
    var raw = el.value.toString().replace(/[₹,\s]/g, '');
    var val = parseFloat(raw);
    return isNaN(val) ? 0 : val;
  }

  function formatCurrency(val) {
    return '₹' + (val || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  // Main Calculation Routine
  function calculate() {
    var sp = parseVal(document.getElementById('inputSellingPrice'));
    var cogs = parseVal(document.getElementById('inputCogs'));
    var category = document.getElementById('selectCategory').value;
    var gstRate = parseVal(document.getElementById('inputProductGst'));
    var weight = parseVal(document.getElementById('inputWeight')) || 500;
    var zone = document.getElementById('selectShippingZone').value;
    var pkg = parseVal(document.getElementById('inputPackagingCost'));
    var ads = parseVal(document.getElementById('inputAdSpend'));
    var rtoRate = parseVal(document.getElementById('inputRtoRate')) || 0;
    var returnRate = parseVal(document.getElementById('inputCustomerReturnRate')) || 0;
    var returnReverseCost = parseVal(document.getElementById('inputReturnReverseCost')) || 130;

    // Overrides
    var customComm = document.getElementById('customCommInput').value;
    var customFixed = document.getElementById('customFixedFeeInput').value;
    var customShip = document.getElementById('customShippingInput').value;

    // 1. Taxable Value & Product GST
    var taxable = sp > 0 ? sp / (1 + gstRate / 100) : 0;
    var productGst = sp - taxable;

    // 2. Commission
    var catInfo = CATEGORIES_DATA[category] || CATEGORIES_DATA['fashion'];
    var commRate = customComm !== '' ? parseFloat(customComm) : (catInfo[currentMarketplace] !== undefined ? catInfo[currentMarketplace] : 10);
    var commAmount = taxable * (commRate / 100);

    // 3. Fixed Fee
    var fixedFee = 0;
    if (customFixed !== '') {
      fixedFee = parseFloat(customFixed);
    } else {
      if (currentMarketplace === 'amazon') fixedFee = getAmazonClosingFee(sp);
      else if (currentMarketplace === 'flipkart') fixedFee = getFlipkartFixedFee(sp);
      else if (currentMarketplace === 'meesho') fixedFee = 0;
      else fixedFee = 10;
    }

    // 4. Collection Fee (2% for Flipkart/Amazon, 0 for Meesho)
    var collectionFee = (currentMarketplace === 'flipkart' || currentMarketplace === 'amazon') ? (sp * 0.02) : 0;

    // 5. Shipping
    var shippingFee = customShip !== '' ? parseFloat(customShip) : getShippingFee(currentMarketplace, weight, zone);

    // 6. Subtotal marketplace fees & 18% GST on fees
    var feesExGst = commAmount + fixedFee + collectionFee + shippingFee;
    var gstOnFees = feesExGst * 0.18;

    // 7. TCS & TDS (1% + 0.1% = 1.1% on taxable)
    var tcsTds = taxable * 0.011;

    // 8. Total Marketplace Deduction & Bank Settlement
    var totalDeductions = feesExGst + gstOnFees + tcsTds;
    var bankSettlement = Math.max(0, sp - totalDeductions);

    // 9. Pure Delivered Profit
    var deliveredProfit = taxable - cogs - feesExGst - pkg - ads;
    var deliveredMargin = sp > 0 ? (deliveredProfit / sp) * 100 : 0;

    // 10. RTO & Customer Return Loss Simulator
    var rtoCourierLoss = currentMarketplace === 'meesho' ? 0 : shippingFee;
    var rtoPackagingLoss = pkg + 10;
    var rtoLossPerOrder = rtoCourierLoss + rtoPackagingLoss;

    var custReturnCourierLoss = returnReverseCost;
    var custReturnDamageLoss = pkg + 15 + cogs * 0.05;
    var custReturnLossPerOrder = custReturnCourierLoss + custReturnDamageLoss;

    var deliveredRate = Math.max(0, 100 - rtoRate - returnRate) / 100;
    var rtoFraction = rtoRate / 100;
    var returnFraction = returnRate / 100;

    var returnLossBuffer = (rtoLossPerOrder * rtoFraction) + (custReturnLossPerOrder * returnFraction);
    var blendedProfit = (deliveredProfit * deliveredRate) - returnLossBuffer;
    var blendedMargin = sp > 0 ? (blendedProfit / sp) * 100 : 0;

    // Update UI Displays
    document.getElementById('weightDisplay').textContent = weight + 'g';
    document.getElementById('rtoRateDisplay').textContent = rtoRate + '%';
    document.getElementById('customerReturnRateDisplay').textContent = returnRate + '%';

    // Hero KPI Cards
    var bpValEl = document.getElementById('blendedProfitValue');
    bpValEl.textContent = formatCurrency(blendedProfit);
    if (blendedProfit >= 0) {
      bpValEl.className = 'text-2xl sm:text-3xl font-mono font-bold tracking-tight text-emerald-600 dark:text-emerald-400';
    } else {
      bpValEl.className = 'text-2xl sm:text-3xl font-mono font-bold tracking-tight text-rose-600 dark:text-rose-400';
    }

    var bpMarginEl = document.getElementById('blendedMarginBadge');
    bpMarginEl.textContent = (blendedMargin >= 0 ? '+' : '') + blendedMargin.toFixed(1) + '%';
    bpMarginEl.className = blendedMargin >= 0 
      ? 'text-[10px] font-mono font-semibold px-2 py-0.5 rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200/70 dark:border-emerald-800/50'
      : 'text-[10px] font-mono font-semibold px-2 py-0.5 rounded-full bg-rose-50 dark:bg-rose-950/60 text-rose-700 dark:text-rose-300 border border-rose-200/70 dark:border-rose-800/50';

    // Mobile Sticky Bar
    var mobileProfitEl = document.getElementById('mobileProfitValue');
    var mobileMarginEl = document.getElementById('mobileMarginBadge');
    if (mobileProfitEl) {
      mobileProfitEl.textContent = formatCurrency(blendedProfit);
      mobileProfitEl.className = blendedProfit >= 0
        ? 'text-xl font-mono font-bold text-emerald-600 dark:text-emerald-400'
        : 'text-xl font-mono font-bold text-rose-600 dark:text-rose-400';
    }
    if (mobileMarginEl) {
      mobileMarginEl.textContent = (blendedMargin >= 0 ? '+' : '') + blendedMargin.toFixed(1) + '%';
      mobileMarginEl.className = blendedMargin >= 0
        ? 'text-[10px] font-mono font-bold px-1.5 py-0.5 rounded bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/50'
        : 'text-[10px] font-mono font-bold px-1.5 py-0.5 rounded bg-rose-50 dark:bg-rose-950/60 text-rose-700 dark:text-rose-300 border border-rose-200 dark:border-rose-800/50';
    }

    document.getElementById('bankSettlementValue').textContent = formatCurrency(bankSettlement);
    document.getElementById('deliveredProfitValue').textContent = formatCurrency(deliveredProfit);
    document.getElementById('deliveredMarginBadge').textContent = deliveredMargin.toFixed(1) + '% margin';

    // Waterfall Bar Percentages
    var cogsPct = sp > 0 ? Math.min(100, Math.max(0, (cogs / sp) * 100)) : 0;
    var feePct = sp > 0 ? Math.min(100, Math.max(0, ((commAmount + fixedFee + collectionFee) / sp) * 100)) : 0;
    var shipPct = sp > 0 ? Math.min(100, Math.max(0, (shippingFee / sp) * 100)) : 0;
    var taxPct = sp > 0 ? Math.min(100, Math.max(0, ((productGst + gstOnFees) / sp) * 100)) : 0;
    var returnPct = sp > 0 ? Math.min(100, Math.max(0, (returnLossBuffer / sp) * 100)) : 0;
    var profitPct = sp > 0 ? Math.max(0, blendedMargin) : 0;

    document.getElementById('barCogs').style.width = cogsPct + '%';
    document.getElementById('barFee').style.width = feePct + '%';
    document.getElementById('barShipping').style.width = shipPct + '%';
    document.getElementById('barTax').style.width = taxPct + '%';
    document.getElementById('barReturn').style.width = returnPct + '%';
    document.getElementById('barProfit').style.width = profitPct + '%';

    document.getElementById('legendCogs').textContent = cogsPct.toFixed(1) + '%';
    document.getElementById('legendFee').textContent = feePct.toFixed(1) + '%';
    document.getElementById('legendShipping').textContent = shipPct.toFixed(1) + '%';
    document.getElementById('legendTax').textContent = taxPct.toFixed(1) + '%';
    document.getElementById('legendReturn').textContent = returnPct.toFixed(1) + '%';
    document.getElementById('legendProfit').textContent = blendedMargin.toFixed(1) + '%';

    // Detailed Line-by-Line Table
    document.getElementById('dtSellingPrice').textContent = formatCurrency(sp);
    document.getElementById('dtTaxableValue').textContent = formatCurrency(taxable);
    document.getElementById('dtTaxableGstBadge').textContent = 'Excl. ' + gstRate + '% GST';
    document.getElementById('dtProductGst').textContent = formatCurrency(productGst);
    document.getElementById('dtCommissionRate').textContent = commRate + '%';
    document.getElementById('dtCommissionFee').textContent = formatCurrency(commAmount);
    document.getElementById('dtFixedFee').textContent = formatCurrency(fixedFee);
    document.getElementById('dtCollectionFee').textContent = formatCurrency(collectionFee);
    document.getElementById('dtShippingFee').textContent = formatCurrency(shippingFee);
    document.getElementById('dtShippingWeightBadge').textContent = weight + 'g';
    document.getElementById('dtGstOnFees').textContent = formatCurrency(gstOnFees);
    document.getElementById('dtTcsTds').textContent = formatCurrency(tcsTds);
    document.getElementById('dtTotalDeductions').textContent = formatCurrency(totalDeductions);
    document.getElementById('dtBankSettlement').textContent = formatCurrency(bankSettlement);
    document.getElementById('dtCogs').textContent = '- ' + formatCurrency(cogs);
    document.getElementById('dtPkgAds').textContent = '- ' + formatCurrency(pkg + ads);
    document.getElementById('dtReturnLossBuffer').textContent = '- ' + formatCurrency(returnLossBuffer);
    
    var finalProfitEl = document.getElementById('dtFinalProfit');
    finalProfitEl.textContent = formatCurrency(blendedProfit);
    if (blendedProfit >= 0) {
      finalProfitEl.className = 'font-mono text-lg sm:text-2xl font-bold text-emerald-400';
    } else {
      finalProfitEl.className = 'font-mono text-lg sm:text-2xl font-bold text-rose-400';
    }

    // Trigger update on Comparison Matrix if present
    if (window.updateComparisonMatrix) {
      window.updateComparisonMatrix({
        sellingPrice: sp,
        costOfGoods: cogs,
        category: category,
        productGstRate: gstRate,
        weightGrams: weight,
        shippingZone: zone,
        packagingCost: pkg,
        adSpend: ads,
        rtoRate: rtoRate,
        customerReturnRate: returnRate,
        customerReturnReverseCost: returnReverseCost
      });
    }
  }

  // Set Marketplace Tab
  function setMarketplace(mp) {
    currentMarketplace = mp;
    document.querySelectorAll('.mp-tab').forEach(function(btn) {
      if (btn.dataset.mp === mp) {
        btn.className = 'mp-tab shrink-0 px-3.5 py-1.5 min-h-[38px] rounded-lg text-xs sm:text-[13px] font-medium transition-all flex items-center gap-2 bg-white dark:bg-neutral-800 text-neutral-900 dark:text-white shadow-2xs border border-black/[0.05] dark:border-white/[0.08]';
      } else {
        btn.className = 'mp-tab shrink-0 px-3.5 py-1.5 min-h-[38px] rounded-lg text-xs sm:text-[13px] font-medium transition-all flex items-center gap-2 text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white';
      }
    });

    var mpNames = { meesho: 'Meesho', flipkart: 'Flipkart', amazon: 'Amazon India', snapdeal: 'Snapdeal' };
    var mpSubtitles = {
      meesho: 'Zero referral commission model with weight-slab courier rates.',
      flipkart: 'Category referral commission + Fixed slab fees + Collection fees.',
      amazon: 'Amazon Easy Ship model with dynamic closing fee slabs.',
      snapdeal: 'Value commerce commission structure.'
    };

    var titleEl = document.getElementById('calcCardTitle');
    var subtitleEl = document.getElementById('calcCardSubtitle');
    var badgeEl = document.getElementById('activeMpLabel');

    if (titleEl) titleEl.textContent = (mpNames[mp] || mp) + ' Profit Inputs';
    if (subtitleEl) subtitleEl.textContent = mpSubtitles[mp] || '';
    if (badgeEl) badgeEl.textContent = mpNames[mp] || mp;

    calculate();
  }

  // Setup Event Listeners
  document.addEventListener('DOMContentLoaded', function() {
    var priceInput = document.getElementById('inputSellingPrice');

    // Smart Paste Listener
    if (priceInput) {
      priceInput.addEventListener('paste', function(e) {
        var pastedText = (e.clipboardData || window.clipboardData).getData('text');
        // Clean out currency symbols and commas
        var cleaned = pastedText.replace(/[₹,\s]/g, '');
        var num = parseFloat(cleaned);
        if (!isNaN(num)) {
          e.preventDefault();
          priceInput.value = num;
          calculate();
        }
      });
    }

    // Attach input listeners
    var inputs = [
      'inputSellingPrice', 'inputCogs', 'selectCategory', 'inputProductGst',
      'inputWeight', 'selectShippingZone', 'inputPackagingCost', 'inputAdSpend',
      'inputRtoRate', 'inputCustomerReturnRate', 'inputReturnReverseCost',
      'customCommInput', 'customFixedFeeInput', 'customShippingInput'
    ];

    inputs.forEach(function(id) {
      var el = document.getElementById(id);
      if (el) {
        el.addEventListener('input', calculate);
        el.addEventListener('change', calculate);
      }
    });

    // Auto-update default GST when Category changes
    var catSelect = document.getElementById('selectCategory');
    if (catSelect) {
      catSelect.addEventListener('change', function() {
        var catId = catSelect.value;
        if (CATEGORIES_DATA[catId]) {
          document.getElementById('inputProductGst').value = CATEGORIES_DATA[catId].defaultGst;
        }
        calculate();
      });
    }

    // Tab buttons
    document.querySelectorAll('.mp-tab').forEach(function(btn) {
      btn.addEventListener('click', function() {
        setMarketplace(btn.dataset.mp);
      });
    });

    // Accordion Toggles
    var returnToggle = document.getElementById('returnToggleBtn');
    var returnPanel = document.getElementById('returnSettingsPanel');
    if (returnToggle && returnPanel) {
      returnToggle.addEventListener('click', function() {
        returnPanel.classList.toggle('hidden');
      });
    }

    var feeToggle = document.getElementById('feeOverridesToggleBtn');
    var feePanel = document.getElementById('feeOverridesPanel');
    if (feeToggle && feePanel) {
      feeToggle.addEventListener('click', function() {
        feePanel.classList.toggle('hidden');
      });
    }

    // Reset button
    var resetBtn = document.getElementById('resetBtn');
    if (resetBtn) {
      resetBtn.addEventListener('click', function() {
        document.getElementById('inputSellingPrice').value = '599';
        document.getElementById('inputCogs').value = '220';
        document.getElementById('selectCategory').value = 'fashion';
        document.getElementById('inputProductGst').value = '12';
        document.getElementById('inputWeight').value = '500';
        document.getElementById('selectShippingZone').value = 'national';
        document.getElementById('inputPackagingCost').value = '15';
        document.getElementById('inputAdSpend').value = '0';
        document.getElementById('inputRtoRate').value = '18';
        document.getElementById('inputCustomerReturnRate').value = '10';
        document.getElementById('inputReturnReverseCost').value = '130';
        document.getElementById('customCommInput').value = '';
        document.getElementById('customFixedFeeInput').value = '';
        document.getElementById('customShippingInput').value = '';
        calculate();
      });
    }

    // Get Calculation Summary Text
    function getSummaryText() {
      var sp = document.getElementById('inputSellingPrice').value;
      var profit = document.getElementById('blendedProfitValue').textContent.trim();
      var margin = document.getElementById('blendedMarginBadge').textContent.trim();
      var settlement = document.getElementById('bankSettlementValue').textContent.trim();

      return [
        'Seller Profit Calculation (' + currentMarketplace.toUpperCase() + ')',
        '- Selling Price: ₹' + sp,
        '- Bank Settlement: ' + settlement,
        '- Real In-Hand Profit: ' + profit + ' (' + margin + ' margin)',
        '- Calculated on: https://freesellerprofitcalculator.com'
      ].join('\n');
    }

    // Copy Summary Button
    var copyBtn = document.getElementById('copySummaryBtn');
    var toast = document.getElementById('toastMessage');
    if (copyBtn) {
      copyBtn.addEventListener('click', function() {
        var summaryText = getSummaryText();
        navigator.clipboard.writeText(summaryText).then(function() {
          if (toast) {
            toast.classList.remove('hidden');
            setTimeout(function() { toast.classList.add('hidden'); }, 2500);
          }
        });
      });
    }

    // WhatsApp Share Handlers
    function shareViaWhatsapp() {
      var text = encodeURIComponent(getSummaryText());
      window.open('https://api.whatsapp.com/send?text=' + text, '_blank');
    }

    var waBtn = document.getElementById('whatsappShareBtn');
    if (waBtn) waBtn.addEventListener('click', shareViaWhatsapp);

    var mobileWaBtn = document.getElementById('mobileWhatsappBtn');
    if (mobileWaBtn) mobileWaBtn.addEventListener('click', shareViaWhatsapp);

    // Initial Run
    calculate();
  });
})();
</script>
