---
// src/components/RtoLossCalculator.astro
---

<section id="rto-loss-calculator" class="pt-6 sm:pt-10 pb-14 sm:pb-16">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    
    <!-- Header -->
    <div class="text-center max-w-xl mx-auto mb-6 sm:mb-8">
      <div class="inline-flex items-center gap-2 mb-2">
        <span class="text-xs font-mono font-bold px-2 py-0.5 rounded-full bg-rose-50 text-rose-800 border border-rose-200">
          COD &amp; Courier Analytics
        </span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-neutral-900">
        RTO Loss Calculator for Indian Sellers
      </h1>
      <p class="mt-1.5 text-xs sm:text-sm text-neutral-500">
        Calculate exact financial losses from Return to Origin (RTO) and undelivered COD orders across Delhivery, Shiprocket, Meesho, and Flipkart.
      </p>
    </div>

    <!-- Main Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      
      <!-- Inputs (5 Cols) -->
      <div class="lg:col-span-5 bg-white border border-neutral-200 rounded-2xl p-5 sm:p-6 shadow-xs">
        <h2 class="text-sm font-semibold text-neutral-900 mb-4 pb-2 border-b border-neutral-100">
          Order &amp; Shipping Metrics
        </h2>

        <form id="rtoForm" class="space-y-3.5" onsubmit="return false;">
          
          <div>
            <label for="rtoMonthlyOrders" class="block text-xs font-medium text-neutral-700 mb-1">
              Monthly Total Dispatches
            </label>
            <input
              type="number"
              id="rtoMonthlyOrders"
              value="1000"
              min="1"
              class="w-full px-3 py-2 bg-white border border-neutral-200 rounded-xl text-sm font-mono text-neutral-900 outline-none focus:border-neutral-900"
            />
          </div>

          <div class="grid grid-cols-2 gap-2.5">
            <div>
              <label for="rtoAov" class="block text-xs font-medium text-neutral-700 mb-1">Selling Price (₹)</label>
              <input
                type="number"
                id="rtoAov"
                value="699"
                min="0"
                class="w-full px-3 py-2 bg-white border border-neutral-200 rounded-xl text-xs font-mono text-neutral-900 outline-none focus:border-neutral-900"
              />
            </div>
            <div>
              <label for="rtoCogs" class="block text-xs font-medium text-neutral-700 mb-1">Product Cost (₹)</label>
              <input
                type="number"
                id="rtoCogs"
                value="220"
                min="0"
                class="w-full px-3 py-2 bg-white border border-neutral-200 rounded-xl text-xs font-mono text-neutral-900 outline-none focus:border-neutral-900"
              />
            </div>
          </div>

          <div class="grid grid-cols-2 gap-2.5">
            <div>
              <label for="rtoForwardShip" class="block text-xs font-medium text-neutral-700 mb-1">Forward Courier (₹)</label>
              <input
                type="number"
                id="rtoForwardShip"
                value="65"
                min="0"
                class="w-full px-3 py-2 bg-white border border-neutral-200 rounded-xl text-xs font-mono text-neutral-900 outline-none focus:border-neutral-900"
              />
            </div>
            <div>
              <label for="rtoPackagingCost" class="block text-xs font-medium text-neutral-700 mb-1">Packaging (₹)</label>
              <input
                type="number"
                id="rtoPackagingCost"
                value="18"
                min="0"
                class="w-full px-3 py-2 bg-white border border-neutral-200 rounded-xl text-xs font-mono text-neutral-900 outline-none focus:border-neutral-900"
              />
            </div>
          </div>

          <!-- COD Share Slider -->
          <div>
            <div class="flex justify-between text-xs text-neutral-700 mb-1">
              <span>Cash on Delivery (COD) Share</span>
              <span id="rtoCodShareDisplay" class="font-mono font-bold text-neutral-900">70%</span>
            </div>
            <input
              type="range"
              id="rtoCodShare"
              min="0"
              max="100"
              value="70"
              class="w-full accent-neutral-900 cursor-pointer h-1.5 bg-neutral-200 rounded-lg appearance-none"
            />
          </div>

          <!-- COD RTO Rate Slider -->
          <div>
            <div class="flex justify-between text-xs text-neutral-700 mb-1">
              <span>COD RTO Rate %</span>
              <span id="rtoCodRateDisplay" class="font-mono font-bold text-rose-600">22%</span>
            </div>
            <input
              type="range"
              id="rtoCodRate"
              min="0"
              max="50"
              value="22"
              class="w-full accent-rose-600 cursor-pointer h-1.5 bg-neutral-200 rounded-lg appearance-none"
            />
            <span class="text-[11px] text-neutral-400 mt-0.5 block">Indian average for COD is 18% &ndash; 30%.</span>
          </div>

          <!-- Prepaid RTO Rate Slider -->
          <div>
            <div class="flex justify-between text-xs text-neutral-700 mb-1">
              <span>Prepaid RTO Rate %</span>
              <span id="rtoPrepaidRateDisplay" class="font-mono font-bold text-emerald-700">2%</span>
            </div>
            <input
              type="range"
              id="rtoPrepaidRate"
              min="0"
              max="20"
              value="2"
              class="w-full accent-emerald-600 cursor-pointer h-1.5 bg-neutral-200 rounded-lg appearance-none"
            />
          </div>

        </form>
      </div>

      <!-- Results (7 Cols) -->
      <div class="lg:col-span-7 space-y-4">
        
        <!-- Total Monthly Loss Hero Card -->
        <div class="p-5 sm:p-6 rounded-2xl bg-white border-2 border-rose-500/40 shadow-xs">
          <div class="flex items-center justify-between">
            <span class="text-xs font-medium uppercase tracking-wider text-rose-800">
              Total Monthly RTO Loss
            </span>
            <span id="rtoOrdersBadge" class="text-xs font-mono font-bold px-2 py-0.5 rounded-md bg-rose-50 text-rose-700 border border-rose-200">
              160 RTO Orders
            </span>
          </div>

          <div class="mt-2.5 flex items-baseline gap-2">
            <span id="rtoTotalLossValue" class="text-3xl sm:text-4xl font-mono font-bold tracking-tight text-rose-600">
              ₹13,280
            </span>
            <span class="text-xs text-neutral-400">wasted cash burn every month</span>
          </div>

          <div class="mt-4 pt-3 border-t border-neutral-100 grid grid-cols-2 gap-4 text-xs">
            <div>
              <span class="text-neutral-500 block">Direct Loss per RTO:</span>
              <strong id="rtoLossPerUnitValue" class="font-mono text-neutral-900 font-semibold text-sm">₹83.00</strong>
            </div>
            <div>
              <span class="text-neutral-500 block">Required Markup / Delivered:</span>
              <strong id="rtoMarkupRequiredValue" class="font-mono text-rose-700 font-bold text-sm">+ ₹15.80</strong>
            </div>
          </div>
        </div>

        <!-- Breakdown Details -->
        <div class="bg-white border border-neutral-200 rounded-2xl p-4 sm:p-5 shadow-xs">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-neutral-700 mb-3">
            Financial Impact Breakdown
          </h3>

          <div class="space-y-2 text-xs sm:text-[13px] divide-y divide-neutral-100">
            <div class="flex items-center justify-between pb-2">
              <span class="text-neutral-600">Total COD Orders Dispatched</span>
              <span id="statCodOrders" class="font-mono font-semibold text-neutral-900">700</span>
            </div>
            <div class="flex items-center justify-between py-2">
              <span class="text-neutral-600">COD Orders Returned to Origin (RTO)</span>
              <span id="statCodRtoCount" class="font-mono font-semibold text-rose-600">154 orders (22%)</span>
            </div>
            <div class="flex items-center justify-between py-2">
              <span class="text-neutral-600">Prepaid Orders Returned (RTO)</span>
              <span id="statPrepaidRtoCount" class="font-mono font-semibold text-neutral-700">6 orders (2%)</span>
            </div>
            <div class="flex items-center justify-between py-2">
              <span class="text-neutral-600">Forward Courier Charges Burned</span>
              <span id="statCourierBurn" class="font-mono text-rose-600">- ₹10,400</span>
            </div>
            <div class="flex items-center justify-between py-2">
              <span class="text-neutral-600">Destroyed Packaging &amp; Flyer Boxes</span>
              <span id="statPackagingBurn" class="font-mono text-rose-600">- ₹2,880</span>
            </div>
            <div class="flex items-center justify-between pt-2.5 font-bold">
              <span class="text-neutral-900">Successfully Delivered Orders</span>
              <span id="statDeliveredCount" class="font-mono text-base text-emerald-700">840 orders (84.0%)</span>
            </div>
          </div>
        </div>

        <!-- Strategy Box -->
        <div class="bg-amber-50/50 border border-amber-200/80 rounded-2xl p-4 sm:p-5 text-xs text-neutral-700">
          <span class="font-semibold text-amber-900 block mb-1">How to Cut RTO Losses by 30%&ndash;50%:</span>
          <ul class="list-disc list-inside space-y-1 text-neutral-600 mt-1">
            <li><strong>WhatsApp COD Confirmation:</strong> Verify address &amp; buyer intent before handing over to courier.</li>
            <li><strong>Incentivize Prepaid:</strong> Offer ₹30&ndash;₹50 flat discount for UPI payments to avoid courier COD fees.</li>
            <li><strong>Automated NDR Follow-up:</strong> Resolve courier "customer unavailable" fake attempts same-day.</li>
          </ul>
        </div>

      </div>

    </div>

  </div>
</section>

<script is:inline>
(function() {
  function formatCurrency(val) {
    return '₹' + Math.round(val || 0).toLocaleString('en-IN');
  }

  function calculateRto() {
    var monthlyOrders = parseFloat(document.getElementById('rtoMonthlyOrders').value) || 0;
    var forwardShip = parseFloat(document.getElementById('rtoForwardShip').value) || 0;
    var packaging = parseFloat(document.getElementById('rtoPackagingCost').value) || 0;
    var codShare = parseFloat(document.getElementById('rtoCodShare').value) || 0;
    var codRate = parseFloat(document.getElementById('rtoCodRate').value) || 0;
    var prepaidRate = parseFloat(document.getElementById('rtoPrepaidRate').value) || 0;

    // Display updates
    document.getElementById('rtoCodShareDisplay').textContent = codShare + '%';
    document.getElementById('rtoCodRateDisplay').textContent = codRate + '%';
    document.getElementById('rtoPrepaidRateDisplay').textContent = prepaidRate + '%';

    var codOrders = (monthlyOrders * codShare) / 100;
    var prepaidOrders = monthlyOrders - codOrders;

    var codRtoOrders = Math.round((codOrders * codRate) / 100);
    var prepaidRtoOrders = Math.round((prepaidOrders * prepaidRate) / 100);
    var totalRtoOrders = codRtoOrders + prepaidRtoOrders;

    var deliveredOrders = Math.max(0, monthlyOrders - totalRtoOrders);
    var deliveredPercentage = monthlyOrders > 0 ? (deliveredOrders / monthlyOrders) * 100 : 0;

    // Loss per unit: courier fee + damaged box
    var lossPerUnit = forwardShip + packaging;
    var courierBurn = totalRtoOrders * forwardShip;
    var packagingBurn = totalRtoOrders * packaging;
    var totalLoss = totalRtoOrders * lossPerUnit;

    var markupRequired = deliveredOrders > 0 ? (totalLoss / deliveredOrders) : 0;

    // Update UI elements
    document.getElementById('rtoOrdersBadge').textContent = totalRtoOrders + ' RTO Orders';
    document.getElementById('rtoTotalLossValue').textContent = formatCurrency(totalLoss);
    document.getElementById('rtoLossPerUnitValue').textContent = '₹' + lossPerUnit.toFixed(2);
    document.getElementById('rtoMarkupRequiredValue').textContent = '+ ₹' + markupRequired.toFixed(2);

    document.getElementById('statCodOrders').textContent = Math.round(codOrders) + ' (' + codShare + '%)';
    document.getElementById('statCodRtoCount').textContent = codRtoOrders + ' orders (' + codRate + '%)';
    document.getElementById('statPrepaidRtoCount').textContent = prepaidRtoOrders + ' orders (' + prepaidRate + '%)';
    document.getElementById('statCourierBurn').textContent = '- ' + formatCurrency(courierBurn);
    document.getElementById('statPackagingBurn').textContent = '- ' + formatCurrency(packagingBurn);
    document.getElementById('statDeliveredCount').textContent = deliveredOrders + ' orders (' + deliveredPercentage.toFixed(1) + '%)';
  }

  function initRtoCalc() {
    var inputs = ['rtoMonthlyOrders', 'rtoAov', 'rtoCogs', 'rtoForwardShip', 'rtoPackagingCost', 'rtoCodShare', 'rtoCodRate', 'rtoPrepaidRate'];
    inputs.forEach(function(id) {
      var el = document.getElementById(id);
      if (el) {
        el.addEventListener('input', calculateRto);
        el.addEventListener('change', calculateRto);
      }
    });
    calculateRto();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRtoCalc);
  } else {
    initRtoCalc();
  }
})();
</script>
