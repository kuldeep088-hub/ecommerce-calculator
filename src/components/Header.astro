---
// src/components/Header.astro
interface Props {
  activePlatform?: string;
}

const { activePlatform = 'home' } = Astro.props;
---

<header class="sticky top-0 z-50 w-full bg-white/95 backdrop-blur-md border-b border-neutral-200 transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-15 flex items-center justify-between">
    <!-- Brand / Logo -->
    <a href="/" class="flex items-center gap-2 sm:gap-2.5 min-w-0">
      <img src="/logo.svg" alt="Seller Profit Calculator" class="w-7 h-7 shrink-0 rounded-lg shadow-xs object-contain" width="28" height="28" />
      <div class="min-w-0">
        <span class="font-semibold text-xs sm:text-base tracking-tight text-neutral-900 truncate block">Seller Profit Calculator</span>
      </div>
    </a>

    <!-- Navigation / Marketplace & Tools Links -->
    <nav class="hidden md:flex items-center gap-1 sm:gap-1.5 text-xs sm:text-[13px]">
      <a
        href="/meesho-profit-calculator"
        class={`px-2.5 py-1.5 rounded-lg transition font-medium ${activePlatform === 'meesho' ? 'bg-neutral-100 text-neutral-900 font-semibold' : 'text-neutral-600 hover:text-neutral-900 hover:bg-neutral-50'}`}
      >
        Meesho
      </a>
      <a
        href="/flipkart-profit-calculator"
        class={`px-2.5 py-1.5 rounded-lg transition font-medium ${activePlatform === 'flipkart' ? 'bg-neutral-100 text-neutral-900 font-semibold' : 'text-neutral-600 hover:text-neutral-900 hover:bg-neutral-50'}`}
      >
        Flipkart
      </a>
      <a
        href="/amazon-profit-calculator"
        class={`px-2.5 py-1.5 rounded-lg transition font-medium ${activePlatform === 'amazon' ? 'bg-neutral-100 text-neutral-900 font-semibold' : 'text-neutral-600 hover:text-neutral-900 hover:bg-neutral-50'}`}
      >
        Amazon
      </a>
      <a
        href="/amazon-fba-calculator"
        class={`px-2.5 py-1.5 rounded-lg transition font-medium ${activePlatform === 'fba' ? 'bg-neutral-100 text-neutral-900 font-semibold' : 'text-neutral-600 hover:text-neutral-900 hover:bg-neutral-50'}`}
      >
        Amazon FBA
      </a>

      <!-- Dropdown: Seller Tools -->
      <div class="relative group">
        <button
          type="button"
          class="px-2.5 py-1.5 rounded-lg text-neutral-700 hover:text-neutral-900 hover:bg-neutral-50 font-semibold inline-flex items-center gap-1 cursor-pointer"
        >
          <span class="text-emerald-700">Calculators</span>
          <svg class="w-3.5 h-3.5 text-emerald-600 group-hover:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </button>
        <div class="absolute right-0 mt-1 w-64 bg-white border border-neutral-200 rounded-xl shadow-lg py-2 hidden group-hover:block z-50">
          <div class="px-3.5 py-1 text-[10px] font-semibold uppercase text-neutral-400 font-sans">Core Seller Tools</div>
          <a href="/gst-calculator" class="block px-3.5 py-1.5 text-xs text-neutral-700 hover:bg-neutral-50">
            <span class="font-semibold text-neutral-900 block">GST &amp; ITC Calculator</span>
            <span class="text-[11px] text-neutral-500">Inclusive, Exclusive &amp; ITC Slabs</span>
          </a>
          <a href="/profit-margin-calculator" class="block px-3.5 py-1.5 text-xs text-neutral-700 hover:bg-neutral-50">
            <span class="font-semibold text-neutral-900 block">Profit Margin Calculator</span>
            <span class="text-[11px] text-neutral-500">Net profit margin % &amp; cost markup</span>
          </a>
          <a href="/selling-price-calculator" class="block px-3.5 py-1.5 text-xs text-neutral-700 hover:bg-neutral-50">
            <span class="font-semibold text-neutral-900 block">Target Selling Price</span>
            <span class="text-[11px] text-neutral-500">Required price for target margin</span>
          </a>
          <a href="/net-profit-calculator" class="block px-3.5 py-1.5 text-xs text-neutral-700 hover:bg-neutral-50">
            <span class="font-semibold text-neutral-900 block">Net Profit Calculator</span>
            <span class="text-[11px] text-neutral-500">Take-home earnings after deductions</span>
          </a>
          <a href="/roas-calculator" class="block px-3.5 py-1.5 text-xs text-neutral-700 hover:bg-neutral-50">
            <span class="font-semibold text-neutral-900 block">ROAS Calculator</span>
            <span class="text-[11px] text-neutral-500">Model ad spend revenue return</span>
          </a>
          <a href="/shipping-cost-calculator" class="block px-3.5 py-1.5 text-xs text-neutral-700 hover:bg-neutral-50">
            <span class="font-semibold text-neutral-900 block">Shipping Cost Calculator</span>
            <span class="text-[11px] text-neutral-500">Volumetric vs actual dead weight</span>
          </a>
        </div>
      </div>
    </nav>

    <!-- Mobile Hamburger Button -->
    <div class="md:hidden flex items-center shrink-0 ml-2">
      <button
        type="button"
        id="mobileMenuBtn"
        class="inline-flex items-center justify-center w-10 h-10 rounded-xl border border-neutral-200 bg-white text-neutral-700 hover:bg-neutral-50 active:bg-neutral-100 transition cursor-pointer"
        aria-label="Toggle mobile menu"
        aria-expanded="false"
      >
        <svg id="menuIconOpen" class="w-5 h-5 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg id="menuIconClose" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Collapsible Mobile Navigation Drawer -->
  <div id="mobileMenu" class="hidden md:hidden border-t border-neutral-200 bg-white px-4 py-3.5 space-y-4 max-h-[calc(100vh-4rem)] overflow-y-auto overscroll-contain">
    <div>
      <div class="text-[11px] font-semibold text-neutral-400 uppercase tracking-wider mb-1.5 px-2">Marketplaces</div>
      <div class="space-y-1">
        <a href="/meesho-profit-calculator" class="mobile-nav-link flex items-center justify-between min-h-[40px] py-2 px-2.5 rounded-lg text-xs font-medium text-neutral-800 hover:bg-neutral-50 active:bg-neutral-100">Meesho (0% Commission)</a>
        <a href="/flipkart-profit-calculator" class="mobile-nav-link flex items-center justify-between min-h-[40px] py-2 px-2.5 rounded-lg text-xs font-medium text-neutral-800 hover:bg-neutral-50 active:bg-neutral-100">Flipkart (2026 Slabs)</a>
        <a href="/amazon-profit-calculator" class="mobile-nav-link flex items-center justify-between min-h-[40px] py-2 px-2.5 rounded-lg text-xs font-medium text-neutral-800 hover:bg-neutral-50 active:bg-neutral-100">Amazon India (Easy Ship)</a>
        <a href="/amazon-fba-calculator" class="mobile-nav-link flex items-center justify-between min-h-[40px] py-2 px-2.5 rounded-lg text-xs font-medium text-neutral-800 hover:bg-neutral-50 active:bg-neutral-100">Amazon FBA Calculator</a>
      </div>
    </div>

    <div>
      <div class="text-[11px] font-semibold text-emerald-700 uppercase tracking-wider mb-1.5 px-2">Essential Seller Tools</div>
      <div class="space-y-1">
        <a href="/gst-calculator" class="mobile-nav-link flex items-center justify-between min-h-[40px] py-2 px-2.5 rounded-lg text-xs font-medium text-neutral-800 hover:bg-neutral-50 active:bg-neutral-100">GST &amp; ITC Calculator</a>
        <a href="/profit-margin-calculator" class="mobile-nav-link flex items-center justify-between min-h-[40px] py-2 px-2.5 rounded-lg text-xs font-medium text-neutral-800 hover:bg-neutral-50 active:bg-neutral-100">Profit Margin Calculator</a>
        <a href="/selling-price-calculator" class="mobile-nav-link flex items-center justify-between min-h-[40px] py-2 px-2.5 rounded-lg text-xs font-medium text-neutral-800 hover:bg-neutral-50 active:bg-neutral-100">Target Selling Price</a>
        <a href="/net-profit-calculator" class="mobile-nav-link flex items-center justify-between min-h-[40px] py-2 px-2.5 rounded-lg text-xs font-medium text-neutral-800 hover:bg-neutral-50 active:bg-neutral-100">Net Profit Calculator</a>
        <a href="/roas-calculator" class="mobile-nav-link flex items-center justify-between min-h-[40px] py-2 px-2.5 rounded-lg text-xs font-medium text-neutral-800 hover:bg-neutral-50 active:bg-neutral-100">ROAS Calculator</a>
        <a href="/shipping-cost-calculator" class="mobile-nav-link flex items-center justify-between min-h-[40px] py-2 px-2.5 rounded-lg text-xs font-medium text-neutral-800 hover:bg-neutral-50 active:bg-neutral-100">Shipping Cost Calculator</a>
        <a href="/#comparison" class="mobile-nav-link flex items-center justify-between min-h-[40px] py-2 px-2.5 rounded-lg text-xs font-medium text-neutral-800 hover:bg-neutral-50 active:bg-neutral-100">Compare All Platforms</a>
      </div>
    </div>

    <div class="border-t border-neutral-100 pt-2">
      <div class="text-[11px] font-semibold text-neutral-400 uppercase tracking-wider mb-1.5 px-2">Company &amp; Legal</div>
      <div class="grid grid-cols-2 gap-1 text-xs text-neutral-600">
        <a href="/about-us" class="mobile-nav-link py-1.5 px-2 rounded-lg hover:bg-neutral-50">About Us</a>
        <a href="/contact-us" class="mobile-nav-link py-1.5 px-2 rounded-lg hover:bg-neutral-50">Contact Us</a>
        <a href="/privacy-policy" class="mobile-nav-link py-1.5 px-2 rounded-lg hover:bg-neutral-50">Privacy Policy</a>
        <a href="/terms-and-conditions" class="mobile-nav-link py-1.5 px-2 rounded-lg hover:bg-neutral-50">Terms of Use</a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
(function() {
  function initMobileMenu() {
    var btn = document.getElementById('mobileMenuBtn');
    var menu = document.getElementById('mobileMenu');
    var iconOpen = document.getElementById('menuIconOpen');
    var iconClose = document.getElementById('menuIconClose');

    if (!btn || !menu) return;

    btn.addEventListener('click', function() {
      var isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', !isExpanded);
      menu.classList.toggle('hidden');
      if (iconOpen && iconClose) {
        iconOpen.classList.toggle('hidden');
        iconClose.classList.toggle('hidden');
      }
    });

    document.querySelectorAll('.mobile-nav-link').forEach(function(link) {
      link.addEventListener('click', function() {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
        if (iconOpen && iconClose) {
          iconOpen.classList.remove('hidden');
          iconClose.classList.add('hidden');
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMobileMenu);
  } else {
    initMobileMenu();
  }
})();
</script>
