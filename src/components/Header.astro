---
// src/components/Header.astro
interface Props {
  activePlatform?: string;
}

const { activePlatform = 'home' } = Astro.props;
---

<header class="sticky top-0 z-50 w-full bg-white/95 backdrop-blur-md border-b border-neutral-200 transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-15 flex items-center justify-between">
    <!-- Brand / Logo -->
    <a href="/" class="flex items-center gap-2.5">
      <div class="w-7 h-7 rounded-lg bg-emerald-600 flex items-center justify-center text-white font-bold text-xs shadow-xs">
        ₹
      </div>
      <div>
        <span class="font-semibold text-sm sm:text-base tracking-tight text-neutral-900">Seller Profit Calculator</span>
      </div>
    </a>

    <!-- Navigation / Marketplace & Tools Links -->
    <nav class="hidden md:flex items-center gap-1 sm:gap-1.5 text-xs sm:text-[13px]">
      <a
        href="/meesho"
        class={`px-2.5 py-1.5 rounded-lg transition font-medium ${activePlatform === 'meesho' ? 'bg-neutral-100 text-neutral-900 font-semibold' : 'text-neutral-600 hover:text-neutral-900 hover:bg-neutral-50'}`}
      >
        Meesho
      </a>
      <a
        href="/flipkart"
        class={`px-2.5 py-1.5 rounded-lg transition font-medium ${activePlatform === 'flipkart' ? 'bg-neutral-100 text-neutral-900 font-semibold' : 'text-neutral-600 hover:text-neutral-900 hover:bg-neutral-50'}`}
      >
        Flipkart
      </a>
      <a
        href="/amazon"
        class={`px-2.5 py-1.5 rounded-lg transition font-medium ${activePlatform === 'amazon' ? 'bg-neutral-100 text-neutral-900 font-semibold' : 'text-neutral-600 hover:text-neutral-900 hover:bg-neutral-50'}`}
      >
        Amazon
      </a>
      <a
        href="/myntra"
        class={`px-2.5 py-1.5 rounded-lg transition font-medium ${activePlatform === 'myntra' ? 'bg-neutral-100 text-neutral-900 font-semibold' : 'text-neutral-600 hover:text-neutral-900 hover:bg-neutral-50'}`}
      >
        Myntra
      </a>

      <!-- Dropdown: More Platforms -->
      <div class="relative group">
        <button
          type="button"
          class="px-2.5 py-1.5 rounded-lg text-neutral-600 hover:text-neutral-900 hover:bg-neutral-50 font-medium inline-flex items-center gap-1 cursor-pointer"
        >
          <span>More Marketplaces</span>
          <svg class="w-3.5 h-3.5 text-neutral-400 group-hover:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </button>
        <div class="absolute left-0 mt-1 w-48 bg-white border border-neutral-200 rounded-xl shadow-lg py-1.5 hidden group-hover:block z-50">
          <a href="/shopsy" class="block px-3 py-1.5 text-xs text-neutral-700 hover:bg-neutral-50 font-medium">Shopsy (Flipkart)</a>
          <a href="/snapdeal" class="block px-3 py-1.5 text-xs text-neutral-700 hover:bg-neutral-50 font-medium">Snapdeal</a>
          <div class="border-t border-neutral-100 my-1"></div>
          <div class="px-3 py-1 text-[10px] font-semibold uppercase text-neutral-400 font-sans">Quick Commerce</div>
          <a href="/blinkit" class="block px-3 py-1.5 text-xs text-neutral-700 hover:bg-neutral-50 font-medium">Blinkit (10-min)</a>
          <a href="/zepto" class="block px-3 py-1.5 text-xs text-neutral-700 hover:bg-neutral-50 font-medium">Zepto (Instant)</a>
        </div>
      </div>

      <!-- Dropdown: Seller Tools -->
      <div class="relative group">
        <button
          type="button"
          class="px-2.5 py-1.5 rounded-lg text-neutral-700 hover:text-neutral-900 hover:bg-neutral-50 font-semibold inline-flex items-center gap-1 cursor-pointer"
        >
          <span class="text-emerald-700">Seller Tools</span>
          <svg class="w-3.5 h-3.5 text-emerald-600 group-hover:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </button>
        <div class="absolute right-0 mt-1 w-60 bg-white border border-neutral-200 rounded-xl shadow-lg py-2 hidden group-hover:block z-50">
          <a href="/gst-calculator" class="block px-3.5 py-2 text-xs text-neutral-700 hover:bg-neutral-50">
            <span class="font-semibold text-neutral-900 block">GST Calculator</span>
            <span class="text-[11px] text-neutral-500">Inclusive, Exclusive &amp; ITC Slabs</span>
          </a>
          <a href="/rto-loss-calculator" class="block px-3.5 py-2 text-xs text-neutral-700 hover:bg-neutral-50">
            <span class="font-semibold text-neutral-900 block">RTO Loss Calculator</span>
            <span class="text-[11px] text-neutral-500">Calculate doorstep return cash burn</span>
          </a>
          <a href="/cod-profit-calculator" class="block px-3.5 py-2 text-xs text-neutral-700 hover:bg-neutral-50">
            <span class="font-semibold text-neutral-900 block">COD Profit Calculator</span>
            <span class="text-[11px] text-neutral-500">Cash on delivery fees &amp; margins</span>
          </a>
          <a href="/prepaid-vs-cod" class="block px-3.5 py-2 text-xs text-neutral-700 hover:bg-neutral-50">
            <span class="font-semibold text-neutral-900 block">Prepaid vs COD Simulator</span>
            <span class="text-[11px] text-neutral-500">Compare profit &amp; safe discount</span>
          </a>
        </div>
      </div>

      <span class="w-px h-4 bg-neutral-200 mx-1"></span>
      <a
        href="/#comparison"
        class="px-2.5 py-1.5 rounded-lg transition font-medium text-neutral-600 hover:text-neutral-900 hover:bg-neutral-50"
      >
        Compare All
      </a>
    </nav>

    <!-- Mobile Hamburger Button -->
    <div class="md:hidden flex items-center">
      <button
        type="button"
        id="mobileMenuBtn"
        class="inline-flex items-center justify-center w-8.5 h-8.5 rounded-lg border border-neutral-200 bg-white text-neutral-700 hover:bg-neutral-50 transition cursor-pointer"
        aria-label="Toggle mobile menu"
        aria-expanded="false"
      >
        <svg id="menuIconOpen" class="w-4 h-4 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg id="menuIconClose" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Collapsible Mobile Navigation Drawer -->
  <div id="mobileMenu" class="hidden md:hidden border-t border-neutral-200 bg-white px-4 py-3 space-y-3">
    <div>
      <div class="text-[11px] font-semibold text-neutral-400 uppercase tracking-wider mb-1 px-2">Marketplaces</div>
      <div class="space-y-0.5">
        <a href="/meesho" class="mobile-nav-link flex items-center justify-between py-1.5 px-2 rounded-lg text-xs font-medium text-neutral-800 hover:bg-neutral-50">Meesho (0% Commission)</a>
        <a href="/flipkart" class="mobile-nav-link flex items-center justify-between py-1.5 px-2 rounded-lg text-xs font-medium text-neutral-800 hover:bg-neutral-50">Flipkart (2026 Slabs)</a>
        <a href="/amazon" class="mobile-nav-link flex items-center justify-between py-1.5 px-2 rounded-lg text-xs font-medium text-neutral-800 hover:bg-neutral-50">Amazon India (Easy Ship)</a>
        <a href="/myntra" class="mobile-nav-link flex items-center justify-between py-1.5 px-2 rounded-lg text-xs font-medium text-neutral-800 hover:bg-neutral-50">Myntra (Fashion)</a>
        <a href="/shopsy" class="mobile-nav-link flex items-center justify-between py-1.5 px-2 rounded-lg text-xs font-medium text-neutral-800 hover:bg-neutral-50">Shopsy (Flipkart Value)</a>
        <a href="/snapdeal" class="mobile-nav-link flex items-center justify-between py-1.5 px-2 rounded-lg text-xs font-medium text-neutral-800 hover:bg-neutral-50">Snapdeal (Flat ₹10)</a>
      </div>
    </div>

    <div>
      <div class="text-[11px] font-semibold text-neutral-400 uppercase tracking-wider mb-1 px-2">Quick Commerce</div>
      <div class="space-y-0.5">
        <a href="/blinkit" class="mobile-nav-link flex items-center justify-between py-1.5 px-2 rounded-lg text-xs font-medium text-neutral-800 hover:bg-neutral-50">Blinkit Dark Store Calculator</a>
        <a href="/zepto" class="mobile-nav-link flex items-center justify-between py-1.5 px-2 rounded-lg text-xs font-medium text-neutral-800 hover:bg-neutral-50">Zepto Instant Delivery Calculator</a>
      </div>
    </div>

    <div>
      <div class="text-[11px] font-semibold text-emerald-700 uppercase tracking-wider mb-1 px-2">Essential Seller Tools</div>
      <div class="space-y-0.5">
        <a href="/gst-calculator" class="mobile-nav-link flex items-center justify-between py-1.5 px-2 rounded-lg text-xs font-medium text-neutral-800 hover:bg-neutral-50">GST &amp; ITC Calculator</a>
        <a href="/rto-loss-calculator" class="mobile-nav-link flex items-center justify-between py-1.5 px-2 rounded-lg text-xs font-medium text-neutral-800 hover:bg-neutral-50">RTO Loss Calculator</a>
        <a href="/cod-profit-calculator" class="mobile-nav-link flex items-center justify-between py-1.5 px-2 rounded-lg text-xs font-medium text-neutral-800 hover:bg-neutral-50">COD Profit Calculator</a>
        <a href="/prepaid-vs-cod" class="mobile-nav-link flex items-center justify-between py-1.5 px-2 rounded-lg text-xs font-medium text-neutral-800 hover:bg-neutral-50">Prepaid vs COD Simulator</a>
        <a href="/#comparison" class="mobile-nav-link flex items-center justify-between py-1.5 px-2 rounded-lg text-xs font-medium text-neutral-800 hover:bg-neutral-50">Compare All Platforms</a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
(function() {
  function initMobileMenu() {
    var btn = document.getElementById('mobileMenuBtn');
    var menu = document.getElementById('mobileMenu');
    var iconOpen = document.getElementById('menuIconOpen');
    var iconClose = document.getElementById('menuIconClose');

    if (!btn || !menu) return;

    btn.addEventListener('click', function() {
      var isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', !isExpanded);
      menu.classList.toggle('hidden');
      if (iconOpen && iconClose) {
        iconOpen.classList.toggle('hidden');
        iconClose.classList.toggle('hidden');
      }
    });

    document.querySelectorAll('.mobile-nav-link').forEach(function(link) {
      link.addEventListener('click', function() {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
        if (iconOpen && iconClose) {
          iconOpen.classList.remove('hidden');
          iconClose.classList.add('hidden');
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMobileMenu);
  } else {
    initMobileMenu();
  }
})();
</script>
