---
// src/components/Header.astro
---

<header class="sticky top-0 z-50 w-full bg-white/90 backdrop-blur-md border-b border-[#ebebeb] transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand / Logo -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-8 h-8 rounded-lg bg-[#171717] flex items-center justify-center text-white font-bold text-sm shadow-sm group-hover:scale-105 transition-transform">
        ₹
      </div>
      <div>
        <span class="font-semibold text-base tracking-tight text-[#171717]">Seller Profit Calculator</span>
        <span class="hidden sm:inline-block ml-2 text-[11px] font-mono uppercase tracking-wider px-2 py-0.5 rounded-full bg-neutral-100 text-neutral-600 border border-neutral-200">
          India 2026 Slabs
        </span>
      </div>
    </a>

    <!-- Navigation / Quick Anchor Links -->
    <nav class="hidden md:flex items-center gap-6 text-sm text-[#4d4d4d]">
      <a href="#calculator" class="hover:text-[#171717] transition-colors font-medium">Calculator</a>
      <a href="#comparison" class="hover:text-[#171717] transition-colors font-medium">Side-by-Side Compare</a>
      <a href="#reverse-solver" class="hover:text-[#171717] transition-colors font-medium">Target Price Solver</a>
      <a href="#fee-guide" class="hover:text-[#171717] transition-colors font-medium">Fee Rates Guide</a>
      <a href="#faq" class="hover:text-[#171717] transition-colors font-medium">FAQ</a>
    </nav>

    <!-- Right Side CTA / Domain Badge -->
    <div class="flex items-center gap-3">
      <span class="hidden lg:inline-flex items-center gap-1.5 text-xs text-neutral-500 font-mono">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        freesellerprofitcalculator.com
      </span>
      <a
        href="#calculator"
        class="inline-flex items-center justify-center h-9 px-4 rounded-full bg-[#171717] hover:bg-[#262626] text-white text-xs font-medium transition-colors shadow-sm"
      >
        Calculate Now
      </a>
    </div>
  </div>
</header>
